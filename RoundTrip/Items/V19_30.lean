theorem A_holds : A :=
  ⟨@Polyfold.GroupoidalCategory.BasicConstruction.corollary_19_4_8.{0},
    @Polyfold.GroupoidalCategory.BasicConstruction.metrizableSpace_natTop_of_surjective.{0}⟩

/-- Under `HasClassUniformizers`, `B`'s `natT` (generated by `NatOpen`) is the project's `natTop`. -/
theorem natT_eq {C : GroupoidalCategory.{0}} (B : C.BasicConstruction)
    (hB : B.U.HasClassUniformizers) : natT B.U = B.natTop hB :=
  TopologicalSpace.generateFrom_setOfPred_isOpen (B.natTop hB)

theorem main_A_to_B
    (hA : type_of% @Polyfold.GroupoidalCategory.BasicConstruction.corollary_19_4_8.{0}) : B := by
  intro C B F hB hF hm Ψ Ψ'
  rw [natT_eq B hB] at hm
  have := hA B hB hm Ψ Ψ'
  exact (B.trHomeomorph hF Ψ Ψ').isEmbedding.metrizableSpace

theorem A_to_B : A → B := fun hA => main_A_to_B hA.1

theorem main_B_to_A (hB' : B) :
    type_of% @Polyfold.GroupoidalCategory.BasicConstruction.corollary_19_4_8.{0} := by
  intro C B hB hm Ψ Ψ'
  have hm' : @TopologicalSpace.MetrizableSpace C.OrbitSpace (natT B.U) := by
    rw [natT_eq B hB]; exact hm
  exact hB' C B B.rep hB B.mk_rep hm' Ψ Ψ'

/-- The second conjunct, re-proved outright (the project's proof, from non-item lemmas). -/
theorem surj' {C : GroupoidalCategory.{0}} (B : C.BasicConstruction)
    (hB : B.U.HasClassUniformizers) {α : C.Obj} {Ψ : C.Uniformizer} (hΨ : Ψ ∈ B.U.F α)
    (hsurj : ∀ z : C.OrbitSpace, ∃ q : Ψ.O, C.π (Ψ.obj q) = z) :
    @TopologicalSpace.MetrizableSpace _ (B.natTop hB) := by
  let _inst := B.natTop hB
  have he := (B.theorem_19_2_2_three hB hΨ).1
  have hs : Function.Surjective Ψ.functor.orbitMap := fun z => by
    obtain ⟨q, rfl⟩ := hsurj z
    exact ⟨(GroupoidStr.translation Ψ.G Ψ.O).π q, rfl⟩
  have := metrizableSpace_translation_orbitSpace Ψ.smooth_smul
  let e := (Equiv.ofBijective _ ⟨he.injective, hs⟩).toHomeomorphOfContinuousOpen
    he.continuous he.isOpenMap
  exact e.symm.isEmbedding.metrizableSpace

theorem B_to_A : B → A := fun hB' => ⟨main_B_to_A hB', @surj'⟩

