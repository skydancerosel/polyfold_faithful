import Polyfold
import RoundTrip.Check
import RoundTrip.Blind.V9_51

/-!
Round trip for V9_51 (Definition 9.5.3, 2021 p. 438, and the remark after it; 2017:
Definition 9.16, p. 323): the σ-algebra `L(S)`.

`A` (universes at `0`) is the conjunction of the types of `borel_le_borelNullSigma`,
`measurableSet_borelNullSigma_of_mem`, `measurableSet_borelNullSigma_iff` (for a σ-ideal `𝒩`, the
σ-algebra generated by the Borel sets and `𝒩` is `{A | ∃ Borel B, A ∆ B ∈ 𝒩}`),
`isSigmaIdeal_measureZeroSets`, `remark_9_5_3` and
`measurableSet_lebesgueSigma_of_isMeasureZeroSupp`; the last three are for the project's
`lebesgueSigma`, built on an **abstract** `SheetNullSets`.  `B`'s `L(S)` (`LSB`) is
`generateFrom (Borel ∪ null)` for the **concrete** null sets `IsNullSB` (locally
`n`-dimensional Hausdorff-null preimages, as in V9_50), i.e. `borelNullSigma` of them by `rfl`.

* `A ⇒ B` is not proved.  `B`'s "⇐" holds for any family, but "⇒" (every `L ∈ L(S)` is a Borel
  set modified by a null set) needs the null sets of `S` to form a σ-ideal, and for `IsNullSB`
  this needs the locally null subsets of a sheet to be closed under countable unions, which in a
  non-separable `E₀` requires local second countability of the sheets (a Part I fact about
  finite-dimensional submanifolds that the project does not have).  With that one hypothesis,
  `A ⇒ B` holds (`A_to_B_of_hyp`), through A's `measurableSet_borelNullSigma_iff`; the σ-ideal
  property (`isSigmaIdeal_of`) uses the choice-independence of V9_50 for B's notion, proved here
  outright by the covering argument (`nullPreimages_of`).
* `B ⇒ A` (`B_to_A`) is **vacuous**: `A` is about an arbitrary σ-ideal and an abstract
  `SheetNullSets`, which `B` does not mention; `A` is re-proved outright (section `ReProof`,
  copies of the project's proofs; `isSigmaIdeal_isMeasureZeroSupp` is V9_50's item, not banned
  here).
-/

namespace RoundTrip.V9_51
open Polyfold Set MeasureTheory
open scoped symmDiff

/-- The project's statements, universes at `0`. -/
def A : Prop :=
  type_of% @Polyfold.borel_le_borelNullSigma.{0} ∧
  type_of% @Polyfold.measurableSet_borelNullSigma_of_mem.{0} ∧
  type_of% @Polyfold.measurableSet_borelNullSigma_iff.{0} ∧
  type_of% @Polyfold.EpGroupoid.isSigmaIdeal_measureZeroSets.{0} ∧
  type_of% @Polyfold.EpGroupoid.remark_9_5_3.{0} ∧
  type_of% @Polyfold.EpGroupoid.measurableSet_lebesgueSigma_of_isMeasureZeroSupp.{0}

theorem A_holds : A :=
  ⟨@borel_le_borelNullSigma, @measurableSet_borelNullSigma_of_mem,
    @measurableSet_borelNullSigma_iff, @EpGroupoid.isSigmaIdeal_measureZeroSets,
    @EpGroupoid.remark_9_5_3, @EpGroupoid.measurableSet_lebesgueSigma_of_isMeasureZeroSupp⟩

section
variable {Obj Mor : Type} [TopologicalSpace Obj] [T2Space Obj] [ParacompactSpace Obj]
  [TopologicalSpace Mor] [T2Space Mor] [ParacompactSpace Mor]

theorem isLocNullB_mono {Z : Type} [TopologicalSpace Z] [T2Space Z] [ParacompactSpace Z]
    {P : MPolyfold Z} {d : ℕ} {C C' : Set Z} (h : IsLocNullB P d C') (hC : C ⊆ C') :
    IsLocNullB P d C := by
  intro z hz
  obtain ⟨V, hV, hzV, hnull⟩ := h z (hC hz)
  exact ⟨V, hV, hzV, fun φ hφ => measure_mono_null
    (image_mono (inter_subset_inter_left _ (inter_subset_inter_left _ hC))) (hnull φ hφ)⟩

/-- **The choice-independence of V9_50 for B's notion** (the covering argument, outright): if
`K` has measure zero (one suitable structure per point), then its preimages are null in the
sheets of **every** local branching structure. -/
theorem nullPreimages_of (X : EpGroupoid Obj Mor) {Θ : Obj → ℚ} {n : ℕ} {K : Set X.OrbitSpace}
    (hK : IsNullSB X Θ n K) {x' : Obj} (B' : X.LocalBranchingStructure Θ x') (j : B'.ι) :
    IsLocNullB X.PObj n (B'.M j ∩ X.π ⁻¹' K) := by
  intro z hz
  have hzs : z ∈ EpGroupoid.supp Θ := (B'.mem_supp_iff (B'.subset_U j hz.1)).2 ⟨j, hz.1⟩
  obtain ⟨Bz, -, hBnull⟩ := hK z hzs
  have hV : ∀ i, ∃ V : Set Obj, IsOpen V ∧ z ∈ V ∧ ∀ φ : MChart Obj, X.PObj.IsChart φ →
      OuterMeasure.mkMetric (fun r : ENNReal => r ^ (n : ℝ))
        (φ.toPartialEquiv '' (Bz.M i ∩ X.π ⁻¹' K ∩ V ∩ φ.toPartialEquiv.source)) = 0 := by
    intro i
    by_cases hzi : z ∈ Bz.M i
    · exact hBnull i z ⟨hzi, hz.2⟩
    · refine ⟨Bz.U \ Bz.M i, Bz.isOpen_U_diff_M i, ⟨Bz.mem_U, hzi⟩, fun φ _ => ?_⟩
      have h0 : Bz.M i ∩ X.π ⁻¹' K ∩ (Bz.U \ Bz.M i) ∩ φ.toPartialEquiv.source = ∅ := by
        ext w
        simp only [mem_inter_iff, mem_sdiff, mem_empty_iff_false, iff_false]
        tauto
      rw [h0, image_empty, measure_empty]
  choose V hVo hzV hVnull using hV
  refine ⟨Bz.U ∩ ⋂ i, V i, Bz.isOpen_U.inter (isOpen_iInter_of_finite hVo),
    ⟨Bz.mem_U, mem_iInter.2 hzV⟩, fun φ hφ => ?_⟩
  refine measure_mono_null ?_ (measure_iUnion_null fun i => hVnull i φ hφ)
  rintro _ ⟨w, ⟨⟨⟨hwM, hwK⟩, hwU, hwV⟩, hws⟩, rfl⟩
  have hwS : w ∈ EpGroupoid.supp Θ := (B'.mem_supp_iff (B'.subset_U j hwM)).2 ⟨j, hwM⟩
  obtain ⟨i, hi⟩ := (Bz.mem_supp_iff hwU).1 hwS
  exact mem_iUnion.2 ⟨i, w, ⟨⟨⟨hi, hwK⟩, mem_iInter.1 hwV i⟩, hws⟩, rfl⟩

/-- The σ-additivity of B's null sets in the sheets of suitable structures (the missing
hypothesis). -/
def SheetsSigmaAdditive (X : EpGroupoid Obj Mor) (Θ : Obj → ℚ) (n : ℕ) : Prop :=
  ∀ x ∈ EpGroupoid.supp Θ, ∀ B : X.LocalBranchingStructure Θ x, IsSuitableB X B → ∀ i,
    ∀ C : ℕ → Set Obj, (∀ k, C k ⊆ B.M i) → (∀ k, IsLocNullB X.PObj n (C k)) →
      IsLocNullB X.PObj n (⋃ k, C k)

/-- Under σ-additivity in the sheets, B's null subsets of `S` form a σ-ideal. -/
theorem isSigmaIdeal_of (X : EpGroupoid Obj Mor) {Θ : Obj → ℚ} {n : ℕ} (hT : IsTameB X Θ)
    (hσ : SheetsSigmaAdditive X Θ n) :
    IsSigmaIdeal {N : Set (X.orbitSupp Θ) | IsNullSB X Θ n (Subtype.val '' N)} where
  empty_mem x hx := by
    obtain ⟨Bx, hBx⟩ := hT x hx
    refine ⟨Bx, hBx, fun i z hz => ?_⟩
    rw [image_empty, preimage_empty, inter_empty] at hz
    exact (notMem_empty z hz).elim
  mono {N N'} hN hNN' x hx := by
    obtain ⟨Bx, hBx, hn⟩ := hN x hx
    exact ⟨Bx, hBx, fun i => isLocNullB_mono (hn i)
      (inter_subset_inter_right _ (preimage_mono (image_mono hNN')))⟩
  iUnion_mem N hN x hx := by
    obtain ⟨Bx, hBx⟩ := hT x hx
    refine ⟨Bx, hBx, fun i => ?_⟩
    rw [image_iUnion, preimage_iUnion, inter_iUnion]
    exact hσ x hx Bx hBx i _ (fun k => inter_subset_left)
      (fun k => nullPreimages_of X (hN k) Bx i)

end

/-- **`A ⇒ B` through A's `measurableSet_borelNullSigma_iff`**, given σ-additivity of B's null
sets in the sheets of suitable structures. -/
theorem A_to_B_of_hyp (hA : A)
    (hσ : ∀ (Obj Mor : Type) [TopologicalSpace Obj] [T2Space Obj] [ParacompactSpace Obj]
      [TopologicalSpace Mor] [T2Space Mor] [ParacompactSpace Mor]
      (X : EpGroupoid Obj Mor) (Θ : Obj → ℚ) (n : ℕ),
      X.IsBranchedEpSubgroupoid Θ → IsTameB X Θ → X.IsNDimensional Θ n →
      SheetsSigmaAdditive X Θ n) : B := by
  intro Obj Mor _ _ _ _ _ _ X Θ n hΘ hT hD L
  have hI := isSigmaIdeal_of X hT (hσ Obj Mor X Θ n hΘ hT hD)
  have key := hA.2.2.1 hI (A := L)
  change MeasurableSet[borelNullSigma _
    {N : Set (X.orbitSupp Θ) | IsNullSB X Θ n (Subtype.val '' N)}] L ↔ _
  rw [key]
  constructor
  · rintro ⟨Bo, hBo, hN⟩
    refine ⟨Bo, L ∆ Bo, hBo, hN, ?_⟩
    rw [symmDiff_comm L Bo, symmDiff_symmDiff_cancel_left]
  · rintro ⟨Ao, N, hAo, hN, rfl⟩
    refine ⟨Ao, hAo, ?_⟩
    change IsNullSB X Θ n (Subtype.val '' ((Ao ∆ N) ∆ Ao))
    rwa [symmDiff_comm Ao N, symmDiff_symmDiff_cancel_right]

/-! ### `B ⇒ A`, vacuous: `A` re-proved outright -/

namespace ReProof
open EpGroupoid

section
variable {T : Type} [TopologicalSpace T]

theorem le' (𝒩 : Set (Set T)) : borel T ≤ borelNullSigma T 𝒩 :=
  fun _ hA => MeasurableSpace.measurableSet_generateFrom (Or.inl hA)

theorem of_mem' {𝒩 : Set (Set T)} {A : Set T} (hA : A ∈ 𝒩) :
    MeasurableSet[borelNullSigma T 𝒩] A :=
  MeasurableSpace.measurableSet_generateFrom (Or.inr hA)

theorem iff' {𝒩 : Set (Set T)} (h𝒩 : IsSigmaIdeal 𝒩) {A : Set T} :
    MeasurableSet[borelNullSigma T 𝒩] A ↔ ∃ B, MeasurableSet[borel T] B ∧ A ∆ B ∈ 𝒩 := by
  constructor
  · intro hA
    have hle : borelNullSigma T 𝒩 ≤ borelNullCompletion h𝒩 := by
      refine MeasurableSpace.generateFrom_le ?_
      rintro C (hC | hC)
      · exact ⟨C, hC, by rw [symmDiff_self]; exact h𝒩.empty_mem⟩
      · refine ⟨∅, @MeasurableSet.empty T (borel T), ?_⟩
        have h0 : C ∆ (∅ : Set T) = C := symmDiff_bot C
        rwa [h0]
    exact hle _ hA
  · rintro ⟨B, hB, hAB⟩
    have h1 : A \ B ∈ 𝒩 := h𝒩.mono hAB fun z hz => mem_symmDiff.2 (Or.inl hz)
    have h2 : B \ A ∈ 𝒩 := h𝒩.mono hAB fun z hz => mem_symmDiff.2 (Or.inr hz)
    have hA : A = (B \ (B \ A)) ∪ (A \ B) := by
      ext z
      by_cases hzA : z ∈ A <;> by_cases hzB : z ∈ B <;> simp [hzA, hzB]
    rw [hA]
    exact ((le' 𝒩 _ hB).diff (of_mem' h2)).union (of_mem' h1)

end

section
variable {Obj Mor : Type} [TopologicalSpace Obj] [T2Space Obj] [ParacompactSpace Obj]
  [TopologicalSpace Mor] [T2Space Mor] [ParacompactSpace Mor] {X : EpGroupoid Obj Mor}
  {S : Set (Set Obj)} (G : SheetNullSets S) {Θ : Obj → ℚ}

theorem sigma' (hS : X.HasTameSheetsIn S Θ) : IsSigmaIdeal (X.measureZeroSets G Θ) := by
  have h := isSigmaIdeal_isMeasureZeroSupp G hS
  refine ⟨?_, fun hB hAB => h.mono hB (image_mono hAB), fun A hA => ?_⟩
  · change X.IsMeasureZeroSupp G Θ _
    rw [image_empty]
    exact h.empty_mem
  · change X.IsMeasureZeroSupp G Θ _
    rw [image_iUnion]
    exact h.iUnion_mem _ hA

theorem remark' (hS : X.HasTameSheetsIn S Θ) (K : Set (X.orbitSupp Θ)) :
    MeasurableSet[X.lebesgueSigma G Θ] K ↔
      ∃ B, MeasurableSet[borel _] B ∧ X.IsMeasureZeroSupp G Θ (Subtype.val '' (K ∆ B)) :=
  iff' (sigma' G hS)

theorem lebesgue_of' {K : Set (X.orbitSupp Θ)}
    (hK : X.IsMeasureZeroSupp G Θ (Subtype.val '' K)) : MeasurableSet[X.lebesgueSigma G Θ] K :=
  of_mem' hK

end

end ReProof

/-- `B ⇒ A`, vacuous: `A` re-proved outright. -/
theorem B_to_A : B → A := fun _ =>
  ⟨@ReProof.le', @ReProof.of_mem', @ReProof.iff', @ReProof.sigma', @ReProof.remark',
    @ReProof.lebesgue_of'⟩

