/-- The conclusion of `B` for one basic construction. -/
def BC (A B : GroupoidalCategory.{0}) (S : A.BundleCoveringSquare B)
    (Bs : SquareBasicConstruction S) : Prop :=
    haveI : Fact (IsFiniteToOneCovering S.P) := ⟨S.isFiniteToOneCovering⟩
    -- (a) the orbit spaces are metrizable
    (@TopologicalSpace.MetrizableSpace A.OrbitSpace
      (TopologicalSpace.generateFrom {W | (Bs.Ft.toPullback.toCBC Bs.T.𝓕).NatOpenA W}) ∧
     @TopologicalSpace.MetrizableSpace S.μA.cat.OrbitSpace
      (TopologicalSpace.generateFrom {U | Bs.Ft.NatOpenEA U}) ∧
     (∀ hB : (Bs.Ft.toPullback.toCBC Bs.T.𝓕).toBasic.U.HasClassUniformizers,
      @TopologicalSpace.MetrizableSpace B.OrbitSpace
        ((Bs.Ft.toPullback.toCBC Bs.T.𝓕).toBasic.natTop hB)) ∧
     @TopologicalSpace.MetrizableSpace S.μB.cat.OrbitSpace
      (TopologicalSpace.generateFrom {U | Bs.Ft.toPullback.NatOpenEB U})) ∧
    ∃ Kb : ∀ X Y : Bs.Ft.Unif,
        StrongBundle (Bs.Ft.toPullback.basePoly Bs.T.𝓕 X.toPU Y.toPU)
          (Bs.Ft.toPullback.mGmap Bs.T.𝓕 X.toPU Y.toPU),
      -- `Kb` is the natural strong bundle structure of `m : M(Γ, Γ') → M(Ψ, Ψ')`
      (∀ X Y : Bs.Ft.Unif,
        IsSBIso (Bs.Ft.toPullback.srcBundle Bs.T.𝓕 X.toPU Y.toPU) (Kb X Y) id
          (Bs.Ft.toPullback.altH Bs.T.𝓕 X.toPU Y.toPU)) ∧
      -- (b) `M(Γ̂, Γ̂') → M(Ψ̂, Ψ̂')` over `M(Γ, Γ') → M(Ψ, Ψ')` is a proper covering square
      (∀ X Y : Bs.Ft.Unif,
        IsProperStrongBundleCoveringSquare (Bs.Ft.bundleSq Bs.T.𝓕 X Y) (Kb X Y)
          (Bs.Ft.toPullback.pBmap Bs.T.𝓕 X.toPU Y.toPU) (Bs.Ft.pbarSq Bs.T.𝓕 X Y)) ∧
      -- (c) `s` and `t` are local isomorphisms (both levels)
      (∀ X Y : Bs.Ft.Unif,
        IsLocalSBIso (Bs.Ft.bundleSq Bs.T.𝓕 X Y) X.x.K.BWh
          (Bs.Ft.srcH Bs.T.𝓕 X Y) (Bs.Ft.srcSq Bs.T.𝓕 X Y) ∧
        IsLocalSBIso (Bs.Ft.bundleSq Bs.T.𝓕 X Y) Y.x.K.BWh
          (Bs.Ft.tgtH Bs.T.𝓕 X Y) (Bs.Ft.tgtSq Bs.T.𝓕 X Y) ∧
        IsLocalSBIso (Kb X Y) X.toPU.x.bun.bundle
          (fun k => k.src) (Bs.Ft.toPullback.srcGmap Bs.T.𝓕 X.toPU Y.toPU) ∧
        IsLocalSBIso (Kb X Y) Y.toPU.x.bun.bundle
          (fun k => k.tgt) (Bs.Ft.toPullback.tgtGmap Bs.T.𝓕 X.toPU Y.toPU)) ∧
      -- (c) `ι` is an isomorphism (both levels)
      (∀ X Y : Bs.Ft.Unif,
        IsSBIso (Bs.Ft.bundleSq Bs.T.𝓕 X Y) (Bs.Ft.bundleSq Bs.T.𝓕 Y X)
          (Bs.Ft.invH Bs.T.𝓕 X Y) (Bs.Ft.invSq Bs.T.𝓕 X Y) ∧
        IsSBIso (Kb X Y) (Kb Y X)
          (Bs.Ft.toPullback.invB Bs.T.𝓕 X.toPU Y.toPU)
          (Bs.Ft.toPullback.invG Bs.T.𝓕 X.toPU Y.toPU)) ∧
      -- (c) the unit is a strong bundle map (both levels)
      (∀ X : Bs.Ft.Unif,
        X.x.K.BWh.IsStrongBundleMap (Bs.Ft.bundleSq Bs.T.𝓕 X X)
          (Bs.Ft.unitH Bs.T.𝓕 X) (Bs.Ft.unitSq Bs.T.𝓕 X) ∧
        X.toPU.x.bun.bundle.IsStrongBundleMap (Kb X X)
          (Bs.Ft.toPullback.unitB Bs.T.𝓕 X.toPU) (Bs.Ft.toPullback.unitG Bs.T.𝓕 X.toPU)) ∧
      -- (d) the multiplication is a strong bundle map (both levels)
      (∀ X Y Z : Bs.Ft.Unif,
        (∀ (hC : (Bs.Ft.toPullback.toCBC Bs.T.𝓕).IsCompatible)
          (hpr : (Bs.Ft.HFPpoly Bs.T.𝓕 X Y Z hC).IsScSmoothMap
            (Bs.Ft.toPullback.hatPoly Bs.T.𝓕 X.toPU Y.toPU) (Bs.Ft.pr₂H Bs.T.𝓕 X Y Z)),
          ((Bs.Ft.bundleSq Bs.T.𝓕 X Y).pullback hpr).IsStrongBundleMap
            (Bs.Ft.bundleSq Bs.T.𝓕 X Z) (Bs.Ft.mulH Bs.T.𝓕 X Y Z) (Bs.Ft.mulSq Bs.T.𝓕 X Y Z)) ∧
        (∀ hpr : (Bs.Ft.toPullback.BFPpoly Bs.T.𝓕 X.toPU Y.toPU Z.toPU).IsScSmoothMap
            (Bs.Ft.toPullback.basePoly Bs.T.𝓕 X.toPU Y.toPU)
            (Bs.Ft.toPullback.pr₂B Bs.T.𝓕 X.toPU Y.toPU Z.toPU),
          ((Kb X Y).pullback hpr).IsStrongBundleMap (Kb X Z)
            (Bs.Ft.toPullback.mulB Bs.T.𝓕 X.toPU Y.toPU Z.toPU)
            (Bs.Ft.toPullback.mulG Bs.T.𝓕 X.toPU Y.toPU Z.toPU)))

theorem B_iff : B ↔ ∀ (A B : GroupoidalCategory.{0}) (S : A.BundleCoveringSquare B)
    (Bs : SquareBasicConstruction S), BC A B S Bs := Iff.rfl

/-- From the conjunct `SquareBasicConstruction.theorem_19_8_22_hyp` of `A` (with the non-item
lemma `isStrongBundleIso_altH` for `Kb = bundleG`): the conclusion of `B` under the project's
added hypothesis `IsCompatible`. -/
theorem A_to_B_of_compatible
    (h : type_of% @Polyfold.GroupoidalCategory.SquareBasicConstruction.theorem_19_8_22_hyp.{0}) :
    ∀ (A B : GroupoidalCategory.{0}) (S : A.BundleCoveringSquare B)
      (Bs : SquareBasicConstruction S), (Bs.Ft.toPullback.toCBC Bs.T.𝓕).IsCompatible →
      BC A B S Bs := by
  intro A B S Bs hC
  have : Fact (IsFiniteToOneCovering S.P) := ⟨S.isFiniteToOneCovering⟩
  obtain ⟨⟨hmA, hmEB, hmEA, hsq⟩, hinv, hunit, hmul⟩ := h Bs hC
  have loc : ∀ {X Y X' Y' : Type}
      [TopologicalSpace X] [T2Space X] [ParacompactSpace X] {PX : MPolyfold X}
      [TopologicalSpace Y] [T2Space Y] [ParacompactSpace Y] {P : Y → X}
      [∀ x : X, AddCommGroup (P ⁻¹' {x})] [∀ x : X, Module ℝ (P ⁻¹' {x})]
      [TopologicalSpace X'] [T2Space X'] [ParacompactSpace X'] {PX' : MPolyfold X'}
      [TopologicalSpace Y'] [T2Space Y'] [ParacompactSpace Y'] {P' : Y' → X'}
      [∀ x : X', AddCommGroup (P' ⁻¹' {x})] [∀ x : X', Module ℝ (P' ⁻¹' {x})]
      (B₁ : StrongBundle PX P) (B₂ : StrongBundle PX' P') (f : X → X') (Φ : Y → Y')
      (hΦ : B₁.IsStrongBundleMap B₂ f Φ),
      (∀ a, ∃ (U : Set X) (U' : Set X'), a ∈ U ∧ B₁.IsStrongBundleIsoOn B₂ hΦ U U') →
      IsLocalSBIso B₁ B₂ f Φ := by
    intro X Y X' Y' _ _ _ PX _ _ _ P _ _ _ _ _ PX' _ _ _ P' _ _ B₁ B₂ f Φ hΦ hl
    refine ⟨hΦ, fun a => ?_⟩
    obtain ⟨U, U', ha, hi⟩ := hl a
    obtain ⟨g, hg⟩ := hi.isScDiffeoOn_base
    exact ⟨U, U', hg.isOpen_source, ha, hg.isScSmoothOn_inv.isOpen, hi⟩
  refine ⟨⟨?_, ?_, fun _ => Bs.T.metrizable, ?_⟩, fun X Y => Bs.Ft.toPullback.bundleG Bs.T.𝓕 X.toPU Y.toPU,
    fun X Y => ?_, fun X Y => (hsq X Y).1, fun X Y => ⟨loc _ _ _ _ _ (hsq X Y).2.1,
      loc _ _ _ _ _ (hsq X Y).2.2.1, loc _ _ _ _ _ (hsq X Y).2.2.2.1,
      loc _ _ _ _ _ (hsq X Y).2.2.2.2⟩,
    fun X Y => ⟨⟨(hinv X Y).1.toMap, (hinv X Y).1.isStrongBundleIsoOn_univ⟩,
      ⟨(hinv X Y).2.1.toMap, (hinv X Y).2.1.isStrongBundleIsoOn_univ⟩⟩,
    fun X => ⟨(hunit X).1, (hunit X).2.1⟩,
    fun X Y Z => ⟨fun _ _ => (hmul X Y Z).1, fun _ => (hmul X Y Z).2.1⟩⟩
  · have ht : TopologicalSpace.generateFrom {W | (Bs.Ft.toPullback.toCBC Bs.T.𝓕).NatOpenA W} =
        (Bs.Ft.toPullback.toCBC Bs.T.𝓕).natTopA S.isFiniteToOneCovering hC
          Bs.T.hasClassUniformizers := TopologicalSpace.generateFrom_setOfPred_isOpen
      ((Bs.Ft.toPullback.toCBC Bs.T.𝓕).natTopA S.isFiniteToOneCovering hC
        Bs.T.hasClassUniformizers)
    rw [ht]
    exact hmA
  · have ht : TopologicalSpace.generateFrom {U | Bs.Ft.NatOpenEA U} =
        Bs.Ft.natTopEA Bs.T.𝓕 Bs.T.isCoherent hC Bs.T.hasClassUniformizers :=
      TopologicalSpace.generateFrom_setOfPred_isOpen
      (Bs.Ft.natTopEA Bs.T.𝓕 Bs.T.isCoherent hC Bs.T.hasClassUniformizers)
    rw [ht]
    exact hmEA
  · have ht : TopologicalSpace.generateFrom {U | Bs.Ft.toPullback.NatOpenEB U} =
        Bs.Ft.toPullback.natTopEB Bs.T.𝓕 Bs.T.isCoherent Bs.T.hasClassUniformizers :=
      TopologicalSpace.generateFrom_setOfPred_isOpen
      (Bs.Ft.toPullback.natTopEB Bs.T.𝓕 Bs.T.isCoherent Bs.T.hasClassUniformizers)
    rw [ht]
    exact hmEB
  · have hH := Bs.Ft.toPullback.isStrongBundleIso_altH Bs.T.𝓕 X.toPU Y.toPU
    exact ⟨hH.toMap, hH.isStrongBundleIsoOn_univ⟩

