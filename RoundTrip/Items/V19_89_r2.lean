set_option maxSynthPendingDepth 3

/-! Round trip for V19_89_r2 (refresh of V19_89: 2021 Theorem 19.7.29, p. 929; 2017 Theorem
19.10).  `B` is the existing blind statement `RoundTrip.V19_89.B`.

* `A`: the types of `theorem_19_7_29_hyp` and of the new `theorem_19_7_29_content`,
  `theorem_19_7_29_functor` (`Chapter19/CoveringContent`), universe `0`.
* Main conjunct `theorem_19_7_29_content`: under `IsCompatible`, the topology generated by
  `NatOpenA` is metrizable and there is a proper polyfold covering functor
  `(A, T_{|A|}) → (B, T_{|B|})` whose functor is `P` and whose polyfold structure of `B` is the one
  of `(F, 𝓕)`; this is `B`'s conclusion, with `IsCompatible` added.
* `B_to_main` (proved): `B` does not use `IsCompatible`, and `F̂` has class uniformizers exactly
  when `F` has (`HasClassUniformizers.toBasic`).
* `main_to_B_of_compatible` (proved, with the non-item lemma `hasClassUniformizers_of_toBasic`):
  all of `B` under `IsCompatible`.  Hence `A_to_B_of_compatible`.
* `A_to_B` is not proved: `B` has no `IsCompatible`, which the project shows does not follow from
  Definition 19.7.11 (`not_isCompatible_twistBasic`).
* `B_to_A` is not proved: `A` also contains the other conjuncts of `theorem_19_7_29_hyp` (covering
  uniformizers of `B`, the open embeddings `|Ψ̂|`, the sheet-model identities of `Ψ̂`, the
  fibred-product description through `gammaFib`) and the identification of the structure of
  `theorem_19_7_29_functor` with `(F̂, M)`, which `B` does not state. -/

namespace RoundTrip.V19_89_r2
open Polyfold GroupoidalCategory

abbrev B : Prop := RoundTrip.V19_89.B

/-- The project's statement (universe `0`). -/
def A : Prop :=
  (type_of% @CoveringBasicConstruction.theorem_19_7_29_hyp.{0}) ∧
  (type_of% @CoveringBasicConstruction.theorem_19_7_29_content.{0}) ∧
  (type_of% @CoveringBasicConstruction.theorem_19_7_29_functor.{0})

theorem A_holds : A :=
  ⟨@CoveringBasicConstruction.theorem_19_7_29_hyp.{0},
   @CoveringBasicConstruction.theorem_19_7_29_content.{0},
   @CoveringBasicConstruction.theorem_19_7_29_functor.{0}⟩

/-- The main conjunct. -/
abbrev Amain : Prop := type_of% @CoveringBasicConstruction.theorem_19_7_29_content.{0}

/-- The conclusion of `B` for one basic construction. -/
def Body {A B : GroupoidalCategory.{0}} {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr}
    (Bh : CoveringBasicConstruction P) (hB : Bh.toBasic.U.HasClassUniformizers)
    (hm : @TopologicalSpace.MetrizableSpace B.OrbitSpace (Bh.toBasic.natTop hB)) : Prop :=
  ∃ hA : @TopologicalSpace.MetrizableSpace A.OrbitSpace (RoundTrip.V19_89.topA Bh),
    ∃ Q : ProperPolyfoldCoveringFunctor (RoundTrip.V19_89.GA Bh hA)
        (Bh.toBasic.toGCTOfMetrizable hB hm),
      Q.P = P ∧ Q.S.SB = BasicConstruction.toPolyfoldConstruction hm

theorem B_iff : B ↔ ∀ (A B : GroupoidalCategory.{0})
    (P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr), IsFiniteToOneCovering P →
    ∀ (Bh : CoveringBasicConstruction P) (hB : Bh.toBasic.U.HasClassUniformizers)
      (hm : @TopologicalSpace.MetrizableSpace B.OrbitSpace (Bh.toBasic.natTop hB)),
      Body Bh hB hm := Iff.rfl

/-- `B` gives the main conjunct (`IsCompatible` is not used). -/
theorem B_to_main : B → Amain := by
  intro hB A B P Bh hP _ hU hm
  exact hB A B P hP Bh hU.toBasic hm

/-- The main conjunct gives `B` under `IsCompatible`. -/
theorem main_to_B_of_compatible (h : Amain) :
    ∀ (A B : GroupoidalCategory.{0}) (P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr),
      IsFiniteToOneCovering P →
      ∀ (Bh : CoveringBasicConstruction P) (hB : Bh.toBasic.U.HasClassUniformizers)
        (hm : @TopologicalSpace.MetrizableSpace B.OrbitSpace (Bh.toBasic.natTop hB)),
        Bh.IsCompatible → Body Bh hB hm := by
  intro A B P hP Bh hB hm hC
  exact h Bh hP hC (Bh.hasClassUniformizers_of_toBasic hB) hm

theorem A_to_B_of_compatible (h : A) :
    ∀ (A B : GroupoidalCategory.{0}) (P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr),
      IsFiniteToOneCovering P →
      ∀ (Bh : CoveringBasicConstruction P) (hB : Bh.toBasic.U.HasClassUniformizers)
        (hm : @TopologicalSpace.MetrizableSpace B.OrbitSpace (Bh.toBasic.natTop hB)),
        Bh.IsCompatible → Body Bh hB hm :=
  main_to_B_of_compatible h.2.1

#rt_check RoundTrip.V19_89_r2.B_to_main
  [Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_hyp,
   Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_content,
   Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_functor]
#rt_check RoundTrip.V19_89_r2.main_to_B_of_compatible
  [Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_hyp,
   Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_content,
   Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_functor]
#rt_check RoundTrip.V19_89_r2.A_to_B_of_compatible
  [Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_hyp,
   Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_content,
   Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_functor]
#rt_overlap RoundTrip.V19_89_r2.B_to_main
  [Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_hyp,
   Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_content,
   Polyfold.GroupoidalCategory.CoveringBasicConstruction.theorem_19_7_29_functor]

end RoundTrip.V19_89_r2
