import Polyfold
import RoundTrip.Check
import RoundTrip.Blind.V19_59

set_option maxSynthPendingDepth 3

/-! Round trip for V19_59 (2021 Theorem 19.6.11, p. 898: the topology of `M(Ψ̄, Ψ̄')`).

`A` is the conjunction of the types of `theorem_19_6_11` (topology axioms for `IsOpenTr`,
regular, Hausdorff, locally metrizable), `_one` (`s` local homeo), `_two` (`t`), `_three`
(`u` continuous), `_five` (multiplication continuous), `_six` (`p` continuous), at universe `0`.
`theorem_19_6_11_four` (`ι`) is a `def` (a `≃ₜ`), so it is vocabulary, not a conjunct.
`A` speaks of a basic strong bundle construction `Bs` and its chosen representative `Bs.rep`;
`B` of arbitrary bundle transition data `F̄` of a strong bundle uniformizer construction, with
the topology generated by the printed collection `openTr`.

Glue: `g1` (`B`'s `M(Ψ̄, Ψ̄')` is homeomorphic by the identity to `F̄.toETD.Tr`: same open sets),
`idTr` (equivalent transition data give the same topology, the non-item `isOpenTr_of_equiv`),
`hm = g1 ≫ idTr`, and the induced maps on fibred products.
* `A_to_B`: for `F̄`, take `Bs := ⟨Fb, ⟦F̄⟧⟩`; `Bs.rep ≈ F̄` (`Quotient.exact`, `equiv_iff`,
  `toETD_equiv`); every clause transfers along `hm` (`isInducing.regularSpace`,
  `isEmbedding.t2Space`, `restrictPreimage` for local metrizability, `IsLocalHomeomorph.comp`,
  composition for `u`, `m`, `p`).  Two clauses of `B` do not use `A`: "the open sets are
  exactly `T̄`" (`isOpen_MT_iff`, from `g1`) and "`ι` is a homeomorphism" (the non-item
  `TransitionData.invHomeomorph`; `A` has no Prop for (4)).
* `B_to_A`: apply `B` to `Fb := Bs.U`, `F̄ := Bs.rep`, `Ψ̄ := ofE Ψe` (`toEUnif (ofE Ψe) = Ψe` by
  `rfl`) and transfer back along `hm.symm`; `A`'s topology axioms from `B`'s "open = `T̄`". -/

noncomputable section

namespace RoundTrip.V19_59
open Polyfold GroupoidalCategory Topology TopologicalSpace
open GroupoidalCategory.UniformizerConstruction
open GroupoidalCategory.StrongBundleUniformizerConstruction

def A : Prop :=
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_one.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_two.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_three.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_five.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_six.{0})

theorem A_holds : A :=
  ⟨@Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_one.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_two.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_three.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_five.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_six.{0}⟩

variable {C : GroupoidalCategory.{0}}

/-- The identity `F₁.Tr → F₂.Tr` for equivalent transition data (Lemma 19.3.1). -/
def idTr {U : C.UniformizerConstruction} {F₁ F₂ : U.TransitionData} (e : F₁.Equiv F₂)
    (Ψ Ψ' : U.Unif) : F₁.Tr Ψ Ψ' ≃ₜ F₂.Tr Ψ Ψ' where
  toFun := id
  invFun := id
  left_inv _ := rfl
  right_inv _ := rfl
  continuous_toFun := continuous_def.2 fun _ hs => TransitionData.isOpenTr_of_equiv e.symm hs
  continuous_invFun := continuous_def.2 fun _ hs => TransitionData.isOpenTr_of_equiv e hs

variable {μ : C.BanFunctor} {Fb : StrongBundleUniformizerConstruction μ}

/-- `B`'s `M(Ψ̄, Ψ̄')` (topology generated by `T̄`) is `Fbar.toETD.Tr` (topology `T̄`). -/
def g1 (Fbar : Fb.BundleTransitionData) (Ψ Ψ' : Fb.Unif) :
    MT Fbar Ψ Ψ' ≃ₜ Fbar.toETD.Tr (Fb.toEUnif Ψ) (Fb.toEUnif Ψ') where
  toFun := id
  invFun := id
  left_inv _ := rfl
  right_inv _ := rfl
  continuous_toFun := continuous_def.2 fun _ hs => isOpen_generateFrom_of_mem hs
  continuous_invFun := continuous_generateFrom_iff.2 fun _ hs => hs

theorem isOpen_MT_iff (Fbar : Fb.BundleTransitionData) (Ψ Ψ' : Fb.Unif)
    (W : Set (MT Fbar Ψ Ψ')) : IsOpen W ↔ openTr Fbar Ψ Ψ' W :=
  ⟨fun h => (g1 Fbar Ψ Ψ').symm.continuous.isOpen_preimage W h,
    fun h => isOpen_generateFrom_of_mem h⟩

/-- The composite `MT Fbar Ψ Ψ' ≃ₜ Bs.MBar Ψ Ψ'` for a representative `Fbar`. -/
def hm (Bs : C.BasicStrongBundleConstruction μ) (Fbar : Bs.U.BundleTransitionData)
    (e : Bs.rep.toTD.Equiv Fbar.toTD) (Ψ Ψ' : Bs.U.Unif) :
    MT Fbar Ψ Ψ' ≃ₜ Bs.MBar (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ') :=
  (g1 Fbar Ψ Ψ').trans (idTr (BundleTransitionData.toETD_equiv e).symm _ _)

/-- The fibred products. -/
def fpMap (Bs : C.BasicStrongBundleConstruction μ) (Fbar : Bs.U.BundleTransitionData)
    (e : Bs.rep.toTD.Equiv Fbar.toTD) (Ψ Ψ' Ψ'' : Bs.U.Unif) :
    FP Fbar Ψ Ψ' Ψ'' → Bs.rep.toETD.FibProd (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ') (Bs.U.toEUnif Ψ'') :=
  fun q => ⟨(hm Bs Fbar e Ψ' Ψ'' q.1.1, hm Bs Fbar e Ψ Ψ' q.1.2), q.2⟩

theorem continuous_fpMap (Bs : C.BasicStrongBundleConstruction μ)
    (Fbar : Bs.U.BundleTransitionData) (e : Bs.rep.toTD.Equiv Fbar.toTD) (Ψ Ψ' Ψ'' : Bs.U.Unif) :
    Continuous (fpMap Bs Fbar e Ψ Ψ' Ψ'') :=
  Continuous.subtype_mk (((hm Bs Fbar e Ψ' Ψ'').continuous.comp
    (continuous_fst.comp continuous_subtype_val)).prodMk
      ((hm Bs Fbar e Ψ Ψ').continuous.comp (continuous_snd.comp continuous_subtype_val))) _

def fpMapInv (Bs : C.BasicStrongBundleConstruction μ) (Fbar : Bs.U.BundleTransitionData)
    (e : Bs.rep.toTD.Equiv Fbar.toTD) (Ψ Ψ' Ψ'' : Bs.U.Unif) :
    Bs.rep.toETD.FibProd (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ') (Bs.U.toEUnif Ψ'') →
      FP Fbar Ψ Ψ' Ψ'' :=
  fun q => ⟨((hm Bs Fbar e Ψ' Ψ'').symm q.1.1, (hm Bs Fbar e Ψ Ψ').symm q.1.2), q.2⟩

theorem continuous_fpMapInv (Bs : C.BasicStrongBundleConstruction μ)
    (Fbar : Bs.U.BundleTransitionData) (e : Bs.rep.toTD.Equiv Fbar.toTD) (Ψ Ψ' Ψ'' : Bs.U.Unif) :
    Continuous (fpMapInv Bs Fbar e Ψ Ψ' Ψ'') :=
  Continuous.subtype_mk (((hm Bs Fbar e Ψ' Ψ'').symm.continuous.comp
    (continuous_fst.comp continuous_subtype_val)).prodMk
      ((hm Bs Fbar e Ψ Ψ').symm.continuous.comp (continuous_snd.comp continuous_subtype_val))) _

/-- The base transition sets for equivalent underlying transition data. -/
def hb (Bs : C.BasicStrongBundleConstruction μ) (Fbar : Bs.U.BundleTransitionData)
    (e : Bs.rep.toTD.Equiv Fbar.toTD) (Ψ Ψ' : Bs.U.Unif) :
    Bs.rep.toTD.Tr (Bs.U.baseUnif Ψ) (Bs.U.baseUnif Ψ') ≃ₜ
      Fbar.toTD.Tr (Bs.U.baseUnif Ψ) (Bs.U.baseUnif Ψ') :=
  idTr e _ _

/-- `A` for `Bs` gives `B`'s clauses for any representative `Fbar` of `Bs.𝓕`. -/
theorem clauses_of_A (hA : A) (Bs : C.BasicStrongBundleConstruction μ)
    (Fbar : Bs.U.BundleTransitionData) (e : Bs.rep.toTD.Equiv Fbar.toTD) :
    (∀ Ψ Ψ' : Bs.U.Unif,
      (∀ W : Set (MT Fbar Ψ Ψ'), IsOpen W ↔ openTr Fbar Ψ Ψ' W) ∧
      RegularSpace (MT Fbar Ψ Ψ') ∧ T2Space (MT Fbar Ψ Ψ') ∧
      ∀ h : MT Fbar Ψ Ψ', ∃ W : Set (MT Fbar Ψ Ψ'), IsOpen W ∧ h ∈ W ∧
        TopologicalSpace.MetrizableSpace W) ∧
    (∀ Ψ Ψ' : Bs.U.Unif,
      IsLocalHomeomorph (fun h : MT Fbar Ψ Ψ' =>
        (GroupoidStr.TransitionSet.src (h : (Ψ : μ.cat.Uniformizer).Trans Ψ') :
          (Ψ : μ.cat.Uniformizer).O)) ∧
      IsLocalHomeomorph (fun h : MT Fbar Ψ Ψ' =>
        (GroupoidStr.TransitionSet.tgt (h : (Ψ : μ.cat.Uniformizer).Trans Ψ') :
          (Ψ' : μ.cat.Uniformizer).O))) ∧
    (∀ Ψ : Bs.U.Unif, Continuous (uMap Fbar Ψ)) ∧
    (∀ Ψ Ψ' Ψ'' : Bs.U.Unif, Continuous (mMap Fbar Ψ Ψ' Ψ'')) ∧
    (∀ Ψ Ψ' : Bs.U.Unif, Continuous (pMap Fbar Ψ Ψ')) := by
  obtain ⟨h0, h1, h2, h3, h5, h6⟩ := hA
  refine ⟨fun Ψ Ψ' => ⟨isOpen_MT_iff Fbar Ψ Ψ', ?_, ?_, fun h => ?_⟩, fun Ψ Ψ' => ⟨?_, ?_⟩,
    fun Ψ => ?_, fun Ψ Ψ' Ψ'' => ?_, fun Ψ Ψ' => ?_⟩
  · have := (h0 Bs (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ')).2.1
    exact (hm Bs Fbar e Ψ Ψ').isEmbedding.isInducing.regularSpace
  · have := (h0 Bs (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ')).2.2.1
    exact (hm Bs Fbar e Ψ Ψ').isEmbedding.t2Space
  · obtain ⟨W, hW, hhW, hWm⟩ :=
      (h0 Bs (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ')).2.2.2 (hm Bs Fbar e Ψ Ψ' h)
    exact ⟨_, hW.preimage (hm Bs Fbar e Ψ Ψ').continuous, hhW,
      ((hm Bs Fbar e Ψ Ψ').isEmbedding.restrictPreimage W).metrizableSpace⟩
  · exact (h1 Bs (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ')).comp
      (hm Bs Fbar e Ψ Ψ').isLocalHomeomorph
  · exact (h2 Bs (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ')).comp
      (hm Bs Fbar e Ψ Ψ').isLocalHomeomorph
  · exact (hm Bs Fbar e Ψ Ψ).symm.continuous.comp (h3 Bs (Bs.U.toEUnif Ψ))
  · exact (hm Bs Fbar e Ψ Ψ'').symm.continuous.comp
      ((h5 Bs (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ') (Bs.U.toEUnif Ψ'')).comp
        (continuous_fpMap Bs Fbar e Ψ Ψ' Ψ''))
  · exact (hb Bs Fbar e Ψ Ψ').continuous.comp
      ((h6 Bs (Bs.U.toEUnif Ψ) (Bs.U.toEUnif Ψ')).comp (hm Bs Fbar e Ψ Ψ').continuous)

theorem A_to_B : A → B := by
  intro hA C μ Fb Fbar
  let Bs : C.BasicStrongBundleConstruction μ := ⟨Fb, Quotient.mk _ Fbar⟩
  have e : Bs.rep.toTD.Equiv Fbar.toTD :=
    BundleTransitionData.equiv_iff.1 (Quotient.exact (Bs.mk_rep))
  obtain ⟨c1, c2, c3, c4, c6⟩ := clauses_of_A hA Bs Fbar e
  exact ⟨c1, c2, c3, c4, fun Ψ Ψ' => ⟨(g1 Fbar Ψ Ψ').trans
    (((Fbar.toETD.invHomeomorph (Fb.toEUnif Ψ) (Fb.toEUnif Ψ'))).trans (g1 Fbar Ψ' Ψ).symm),
      fun h => rfl⟩, c6⟩

theorem B_to_A : B → A := by
  intro hB
  have key := fun (C : GroupoidalCategory.{0}) (μ : C.BanFunctor)
    (Bs : C.BasicStrongBundleConstruction μ) => hB C μ Bs.U Bs.rep
  have e : ∀ {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}
      (Bs : C.BasicStrongBundleConstruction μ), Bs.rep.toTD.Equiv Bs.rep.toTD :=
    fun Bs => TransitionData.equiv_refl _
  refine ⟨fun Bs Ψe Ψe' => ⟨?_, ?_, ?_, fun h => ?_⟩, fun Bs Ψe Ψe' => ?_, fun Bs Ψe Ψe' => ?_,
    fun Bs Ψe => ?_, fun Bs Ψe Ψe' Ψe'' => ?_, fun Bs Ψe Ψe' => ?_⟩
  · have h1 := ((key _ _ Bs).1 (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).1
    refine ⟨(h1 _).1 isOpen_univ, fun W₁ W₂ a b => (h1 _).1 (((h1 _).2 a).inter ((h1 _).2 b)),
      fun S hS => (h1 _).1 (isOpen_sUnion fun W hW => (h1 _).2 (hS W hW))⟩
  · have := ((key _ _ Bs).1 (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).2.1
    exact (hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).symm.isEmbedding.isInducing.regularSpace
  · have := ((key _ _ Bs).1 (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).2.2.1
    exact (hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).symm.isEmbedding.t2Space
  · obtain ⟨W, hW, hhW, hWm⟩ := ((key _ _ Bs).1 (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).2.2.2
      ((hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).symm h)
    exact ⟨_, hW.preimage (hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).symm.continuous, hhW,
      ((hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).symm.isEmbedding.restrictPreimage
        W).metrizableSpace⟩
  · exact ((key _ _ Bs).2.1 (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).1.comp
      (hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).symm.isLocalHomeomorph
  · exact ((key _ _ Bs).2.1 (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).2.comp
      (hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).symm.isLocalHomeomorph
  · exact (hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe)).continuous.comp
      ((key _ _ Bs).2.2.1 (Bs.U.ofE Ψe))
  · exact (hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe'')).continuous.comp
      (((key _ _ Bs).2.2.2.1 (Bs.U.ofE Ψe) (Bs.U.ofE Ψe') (Bs.U.ofE Ψe'')).comp
        (continuous_fpMapInv Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe') (Bs.U.ofE Ψe'')))
  · exact ((key _ _ Bs).2.2.2.2.2 (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).comp
      (hm Bs Bs.rep (e Bs) (Bs.U.ofE Ψe) (Bs.U.ofE Ψe')).symm.continuous

#rt_check RoundTrip.V19_59.A_to_B [Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11,
