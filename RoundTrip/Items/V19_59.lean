  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_two,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_three,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_11_five,
