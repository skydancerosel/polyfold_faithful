/-! Round trip for V19_56 (2021 Theorem 19.6.8, p. 897: the natural topology `T̄` on `|E_μ|`).

`A` is the conjunction of the types of `theorem_19_6_8_one` … `theorem_19_6_8_five` at universe
`0`.  The project states (2)–(5) for its topology `topE hB` (the natural topology of the
uniformizer construction `toE` of `E_μ`), and (1) as the three topology axioms for `BarOpen`.
`B` uses the topology generated by `BarOpen`.

* Glue: `gen_eq`: `generateFrom {W | BarOpen W} = topE hB` (from the non-item
  `isOpen_topE_iff`, i.e. Definition 19.6.7 = natural openness, and
  `generateFrom_setOfPred_isOpen`).  `qHomeo`: Mathlib's orbit quotient `G\K` is homeomorphic to
  the orbit space of the translation groupoid `G ⋉ K` (same relation, both quotient topologies).
* `A_to_B`: rewrite with `gen_eq`; (1) of `B` (open sets = `BarOpen`) is then `isOpen_topE_iff`
  and does not use `A`'s (1); (2), (4), (5) are `A`'s; (3): `e := |Ψ̄| ∘ qHomeo`.
* `B_to_A`: rewrite `B` with `gen_eq`; `A`'s (1) (the topology axioms for `BarOpen`) from `B`'s
  (1) and the axioms of a topology; (2), (4), (5) directly; (3): `|Ψ̄| = e ∘ qHomeo⁻¹` (equal on
  classes `[a]`). -/

namespace RoundTrip.V19_56
open Polyfold GroupoidalCategory

def A : Prop :=
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_one.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_two.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_three.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_four.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_five.{0})

theorem A_holds : A :=
  ⟨@Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_one.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_two.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_three.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_four.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.theorem_19_6_8_five.{0}⟩

/-- `G\K` (Mathlib's orbit quotient) is homeomorphic to the orbit space of the translation
groupoid `G ⋉ K` (both are quotients of `K` by the same relation). -/
theorem orbitRel_iff {G O : Type} [Group G] [MulAction G O] (a b : O) :
    (MulAction.orbitRel G O) a b ↔ (GroupoidStr.translation G O).orbitSetoid a b := by
  rw [MulAction.orbitRel_apply, MulAction.mem_orbit_iff]
  constructor
  · rintro ⟨g, hg⟩
    exact ⟨(g⁻¹, a), rfl, by change g⁻¹ • a = b; rw [← hg, inv_smul_smul]⟩
  · rintro ⟨p, hs, ht⟩
    change p.2 = a at hs
    change p.1 • p.2 = b at ht
    exact ⟨p.1⁻¹, by rw [← ht, ← hs, inv_smul_smul]⟩

def qHomeo (G O : Type) [Group G] [MulAction G O] [TopologicalSpace O] :
    MulAction.orbitRel.Quotient G O ≃ₜ (GroupoidStr.translation G O).OrbitSpace where
  toFun := Quotient.map' id fun a b h => (orbitRel_iff a b).1 h
  invFun := Quotient.map' id fun a b h => (orbitRel_iff a b).2 h
  left_inv q := by induction q using Quotient.inductionOn' with | h a => rfl
  right_inv q := by induction q using Quotient.inductionOn' with | h a => rfl
  continuous_toFun := continuous_id.quotient_map' _
  continuous_invFun := continuous_id.quotient_map' _

variable {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}

/-- `B`'s topology on `|E|` (generated by `T̄`) is the project's `topE`. -/
theorem gen_eq (Bs : C.BasicStrongBundleConstruction μ) (hB : Bs.base.U.HasClassUniformizers) :
    TopologicalSpace.generateFrom {W | Bs.BarOpen W} = Bs.topE hB := by
  conv_rhs => rw [← TopologicalSpace.generateFrom_setOfPred_isOpen (Bs.topE hB)]
  congr 1
  ext W
  exact (Bs.isOpen_topE_iff hB).symm

theorem A_to_B : A → B := by
  rintro ⟨-, h2, h3, h4, h5⟩ C μ Bs hB
  rw [gen_eq Bs hB]
  let _ := Bs.topE hB
  refine ⟨fun W => Bs.isOpen_topE_iff hB, fun α Ψe hΨe V hV => h2 Bs hB hΨe hV,
    fun α Ψe hΨe => ⟨Ψe.functor.orbitMap ∘ qHomeo Ψe.G Ψe.O, fun a => rfl,
      (h3 Bs hB hΨe).comp (qHomeo Ψe.G Ψe.O).isOpenEmbedding⟩, h4 Bs hB, h5 Bs hB⟩

theorem B_to_A : B → A := by
  intro hBB
  have key : ∀ (C : GroupoidalCategory.{0}) (μ : C.BanFunctor)
      (Bs : C.BasicStrongBundleConstruction μ) (hB : Bs.base.U.HasClassUniformizers), _ :=
    fun C μ Bs hB => by
      have := hBB C μ Bs hB
      rw [gen_eq Bs hB] at this
      exact this
  refine ⟨fun Bs hB => ?_, fun Bs hB α Ψe hΨe V hV => (key _ _ Bs hB).2.1 α Ψe hΨe V hV,
    fun Bs hB α Ψe hΨe => ?_, fun Bs hB => (key _ _ Bs hB).2.2.2.1,
    fun Bs hB => (key _ _ Bs hB).2.2.2.2⟩
  · have h1 := (key _ _ Bs hB).1
    let _ := Bs.topE hB
    refine ⟨(h1 _).1 isOpen_univ, fun W₁ W₂ a b => (h1 _).1 (((h1 _).2 a).inter ((h1 _).2 b)),
      fun S hS => (h1 _).1 (isOpen_sUnion fun W hW => (h1 _).2 (hS W hW))⟩
  · let _ := Bs.topE hB
    obtain ⟨e, he, hoe⟩ := (key _ _ Bs hB).2.2.1 α Ψe hΨe
    have : Ψe.functor.orbitMap = e ∘ (qHomeo Ψe.G Ψe.O).symm := by
      funext q
      induction q using Quotient.inductionOn with
      | h a => exact (he a).symm
    rw [this]
    exact hoe.comp (qHomeo Ψe.G Ψe.O).symm.isOpenEmbedding

