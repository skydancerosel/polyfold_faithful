import Polyfold
import RoundTrip.Check
import RoundTrip.Blind.V19_85

set_option maxSynthPendingDepth 3

/-! Round trip for V19_85 (2021 Propositions 19.7.23 and 19.7.24, pp. 923–924: (V2) and
paracompactness pass between `|A|` and `|B|`).

The item lists `PropernessV2A` (a definition: vocabulary) and the theorems
`proposition_19_7_23_hyp`, `proposition_19_7_24_hyp` (the two main conjuncts) and the point-set
lemmas `Chapter19.paracompactSpace_of_tube`, `paracompactSpace_of_tube_of_isOpenMap` (perfect maps
and paracompactness); `A` is the conjunction of their types at universe `0`.

The project's statements assume `IsCompatible` (every top target map `t̂` is continuous) and
`HasClassUniformizers` for `F̂`, and use `natTopA` (whose open sets are exactly `NatOpenA`, a
topology under these hypotheses).  `B` assumes `HasClassUniformizers` for the underlying `F`
(equivalent: `F(β) = {Ψ̂.Ψ | Ψ̂ ∈ F̂(β)}`), no compatibility, and uses the topology generated by
`NatOpenA`.

* `topA_eq`: under `IsCompatible` the two topologies coincide (`generateFrom` of the open sets of
  a topology is that topology).
* `B_to_A`: proved: the two main conjuncts are `B` after `topA_eq`; the two point-set lemmas are
  re-proved outright (the project's proofs, copied; Mathlib only).
* `A_to_B`: not proved.  `B` claims the two equivalences also for basic constructions that are
  not compatible, where `NatOpenA` need not be closed under intersections and `A` says nothing.
  Restricted to compatible constructions, `A ⇒ B` is proved (`A_to_BC`). -/

namespace RoundTrip.V19_85
open Polyfold GroupoidalCategory

def A : Prop :=
  (type_of% @Polyfold.GroupoidalCategory.CoveringBasicConstruction.proposition_19_7_23_hyp.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.CoveringBasicConstruction.proposition_19_7_24_hyp.{0}) ∧
  (type_of% @Polyfold.Chapter19.paracompactSpace_of_tube.{0}) ∧
  (type_of% @Polyfold.Chapter19.paracompactSpace_of_tube_of_isOpenMap.{0})

theorem A_holds : A :=
  ⟨@Polyfold.GroupoidalCategory.CoveringBasicConstruction.proposition_19_7_23_hyp.{0},
    @Polyfold.GroupoidalCategory.CoveringBasicConstruction.proposition_19_7_24_hyp.{0},
    @Polyfold.Chapter19.paracompactSpace_of_tube.{0},
    @Polyfold.Chapter19.paracompactSpace_of_tube_of_isOpenMap.{0}⟩

/-- Under `IsCompatible`, `B`'s topology `generateFrom NatOpenA` is the project's `natTopA`. -/
theorem topA_eq {A B : GroupoidalCategory.{0}}
    {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr} (Bh : CoveringBasicConstruction P)
    (hP : IsFiniteToOneCovering P) (hC : Bh.IsCompatible) (hU : Bh.HasClassUniformizers) :
    topA Bh = Bh.natTopA hP hC hU :=
  TopologicalSpace.generateFrom_setOfPred_isOpen (Bh.natTopA hP hC hU)

/-- `HasClassUniformizers` for `F` gives it for `F̂`. -/
theorem hasClassUniformizers_of_toBasic {A B : GroupoidalCategory.{0}}
    {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr} (Bh : CoveringBasicConstruction P)
    (hB : Bh.toBasic.U.HasClassUniformizers) : Bh.HasClassUniformizers := fun z => by
  obtain ⟨β, hβ, Ψ, Ψh, hΨh, -⟩ := hB z
  exact ⟨β, hβ, Ψh, hΨh⟩

theorem main_B_to_A_23 : B →
    (type_of% @Polyfold.GroupoidalCategory.CoveringBasicConstruction.proposition_19_7_23_hyp.{0}) := by
  intro hB A B P Bh hP hC hU
  have h := (hB A B P hP Bh hU.toBasic).1
  unfold V2A at h
  rw [topA_eq Bh hP hC hU] at h
  exact h

theorem main_B_to_A_24 : B →
    (type_of% @Polyfold.GroupoidalCategory.CoveringBasicConstruction.proposition_19_7_24_hyp.{0}) := by
  intro hB A B P Bh hP hC hU
  have h := (hB A B P hP Bh hU.toBasic).2
  rw [topA_eq Bh hP hC hU] at h
  exact h

/-! ### The point-set lemmas, re-proved outright (the project's proofs, copied) -/

section Perfect

open Set Function Topology

variable {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y] {f : X → Y}

theorem tube' [ParacompactSpace Y] (hc : Continuous f)
    (hfin : ∀ y, (f ⁻¹' {y}).Finite)
    (htube : ∀ (y : Y) (U : Set X), IsOpen U → f ⁻¹' {y} ⊆ U →
      ∃ V, IsOpen V ∧ y ∈ V ∧ f ⁻¹' V ⊆ U) :
    ParacompactSpace X := by
  refine ⟨fun α s hso hsU => ?_⟩
  have hcov : ∀ x, ∃ a, x ∈ s a := fun x => mem_iUnion.1 (hsU.symm ▸ mem_univ x)
  choose a ha using hcov
  have hT : ∀ y, ∃ V, IsOpen V ∧ y ∈ V ∧ f ⁻¹' V ⊆ ⋃ x ∈ f ⁻¹' {y}, s (a x) := fun y =>
    htube y _ (isOpen_biUnion fun x _ => hso (a x)) fun x hx => mem_iUnion₂.2 ⟨x, hx, ha x⟩
  choose V hVo hyV hVsub using hT
  obtain ⟨β, t, hto, htU, htlf, htsub⟩ := ParacompactSpace.locallyFinite_refinement
    Y V hVo (eq_univ_of_forall fun y => mem_iUnion.2 ⟨y, hyV y⟩)
  choose yb hyb using htsub
  let T : β × X → Set X := fun p => f ⁻¹' t p.1 ∩ s (a p.2) ∩ {_w | f p.2 = yb p.1}
  refine ⟨β × X, T, fun p => ?_, ?_, ?_, fun p => ⟨a p.2, fun w hw => hw.1.2⟩⟩
  · by_cases h : f p.2 = yb p.1
    · have he : {_w : X | f p.2 = yb p.1} = univ := eq_univ_of_forall fun _ => h
      simp only [T, he, inter_univ]
      exact ((hto p.1).preimage hc).inter (hso _)
    · have he : {_w : X | f p.2 = yb p.1} = ∅ := eq_empty_of_forall_notMem fun _ hw => h hw
      simp only [T, he, inter_empty]
      exact isOpen_empty
  · refine eq_univ_of_forall fun w => ?_
    obtain ⟨b, hb⟩ := mem_iUnion.1 (htU.symm ▸ mem_univ (f w))
    obtain ⟨x, hx, hwx⟩ := mem_iUnion₂.1 (hVsub (yb b) (hyb b hb))
    exact mem_iUnion.2 ⟨(b, x), ⟨hb, hwx⟩, hx⟩
  · intro w
    obtain ⟨N, hN, hNfin⟩ := htlf (f w)
    refine ⟨f ⁻¹' N, hc.continuousAt.preimage_mem_nhds hN, ?_⟩
    refine (hNfin.biUnion fun b _ => (hfin (yb b)).image fun x => (b, x)).subset ?_
    rintro ⟨b, x⟩ ⟨w', ⟨⟨hw't, -⟩, hx⟩, hw'N⟩
    exact mem_iUnion₂.2 ⟨b, ⟨f w', hw't, hw'N⟩, x, hx, rfl⟩

theorem tube_of_isOpenMap' [ParacompactSpace X] (hc : Continuous f)
    (hs : Surjective f) (ho : IsOpenMap f) (hfin : ∀ y, (f ⁻¹' {y}).Finite)
    (htube : ∀ (y : Y) (U : Set X), IsOpen U → f ⁻¹' {y} ⊆ U →
      ∃ V, IsOpen V ∧ y ∈ V ∧ f ⁻¹' V ⊆ U) :
    ParacompactSpace Y := by
  refine ⟨fun α s hso hsU => ?_⟩
  obtain ⟨β, t, hto, htU, htlf, htsub⟩ := ParacompactSpace.locallyFinite_refinement α
    (fun a => f ⁻¹' s a) (fun a => (hso a).preimage hc) (by rw [← preimage_iUnion, hsU,
      preimage_univ])
  refine ⟨β, fun b => f '' t b, fun b => ho _ (hto b), ?_, ?_, fun b => ?_⟩
  · rw [← image_iUnion, htU, image_univ, hs.range_eq]
  · intro y
    have hN : ∀ x, ∃ N, IsOpen N ∧ x ∈ N ∧ {b | (t b ∩ N).Nonempty}.Finite := fun x => by
      obtain ⟨N, hN, hfinN⟩ := htlf x
      obtain ⟨N', hN'N, hN'o, hxN'⟩ := mem_nhds_iff.1 hN
      exact ⟨N', hN'o, hxN', hfinN.subset fun b ⟨w, hw, hwN⟩ => ⟨w, hw, hN'N hwN⟩⟩
    choose N hNo hxN hNfin using hN
    obtain ⟨V, hVo, hyV, hVsub⟩ := htube y (⋃ x ∈ f ⁻¹' {y}, N x)
      (isOpen_biUnion fun x _ => hNo x) fun x hx => mem_iUnion₂.2 ⟨x, hx, hxN x⟩
    refine ⟨V, hVo.mem_nhds hyV, ((hfin y).biUnion fun x _ => hNfin x).subset ?_⟩
    rintro b ⟨_, ⟨w, hw, rfl⟩, hwV⟩
    obtain ⟨x, hx, hwx⟩ := mem_iUnion₂.1 (hVsub hwV)
    exact mem_iUnion₂.2 ⟨x, hx, w, hw, hwx⟩
  · obtain ⟨a, ha⟩ := htsub b
    exact ⟨a, (image_mono ha).trans (image_preimage_subset f _)⟩

end Perfect

theorem B_to_A : B → A := fun hB =>
  ⟨main_B_to_A_23 hB, main_B_to_A_24 hB, @tube', @tube_of_isOpenMap'⟩

/-! ### `A ⇒ B` for compatible constructions -/

/-- `B` restricted to compatible basic constructions. -/
def BC : Prop :=
  ∀ (A B : GroupoidalCategory.{0}) (P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr),
    IsFiniteToOneCovering P →
    ∀ (Bh : CoveringBasicConstruction P) (hB : Bh.toBasic.U.HasClassUniformizers),
      Bh.IsCompatible →
      (V2A Bh ↔ Bh.toBasic.PropernessV2 hB) ∧
      (@ParacompactSpace A.OrbitSpace (topA Bh) ↔
        @ParacompactSpace B.OrbitSpace (Bh.toBasic.natTop hB))

theorem A_to_BC : A → BC := by
  rintro ⟨h23, h24, -, -⟩ A B P hP Bh hB hC
  have hU := hasClassUniformizers_of_toBasic Bh hB
  have e := topA_eq Bh hP hC hU
  refine ⟨?_, ?_⟩
  · unfold V2A
    rw [e]
    exact h23 Bh hP hC hU
  · rw [e]
    exact h24 Bh hP hC hU

