#rt_overlap RoundTrip.V19_85.B_to_A [Polyfold.GroupoidalCategory.CoveringBasicConstruction.proposition_19_7_23_hyp,
  Polyfold.GroupoidalCategory.CoveringBasicConstruction.proposition_19_7_24_hyp,
