/-- The blind collection for `|P*E_B|` is the project's `NatOpenPull`. -/
theorem natOpenPull_iff {A B : GroupoidalCategory.{0}}
    {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr} {μ : B.BanFunctor}
    (Ft : PullbackUniformizerConstruction P μ) (U : Set (μ.pull P).cat.OrbitSpace) :
    RoundTrip.V19_97.NatOpenPull Ft U ↔ Ft.NatOpenPull U := by
  constructor
  · intro h z hz
    obtain ⟨⟨β, x, hx⟩, hβ, w, hw, V, hV, hwV, hsub⟩ := h z hz
    exact ⟨β, hβ, x, hx, w, hw, V, hV, hwV, hsub⟩
  · intro h z hz
    obtain ⟨β, hβ, x, hx, w, hw, V, hV, hwV, hsub⟩ := h z hz
    exact ⟨⟨β, x, hx⟩, hβ, w, hw, V, hV, hwV, hsub⟩

theorem generateFrom_natOpenPull {A B : GroupoidalCategory.{0}}
    {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr} {μ : B.BanFunctor}
    (Ft : PullbackUniformizerConstruction P μ) :
    TopologicalSpace.generateFrom {U | RoundTrip.V19_97.NatOpenPull Ft U} =
      TopologicalSpace.generateFrom {U | Ft.NatOpenPull U} := by
  congr 1
  ext U
  exact natOpenPull_iff Ft U

/-- The conclusion of `B` for one basic construction. -/
def Body (A B : GroupoidalCategory.{0}) (P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr)
    [Fact (IsFiniteToOneCovering P)] (μ : B.BanFunctor) (Bp : PullbackBasicConstruction P μ) :
    Prop :=
    -- `Γ̂` is fully faithful
    (∀ x : Bp.Ft.Unif, x.x.gammaHat.toFunctor.Full ∧ x.x.gammaHat.toFunctor.Faithful) ∧
    (∀ x y : Bp.Ft.Unif,
      -- (1) the natural strong bundle structure of `m : M(Γ, Γ') → M(Ψ, Ψ')`
      ∃ Kb : StrongBundle (Bp.Ft.basePoly Bp.T.𝓕 x y) (Bp.Ft.mGmap Bp.T.𝓕 x y),
        IsSBIsoId (Bp.Ft.srcBundle Bp.T.𝓕 x y) Kb (Bp.Ft.altH Bp.T.𝓕 x y) ∧
        -- (2) `p` is a surjective local sc-diffeomorphism
        Function.Surjective (Bp.Ft.pBmap Bp.T.𝓕 x y) ∧
        (Bp.Ft.hatPoly Bp.T.𝓕 x y).IsLocalScDiffeo (Bp.Ft.basePoly Bp.T.𝓕 x y)
          (Bp.Ft.pBmap Bp.T.𝓕 x y) ∧
        ∀ hp : (Bp.Ft.hatPoly Bp.T.𝓕 x y).IsScSmoothMap (Bp.Ft.basePoly Bp.T.𝓕 x y)
            (Bp.Ft.pBmap Bp.T.𝓕 x y),
          -- (3) `U` is a strong bundle isomorphism for a unique structure on `m̂`
          ∃ Kh : StrongBundle (Bp.Ft.hatPoly Bp.T.𝓕 x y) (Bp.Ft.mHatMap Bp.T.𝓕 x y),
            IsSBIsoId Kh (Kb.pullback hp) (Bp.Ft.Umap Bp.T.𝓕 x y) ∧
            (∀ Kh' : StrongBundle (Bp.Ft.hatPoly Bp.T.𝓕 x y) (Bp.Ft.mHatMap Bp.T.𝓕 x y),
              IsSBIsoId Kh' (Kb.pullback hp) (Bp.Ft.Umap Bp.T.𝓕 x y) → IsSBIsoId Kh Kh' id) ∧
            -- (4) `p̄` is a surjective local strong bundle isomorphism
            Function.Surjective (Bp.Ft.pbarMap Bp.T.𝓕 x y) ∧
            IsLocalSBIso Kh Kb (Bp.Ft.pBmap Bp.T.𝓕 x y) (Bp.Ft.pbarMap Bp.T.𝓕 x y)) ∧
    -- (5) the orbit spaces are metrizable
    @TopologicalSpace.MetrizableSpace A.OrbitSpace
      (TopologicalSpace.generateFrom {W | (Bp.Ft.toCBC Bp.T.𝓕).NatOpenA W}) ∧
    (∀ hB : (Bp.Ft.toCBC Bp.T.𝓕).toBasic.U.HasClassUniformizers,
      @TopologicalSpace.MetrizableSpace B.OrbitSpace ((Bp.Ft.toCBC Bp.T.𝓕).toBasic.natTop hB)) ∧
    @TopologicalSpace.MetrizableSpace μ.cat.OrbitSpace
      (TopologicalSpace.generateFrom {U | Bp.Ft.NatOpenEB U}) ∧
    @TopologicalSpace.MetrizableSpace (μ.pull P).cat.OrbitSpace
      (TopologicalSpace.generateFrom {U | RoundTrip.V19_97.NatOpenPull Bp.Ft U})

theorem B_iff : B ↔ ∀ (A B : GroupoidalCategory.{0})
    (P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr) [Fact (IsFiniteToOneCovering P)]
    (μ : B.BanFunctor) (Bp : PullbackBasicConstruction P μ), Body A B P μ Bp := Iff.rfl

/-- `B` gives the main conjunct (`IsCompatible` is not used). -/
theorem B_to_main : B → Amain := by
  intro hB A B P μ Ft _ T _
  obtain ⟨-, -, hA, hBm, hEB, hPull⟩ := hB A B P μ ⟨Ft, T⟩
  refine ⟨hA, hBm, hEB, ?_⟩
  rw [← generateFrom_natOpenPull]
  exact hPull

/-- From the conjuncts `theorem_19_8_6_one_four` and `theorem_19_8_6_five_hyp` of `A`: all of
`B` under `IsCompatible`. -/
theorem A_to_B_of_compatible (h14 : type_of% @theorem_19_8_6_one_four.{0})
    (h5 : type_of% @theorem_19_8_6_five_hyp.{0}) :
    ∀ (A B : GroupoidalCategory.{0}) (P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr)
      [Fact (IsFiniteToOneCovering P)] (μ : B.BanFunctor) (Bp : PullbackBasicConstruction P μ),
      Bp.T.toCoveringBasicConstruction.IsCompatible → Body A B P μ Bp := by
  intro A B P _ μ Bp hC
  obtain ⟨hA, hBm, hEB, hPull⟩ := h5 Bp.Ft Bp.T hC
  have h14 := fun x y => h14 (Ft := Bp.Ft) Bp.T.𝓕 x y
  refine ⟨fun x => ⟨(h14 x x).1.2.1, (h14 x x).1.2.2⟩, fun x y => ?_, hA, hBm, hEB, ?_⟩
  · obtain ⟨-, hH, ⟨hpl, hps⟩, ⟨-, -, hU, -⟩, ⟨-, hpbs, hpb, hloc⟩⟩ := h14 x y
    refine ⟨Bp.Ft.bundleG Bp.T.𝓕 x y, ⟨hH.toMap, hH.isStrongBundleIsoOn_univ⟩, hps, hpl,
      fun hp => ⟨Bp.Ft.bundleHat Bp.T.𝓕 x y, ⟨hU.toMap, hU.isStrongBundleIsoOn_univ⟩,
        fun Kh' ⟨h₂, hi₂⟩ => ?_, hpbs, ⟨hpb, fun a => ?_⟩⟩⟩
    · have hI := StrongBundle.isStrongBundleIso_id_of_isStrongBundleIsoOn
        (Bp.Ft.bundleHat Bp.T.𝓕 x y) Kh' hU.toMap h₂
        (fun a => ⟨Set.univ, Set.univ, Set.mem_univ a, hU.isStrongBundleIsoOn_univ⟩)
        (fun a => ⟨Set.univ, Set.univ, Set.mem_univ a, hi₂⟩)
      exact ⟨hI.toMap, hI.isStrongBundleIsoOn_univ⟩
    · obtain ⟨U₀, U₀', ha, hi⟩ := hloc a
      obtain ⟨g, hg⟩ := hi.isScDiffeoOn_base
      exact ⟨U₀, U₀', hg.isOpen_source, ha, hg.isScSmoothOn_inv.isOpen, hi⟩
  · rw [generateFrom_natOpenPull]
    exact hPull

