import Polyfold
import RoundTrip.Check
import RoundTrip.Blind.V19_57

set_option maxSynthPendingDepth 3

/-! Round trip for V19_57 (2021 Proposition 19.6.9, p. 898: `T̄` is metrizable iff `T` is).

`A` is the conjunction of the types of `proposition_19_6_9` (main conjunct; `T` metrizable iff
`topE hB` metrizable), `continuous_zeroOrbit` and `isEmbedding_zeroOrbit` (the zero section
`|S| → |E|`, a step of the proof), at universe `0`.  `B` uses the topology generated by
`BarOpen`, which is `topE hB` (`gen_eq`, from the non-item `isOpen_topE_iff`).

* `A_to_B`: rewrite with `gen_eq`, then `proposition_19_6_9` (sides swapped).
* `B_to_A`: the main conjunct from `B` (rewritten with `gen_eq`).  The two zero-section lemmas
  are proof steps not contained in `B`; they are re-proved outright (the project's proofs,
  copied, from non-item lemmas: `continuous_π_obj`, `isScSmoothSection_fiberZero`,
  `theorem_19_6_8_five`, `LeftInverse.isEmbedding`). -/

namespace RoundTrip.V19_57
open Polyfold GroupoidalCategory Set Topology TopologicalSpace

def A : Prop :=
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.proposition_19_6_9.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.continuous_zeroOrbit.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.isEmbedding_zeroOrbit.{0})

theorem A_holds : A :=
  ⟨@Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.proposition_19_6_9.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.continuous_zeroOrbit.{0},
    @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.isEmbedding_zeroOrbit.{0}⟩

variable {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}

/-- `B`'s topology on `|E|` (generated by `T̄`) is the project's `topE`. -/
theorem gen_eq (Bs : C.BasicStrongBundleConstruction μ) (hB : Bs.base.U.HasClassUniformizers) :
    TopologicalSpace.generateFrom {W | Bs.BarOpen W} = Bs.topE hB := by
  conv_rhs => rw [← TopologicalSpace.generateFrom_setOfPred_isOpen (Bs.topE hB)]
  congr 1
  ext W
  exact (Bs.isOpen_topE_iff hB).symm

theorem main_A_to_B :
    type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.proposition_19_6_9.{0} →
      B := by
  intro h C μ Bs hB
  rw [gen_eq Bs hB]
  exact (h Bs hB).symm

theorem A_to_B : A → B := fun h => main_A_to_B h.1

theorem main_B_to_A : B →
    type_of% @Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.proposition_19_6_9.{0} := by
  intro h C μ Bs hB
  have := h C μ Bs hB
  rw [gen_eq Bs hB] at this
  exact this.symm

/-- Copy of the project's `continuous_zeroOrbit`. -/
theorem continuous_zeroOrbit' (Bs : C.BasicStrongBundleConstruction μ)
    (hB : Bs.base.U.HasClassUniformizers) :
    Continuous[Bs.topS hB, Bs.topE hB] μ.zeroOrbit := by
  let _i₁ := Bs.topS hB
  let _i₂ := Bs.topE hB
  refine continuous_def.2 fun W hW => ?_
  change Bs.base.U.NatOpen _
  intro z hz
  obtain ⟨α, rfl, _, Ψe, hΨe, rfl⟩ := hB z
  obtain ⟨o, ho⟩ := Bs.U.isAt α Ψe hΨe
  have hz' : Continuous (fiberZero (Bs.U.str Ψe ⟨α, hΨe⟩).p) :=
    continuousOn_univ.1 (Bs.U.str Ψe ⟨α, hΨe⟩).B.isScSmoothSection_fiberZero.2.continuousOn
  have hc := (Bs.toE.continuous_π_obj (Bs.hBE hB) (Bs.U.mem_toE hΨe ho)).comp hz'
  refine ⟨α, rfl, _, ⟨Ψe, hΨe, rfl⟩, o, ho, _, hW.preimage hc, ?_, ?_⟩
  · change μ.cat.π (Ψe.obj (fiberZero (Bs.U.str Ψe ⟨α, hΨe⟩).p o)) ∈ W
    rw [StrongBundleStr.obj_fiberZero, ho]
    exact hz
  · rintro _ ⟨q, hq, rfl⟩
    change μ.cat.π (μ.zero ((Bs.U.str Ψe ⟨α, hΨe⟩).toBase.obj q)) ∈ W
    rw [← StrongBundleStr.obj_fiberZero]
    exact hq

/-- Copy of the project's `isEmbedding_zeroOrbit`. -/
theorem isEmbedding_zeroOrbit' (Bs : C.BasicStrongBundleConstruction μ)
    (hB : Bs.base.U.HasClassUniformizers) :
    @IsEmbedding _ _ (Bs.topS hB) (Bs.topE hB) μ.zeroOrbit := by
  let _i₁ := Bs.topS hB
  let _i₂ := Bs.topE hB
  exact Function.LeftInverse.isEmbedding (f := μ.orbitProj) μ.orbitProj_zeroOrbit
    (Bs.theorem_19_6_8_five hB) (continuous_zeroOrbit' Bs hB)

theorem B_to_A : B → A := fun h =>
  ⟨main_B_to_A h, fun Bs hB => continuous_zeroOrbit' Bs hB,
    fun Bs hB => isEmbedding_zeroOrbit' Bs hB⟩

#rt_check RoundTrip.V19_57.main_A_to_B [Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.proposition_19_6_9,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.continuous_zeroOrbit,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.isEmbedding_zeroOrbit]
#rt_check RoundTrip.V19_57.A_to_B [Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.proposition_19_6_9,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.continuous_zeroOrbit,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.isEmbedding_zeroOrbit]
#rt_check RoundTrip.V19_57.main_B_to_A [Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.proposition_19_6_9,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.continuous_zeroOrbit,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.isEmbedding_zeroOrbit]
#rt_check RoundTrip.V19_57.B_to_A [Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.proposition_19_6_9,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.continuous_zeroOrbit,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.isEmbedding_zeroOrbit]
#rt_overlap RoundTrip.V19_57.B_to_A [Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.proposition_19_6_9,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.continuous_zeroOrbit,
  Polyfold.GroupoidalCategory.BasicStrongBundleConstruction.isEmbedding_zeroOrbit]

end RoundTrip.V19_57
