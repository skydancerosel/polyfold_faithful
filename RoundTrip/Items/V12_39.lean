/-- `B`'s first conjunct ((1a), (1b), (2)) from five conjuncts of `A`. -/
theorem part1
    (h27 : type_of% @Polyfold.SBLocalization.GenSBMap.theorem_12_5_7_cls.{0})
    (h33 : type_of% @Polyfold.SBLocalization.GenSBMap.theorem_12_5_7_one_homeo_cls.{0})
