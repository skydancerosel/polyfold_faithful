/-! ### `G\O` two ways -/

/-- Mathlib's `G\O` is the orbit space of the translation groupoid `G ⋉ O`. -/
def orbH (G O : Type) [Group G] [MulAction G O] [TopologicalSpace O] :
    MulAction.orbitRel.Quotient G O ≃ₜ (GroupoidStr.translation G O).OrbitSpace where
  toFun := Quotient.lift (fun x => (GroupoidStr.translation G O).π x) fun x y h => by
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.1 (MulAction.orbitRel_apply.1 h)
    exact ((GroupoidStr.translation G O).π_eq_π_iff.2 ⟨(g, y), rfl, hg⟩).symm
  invFun := Quotient.lift (fun x => (Quotient.mk _ x : MulAction.orbitRel.Quotient G O))
    fun x y h => by
      obtain ⟨p, hx, hy⟩ := h
      refine Quotient.sound (MulAction.orbitRel_apply.2 (MulAction.mem_orbit_iff.2 ⟨p.1⁻¹, ?_⟩))
      change p.1 • p.2 = y at hy
      change p.2 = x at hx
      rw [← hy, ← hx, inv_smul_smul]
  left_inv z := Quotient.inductionOn z fun _ => rfl
  right_inv z := Quotient.inductionOn z fun _ => rfl
  continuous_toFun := continuous_quot_mk.quotient_lift _
  continuous_invFun := continuous_quot_mk.quotient_lift _

/-! ### `B`'s body for a given topology -/

/-- The body of `B` for a topology `τ` on `|S|`. -/
def Body {C : GroupoidalCategory.{0}} (Bc : C.BasicConstruction)
    (τ : TopologicalSpace C.OrbitSpace) : Prop :=
  let _ := τ
  (∀ W : Set C.OrbitSpace, IsOpen W ↔ natOpen Bc.U W) ∧
  (∀ (α : C.Obj), ∀ Ψ ∈ Bc.U.F α, ∀ V : Set Ψ.O, IsOpen V →
    IsOpen ((fun q => C.π (Ψ.obj q)) '' V)) ∧
  (∀ (α : C.Obj), ∀ Ψ ∈ Bc.U.F α,
    ∃ e : MulAction.orbitRel.Quotient Ψ.G Ψ.O → C.OrbitSpace,
      (∀ q : Ψ.O, e (Quotient.mk _ q) = C.π (Ψ.obj q)) ∧
      Topology.IsOpenEmbedding e ∧ C.π α ∈ Set.range e) ∧
  FirstCountableTopology C.OrbitSpace ∧
  (∀ z : C.OrbitSpace, ∃ W : Set C.OrbitSpace, IsOpen W ∧ z ∈ W ∧
    TopologicalSpace.MetrizableSpace W)

theorem B_iff : B ↔ ∀ (C : GroupoidalCategory.{0}) (Bc : C.BasicConstruction),
    Bc.U.HasClassUniformizers →
      Body Bc (TopologicalSpace.generateFrom {W | natOpen Bc.U W}) := Iff.rfl

/-- The topology with open sets `T`, from the axioms. -/
abbrev τA {C : GroupoidalCategory.{0}} (Bc : C.BasicConstruction)
    (h : Bc.U.NatOpen Set.univ ∧ (∀ W₁ W₂, Bc.U.NatOpen W₁ → Bc.U.NatOpen W₂ →
      Bc.U.NatOpen (W₁ ∩ W₂)) ∧ ∀ S : Set (Set C.OrbitSpace), (∀ W ∈ S, Bc.U.NatOpen W) →
        Bc.U.NatOpen (⋃₀ S)) : TopologicalSpace C.OrbitSpace where
  IsOpen := Bc.U.NatOpen
  isOpen_univ := h.1
  isOpen_inter := h.2.1
  isOpen_sUnion := h.2.2

/-! ### The main conjuncts alone

The text's claim is `theorem_19_2_2_one` … `_five` jointly (no single conjunct); we compare `B`
with these five (dropping `continuous_π_obj` and the `F ≡ ∅` example). -/

def Amain : Prop :=
  (type_of% @Polyfold.GroupoidalCategory.BasicConstruction.theorem_19_2_2_one.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicConstruction.theorem_19_2_2_two.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicConstruction.theorem_19_2_2_three.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicConstruction.theorem_19_2_2_four.{0}) ∧
  (type_of% @Polyfold.GroupoidalCategory.BasicConstruction.theorem_19_2_2_five.{0})

theorem main_to_B : Amain → B := by
  rintro ⟨hone, htwo, hthree, hfour, hfive⟩
  refine B_iff.2 fun C Bc hB => ?_
  let τ := τA Bc (@hone C Bc hB)
  have heq : TopologicalSpace.generateFrom {W | natOpen Bc.U W} = τ :=
    TopologicalSpace.generateFrom_setOfPred_isOpen τ
  rw [heq]
  let _ := τ
  refine ⟨fun W => Iff.rfl, fun α Ψ hΨ V hV => @htwo C Bc hB α Ψ hΨ V hV, fun α Ψ hΨ => ?_,
    @hfour C Bc hB, @hfive C Bc hB⟩
  obtain ⟨he, hα⟩ := @hthree C Bc hB α Ψ hΨ
  refine ⟨Ψ.functor.orbitMap ∘ orbH Ψ.G Ψ.O, fun q => rfl,
    he.comp (orbH Ψ.G Ψ.O).isOpenEmbedding, ?_⟩
  rw [Set.range_comp, (orbH Ψ.G Ψ.O).range_coe, Set.image_univ]
  exact hα

theorem A_to_B : A → B := fun ⟨h1, h2, h3, h4, h5, _⟩ => main_to_B ⟨h1, h2, h3, h4, h5⟩

/-- From `B`: the generated topology is `natTop`. -/
theorem gen_eq_natTop {C : GroupoidalCategory.{0}} (Bc : C.BasicConstruction)
    (hB : Bc.U.HasClassUniformizers)
    (h1 : ∀ W : Set C.OrbitSpace,
      IsOpen[TopologicalSpace.generateFrom {W | natOpen Bc.U W}] W ↔ natOpen Bc.U W) :
    TopologicalSpace.generateFrom {W | natOpen Bc.U W} = Bc.natTop hB :=
  TopologicalSpace.ext (funext fun W => propext (h1 W))

theorem B_to_A : B → A := by
  intro hB'
  have hB := B_iff.1 hB'
  -- `B` at `natTop`
  have hN : ∀ {C : GroupoidalCategory.{0}} (Bc : C.BasicConstruction)
      (hc : Bc.U.HasClassUniformizers), Body Bc (Bc.natTop hc) := by
    intro C Bc hc
    have h := hB C Bc hc
    rw [gen_eq_natTop Bc hc h.1] at h
    exact h
  -- (3) in the project's form
  have h3 : ∀ {C : GroupoidalCategory.{0}} (Bc : C.BasicConstruction)
      (hc : Bc.U.HasClassUniformizers) {α : C.Obj} {Ψ : C.Uniformizer} (hΨ : Ψ ∈ Bc.U.F α),
      @Topology.IsOpenEmbedding _ _ _ (Bc.natTop hc) Ψ.functor.orbitMap ∧
        C.π α ∈ Set.range Ψ.functor.orbitMap := by
    intro C Bc hc α Ψ hΨ
    let _ := Bc.natTop hc
    obtain ⟨e, he, hemb, hα⟩ := (hN Bc hc).2.2.1 α Ψ hΨ
    have hfe : Ψ.functor.orbitMap = e ∘ (orbH Ψ.G Ψ.O).symm := by
      funext z
      induction z using Quotient.inductionOn with
      | h q => exact (he q).symm
    rw [hfe]
    refine ⟨hemb.comp (orbH Ψ.G Ψ.O).symm.isOpenEmbedding, ?_⟩
    rw [Set.range_comp, (orbH Ψ.G Ψ.O).symm.range_coe, Set.image_univ]
    exact hα
  refine ⟨fun {C} Bc hc => ?_, fun {C} Bc hc α Ψ hΨ V hV => (hN Bc hc).2.1 α Ψ hΨ V hV,
    fun {C} Bc hc α Ψ hΨ => h3 Bc hc hΨ, fun {C} Bc hc => (hN Bc hc).2.2.2.1,
    fun {C} Bc hc => (hN Bc hc).2.2.2.2, fun {C} Bc hc α Ψ hΨ => ?_, ?_, ?_⟩
  · -- (1): the axioms of `T`, from `B`'s (1)
    have h1 := (hB C Bc hc).1
    let _ := TopologicalSpace.generateFrom {W | natOpen Bc.U W}
    exact ⟨(h1 _).1 isOpen_univ, fun W₁ W₂ a b => (h1 _).1 (((h1 _).2 a).inter ((h1 _).2 b)),
      fun S hS => (h1 _).1 (isOpen_sUnion fun W hW => (h1 _).2 (hS W hW))⟩
  · -- `q ↦ |Ψ(q)|` is continuous: `e ∘ [·]`
    let _ := Bc.natTop hc
    obtain ⟨e, he, hemb, -⟩ := (hN Bc hc).2.2.1 α Ψ hΨ
    have : (fun q : Ψ.O => C.π (Ψ.obj q)) = e ∘ Quotient.mk _ := funext fun q => (he q).symm
    rw [this]
    exact hemb.continuous.comp continuous_quot_mk
  · -- the example `F ≡ ∅` (outside `B`'s hypothesis), re-proved outright
    intro h
    obtain ⟨τ, hτ⟩ := h _ emptyBasic
    have hu := (hτ Set.univ).1 (@isOpen_univ _ τ)
    obtain ⟨_, _, Ψ, hΨ, -⟩ := hu ((GroupoidalCategory.translation ℤˣ (Fin 1 → ℝ)).π 0)
      (Set.mem_univ _)
    exact hΨ
  · intro W
    refine ⟨fun h => Set.eq_empty_iff_forall_notMem.2 fun z hz => ?_,
      fun h => h ▸ emptyBasic.U.natOpen_empty⟩
    obtain ⟨_, _, Ψ, hΨ, -⟩ := h z hz
    exact hΨ

theorem B_to_main : B → Amain := fun h =>
  let ⟨h1, h2, h3, h4, h5, _⟩ := B_to_A h
  ⟨h1, h2, h3, h4, h5⟩

