import Polyfold
/-! Blind formalization of V5_3 (the text's §5.1, Definition 5.1, p. 169).

Text: an auxiliary norm is a continuous `N : Y_{0,1} → ℝ` such that (1) its restriction to a fibre
is a complete norm; (2) if `P(w_k) → x` and `N(w_k) → 0`, then `w_k → 0_x` in `Y_{0,1}`.

Choices:
- This item is a definition.  B says that the project's `Bd.IsAuxNorm N` (Definition 5.1) is the
  text's notion `IsAuxNormB Bd N` written below.
- Setting: `X Y : Type` (universe 0, as asked); `PX : MPolyfold X`, `P : Y → X` with the
  fibrewise linear structure as instances on the fibres, `Bd : StrongBundle PX P` (Definition
  2.51), as in `RoundTrip/Blind/V5_10.lean`.  No tameness (the definition has none).
- `Y_{0,1}`: the project's type `Bd.One` (checked with `#print`: the subtype of the `y ∈ Y` whose
  fibre component lies in the range of `F₁ → F₀` in every chart of the atlas around `y`), since
  `IsAuxNorm` is a predicate on maps `Bd.One → ℝ`.
- The TOPOLOGY of `Y_{0,1}`: I did not rely on the instance the project puts on `Bd.One` (its
  definition is not in the vocabulary).  `oneTopology` below is the text's topology of `Y_{0,1}`
  (the one of the M-polyfold `Y[1]`): generated by the sets `{w ∈ P⁻¹(V) ∩ Y_{0,1} | Φ(w) ∈ W}`,
  `Φ` a strong bundle chart of the atlas, `W` open in `E₀ ⊕ F₁`, `Φ(w)` read in `E₀ ⊕ F₁` (fibre
  component lifted to `F₁`; junk off `Y_{0,1}`, never used).  Continuity of `N` and the
  convergence `w_k → 0_x` are taken in this topology.  `P(w_k) → x` is in `X = X₀`.
- The fibre `(Y_{0,1})_x = P⁻¹(x) ∩ Y_{0,1}` with its linear structure: the project's
  `Bd.oneFiber x` (checked: the submodule `{v ∈ P⁻¹(x) | v ∈ Y_{0,1}}`), and `Bd.toOne` (checked:
  the inclusion into `Y_{0,1}`); `0_x = Bd.toOne 0`.
- "its restriction to a fibre is a complete norm": `n(v) = N(v)` on `(Y_{0,1})_x` is a norm
  (`n(v) = 0 → v = 0`, `n(tv) = |t| n(v)`, triangle inequality; non-negativity and `n(0) = 0`
  follow) and every `n`-Cauchy sequence `n`-converges to some point of the fibre.  For EVERY
  `x ∈ X`.
- (2) for every sequence `w : ℕ → Y_{0,1}` and every `x ∈ X`.
- Nothing looks false to me.
-/
namespace RoundTrip.V5_3
open Polyfold Filter Topology

section
variable {X : Type} [TopologicalSpace X] [T2Space X] [ParacompactSpace X] {PX : MPolyfold X}
  {Y : Type} [TopologicalSpace Y] [T2Space Y] [ParacompactSpace Y] {P : Y → X}
  [∀ x, AddCommGroup (P ⁻¹' {x})] [∀ x, Module ℝ (P ⁻¹' {x})]

/-- `Φ(y)` read in `E₀ ⊕ F₁` (the fibre component lifted along the injection `F₁ → F₀`). -/
noncomputable def chartOne (c : StrongBundleChart PX P) (y : Y) :
    c.φ.model.E.lvl 0 × c.F.lvl 1 :=
  ((c.toPartialEquiv y).1, Function.invFun (c.F.toBase 1) (c.toPartialEquiv y).2)

/-- The topology of `Y_{0,1}` (that of the M-polyfold `Y[1]`): generated by the preimages of open
subsets of `E₀ ⊕ F₁` under the charts `Φ` of the atlas, restricted to their domains. -/
@[instance_reducible] def oneTopology (Bd : StrongBundle PX P) : TopologicalSpace Bd.One :=
  TopologicalSpace.generateFrom
    {S | ∃ c ∈ Bd.atlas.charts, ∃ W : Set (c.φ.model.E.lvl 0 × c.F.lvl 1), IsOpen W ∧
      S = {w : Bd.One | Bd.oneVal w ∈ c.toPartialEquiv.source ∧ chartOne c (Bd.oneVal w) ∈ W}}

/-- Definition 5.1 (1) at `x`: `N` restricted to the fibre `(Y_{0,1})_x` is a complete norm. -/
def IsCompleteNormOnFiberB (Bd : StrongBundle PX P) (N : Bd.One → ℝ) (x : X) : Prop :=
  (∀ v : Bd.oneFiber x, N (Bd.toOne v) = 0 → v = 0) ∧
  (∀ (t : ℝ) (v : Bd.oneFiber x), N (Bd.toOne (t • v)) = |t| * N (Bd.toOne v)) ∧
  (∀ v w : Bd.oneFiber x, N (Bd.toOne (v + w)) ≤ N (Bd.toOne v) + N (Bd.toOne w)) ∧
  (∀ u : ℕ → Bd.oneFiber x,
    (∀ ε > 0, ∃ K : ℕ, ∀ m ≥ K, ∀ k ≥ K, N (Bd.toOne (u m - u k)) < ε) →
      ∃ v : Bd.oneFiber x, Tendsto (fun k => N (Bd.toOne (u k - v))) atTop (𝓝 0))

/-- **Definition 5.1**: `N : Y_{0,1} → ℝ` is an auxiliary norm. -/
def IsAuxNormB (Bd : StrongBundle PX P) (N : Bd.One → ℝ) : Prop :=
  @Continuous Bd.One ℝ (oneTopology Bd) _ N ∧
  (∀ x : X, IsCompleteNormOnFiberB Bd N x) ∧
  (∀ (w : ℕ → Bd.One) (x : X),
    Tendsto (fun k => P (Bd.oneVal (w k))) atTop (𝓝 x) →
    Tendsto (fun k => N (w k)) atTop (𝓝 0) →
    @Tendsto ℕ Bd.One w atTop (@nhds Bd.One (oneTopology Bd) (Bd.toOne (0 : Bd.oneFiber x))))

end

/-- Definition 5.1: the project's auxiliary norms are the text's. -/
def B : Prop :=
  ∀ {X : Type} [TopologicalSpace X] [T2Space X] [ParacompactSpace X] (PX : MPolyfold X)
    {Y : Type} [TopologicalSpace Y] [T2Space Y] [ParacompactSpace Y] (P : Y → X)
    [∀ x, AddCommGroup (P ⁻¹' {x})] [∀ x, Module ℝ (P ⁻¹' {x})]
    (Bd : StrongBundle PX P) (N : Bd.One → ℝ),
    Bd.IsAuxNorm N ↔ IsAuxNormB Bd N

end RoundTrip.V5_3
