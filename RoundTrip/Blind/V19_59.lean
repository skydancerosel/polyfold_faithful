import Polyfold
/-! Blind formalization of V19_59 (the text's §19.6, Theorem 19.6.11, p. 898 of the Springer 2021
book; 2017: Theorem 19.7).

Text: `T̄_{Ψ̄,Ψ̄'}` is a locally metrizable regular Hausdorff topology; `s`, `t` local
homeomorphisms, `u` and the multiplication continuous, `ι` a homeomorphism, and the map to
`M(Ψ, Ψ')` continuous.

Choices:
- Setting: universe `0`: a groupoidal category `C`, a functor `μ : S → Ban` (`C.BanFunctor`), a
  strong bundle uniformizer construction `F̄` (`StrongBundleUniformizerConstruction μ`, Definition
  19.6.3) and arbitrary bundle transition data `F̄` for it (`Fb.BundleTransitionData`, Definition
  19.6.4); its underlying transition data `F = Fbar.toTD` (p. 896).  Stating the theorem for all
  bundle transition data covers every representative of every strong bundle transition
  construction, hence every basic strong bundle construction (Definition 19.6.10 defines
  `T̄_{Ψ̄,Ψ̄'}` through "the representative `F̄`").  No metrizability is assumed (none is quoted).
- `Ψ̄, Ψ̄', Ψ̄''` range over the members of `F̄` (`Fb.Unif`); `M(Ψ̄, Ψ̄')` is the transition set of
  the uniformizers `Ψ̄ : G ⋉ K → E_μ`; `K` carries the topology of its M-polyfold structure.
- `T̄_{Ψ̄,Ψ̄'}` (Definition 19.6.10) written out as `openTr`, copied from the vocabulary's
  `BarOpenTr` but for an arbitrary `F̄` instead of the project's chosen `B.rep`: `Ŵ` is open if
  every `h̄ ∈ Ŵ` has an open `V̂ ∋ s(h̄)` in `K` with `V̂ ⊂ p⁻¹(V(p(s(h̄))))`, i.e. inside
  `K|V(o)` for the domain `V(o)` of `F_{p(h̄)}`, and `F̄_{p(h̄)}(V̂) ⊂ Ŵ` (`F̄_h` = the vocabulary's
  `mapBar`, the lift of p. 894; `p(h̄)` = the vocabulary's `StrongBundleStr.proj`, p. 892).
  `MT Fbar Ψ Ψ'` is `M(Ψ̄, Ψ̄')` with the topology generated by this collection; "is a topology"
  is encoded as: the open sets of that topology are exactly the members of the collection.
- "locally metrizable" = every point has an open neighbourhood metrizable in the subspace
  topology; "regular" = `RegularSpace`, "Hausdorff" = `T2Space`.
- Structure maps: `s(a, φ, a') = a`, `t(a, φ, a') = a'`, `u(a) = (a, 1, a)`,
  `ι(a, φ, a') = (a', φ⁻¹, a)` (`GroupoidStr.TransitionSet.src`, `tgt`, `unit`, `inv`), and the
  multiplication `m((a', φ', a''), (a, φ, a')) = (a, φ' ∘ φ, a'')` (`TransitionSet.comp`) on the
  fibred product `M(Ψ̄', Ψ̄'') ₛ×ₜ M(Ψ̄, Ψ̄')` with the subspace topology of the product.
  "local homeomorphism" = `IsLocalHomeomorph`; "`ι` a homeomorphism" = a `≃ₜ` whose underlying
  map is `ι`.
- "the map to `M(Ψ, Ψ')`" = `p : M(Ψ̄, Ψ̄') → M(Ψ, Ψ')`, `p(a, φ, a') = (p(a), φ, p'(a'))`
  ((19.13); `StrongBundleStr.proj`), with `M(Ψ, Ψ')` carrying `T_{Ψ,Ψ'}` = the topology
  `T^F_{Ψ,Ψ'}` of the underlying transition data `F` (vocabulary `TransitionData.Tr`, Lemma
  19.3.1).
- Nothing looks doubtful to me.
-/
namespace RoundTrip.V19_59
open Polyfold

/-- The collection `T̄_{Ψ̄,Ψ̄'}` of Definition 19.6.10 for the bundle transition data `F̄`. -/
def openTr {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}
    {Fb : GroupoidalCategory.StrongBundleUniformizerConstruction μ}
    (Fbar : Fb.BundleTransitionData) (Ψ Ψ' : Fb.Unif)
    (W : Set ((Ψ : μ.cat.Uniformizer).Trans Ψ')) : Prop :=
  ∀ h ∈ W, ∃ V : Set (Ψ : μ.cat.Uniformizer).O, IsOpen V ∧ h.src ∈ V ∧
    V ⊆ (Fb.strU Ψ).p ⁻¹'
      Fbar.toTD.dom (Fb.baseUnif Ψ) (Fb.baseUnif Ψ') ((Fb.strU Ψ).proj (Fb.strU Ψ') h) ∧
    Fb.mapBar Fbar.toTD Ψ Ψ' ((Fb.strU Ψ).proj (Fb.strU Ψ') h) '' V ⊆ W

/-- `M(Ψ̄, Ψ̄')` with the topology generated by `T̄_{Ψ̄,Ψ̄'}`. -/
def MT {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}
    {Fb : GroupoidalCategory.StrongBundleUniformizerConstruction μ}
    (_Fbar : Fb.BundleTransitionData) (Ψ Ψ' : Fb.Unif) : Type :=
  (Ψ : μ.cat.Uniformizer).Trans Ψ'

instance {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}
    {Fb : GroupoidalCategory.StrongBundleUniformizerConstruction μ}
    (Fbar : Fb.BundleTransitionData) (Ψ Ψ' : Fb.Unif) : TopologicalSpace (MT Fbar Ψ Ψ') :=
  TopologicalSpace.generateFrom {W | openTr Fbar Ψ Ψ' W}

/-- The unit map `u : K → M(Ψ̄, Ψ̄)`, `a ↦ (a, 1, a)`. -/
noncomputable def uMap {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}
    {Fb : GroupoidalCategory.StrongBundleUniformizerConstruction μ}
    (Fbar : Fb.BundleTransitionData) (Ψ : Fb.Unif) :
    (Ψ : μ.cat.Uniformizer).O → MT Fbar Ψ Ψ :=
  fun a => GroupoidStr.TransitionSet.unit a

/-- The fibred product `M(Ψ̄', Ψ̄'') ₛ×ₜ M(Ψ̄, Ψ̄')` (subspace of the product). -/
def FP {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}
    {Fb : GroupoidalCategory.StrongBundleUniformizerConstruction μ}
    (Fbar : Fb.BundleTransitionData) (Ψ Ψ' Ψ'' : Fb.Unif) : Type :=
  {q : MT Fbar Ψ' Ψ'' × MT Fbar Ψ Ψ' //
    GroupoidStr.TransitionSet.src (q.1 : (Ψ' : μ.cat.Uniformizer).Trans Ψ'') =
      GroupoidStr.TransitionSet.tgt (q.2 : (Ψ : μ.cat.Uniformizer).Trans Ψ')}

instance {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}
    {Fb : GroupoidalCategory.StrongBundleUniformizerConstruction μ}
    (Fbar : Fb.BundleTransitionData) (Ψ Ψ' Ψ'' : Fb.Unif) : TopologicalSpace (FP Fbar Ψ Ψ' Ψ'') :=
  instTopologicalSpaceSubtype

/-- The multiplication `m((a', φ', a''), (a, φ, a')) = (a, φ' ∘ φ, a'')`. -/
noncomputable def mMap {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}
    {Fb : GroupoidalCategory.StrongBundleUniformizerConstruction μ}
    (Fbar : Fb.BundleTransitionData) (Ψ Ψ' Ψ'' : Fb.Unif) :
    FP Fbar Ψ Ψ' Ψ'' → MT Fbar Ψ Ψ'' :=
  fun q => GroupoidStr.TransitionSet.comp
    (q.1.1 : (Ψ' : μ.cat.Uniformizer).Trans Ψ'')
    (q.1.2 : (Ψ : μ.cat.Uniformizer).Trans Ψ')
    (by rw [q.1.1.src_mor, q.1.2.tgt_mor, q.2])

/-- `p : M(Ψ̄, Ψ̄') → M(Ψ, Ψ')`, `(a, φ, a') ↦ (p(a), φ, p'(a'))`. -/
noncomputable def pMap {C : GroupoidalCategory.{0}} {μ : C.BanFunctor}
    {Fb : GroupoidalCategory.StrongBundleUniformizerConstruction μ}
    (Fbar : Fb.BundleTransitionData) (Ψ Ψ' : Fb.Unif) :
    MT Fbar Ψ Ψ' → Fbar.toTD.Tr (Fb.baseUnif Ψ) (Fb.baseUnif Ψ') :=
  fun h => (Fb.strU Ψ).proj (Fb.strU Ψ') (h : (Ψ : μ.cat.Uniformizer).Trans Ψ')

/-- Theorem 19.6.11: the topology `T̄_{Ψ̄,Ψ̄'}` and the structure maps of `M(Ψ̄, Ψ̄')`. -/
def B : Prop :=
  ∀ (C : GroupoidalCategory.{0}) (μ : C.BanFunctor)
    (Fb : GroupoidalCategory.StrongBundleUniformizerConstruction μ)
    (Fbar : Fb.BundleTransitionData),
    -- `T̄_{Ψ̄,Ψ̄'}` is a topology, regular, Hausdorff and locally metrizable
    (∀ Ψ Ψ' : Fb.Unif,
      (∀ W : Set (MT Fbar Ψ Ψ'), IsOpen W ↔ openTr Fbar Ψ Ψ' W) ∧
      RegularSpace (MT Fbar Ψ Ψ') ∧ T2Space (MT Fbar Ψ Ψ') ∧
      ∀ h : MT Fbar Ψ Ψ', ∃ W : Set (MT Fbar Ψ Ψ'), IsOpen W ∧ h ∈ W ∧
        TopologicalSpace.MetrizableSpace W) ∧
    -- `s` and `t` are local homeomorphisms
    (∀ Ψ Ψ' : Fb.Unif,
      IsLocalHomeomorph (fun h : MT Fbar Ψ Ψ' =>
        (GroupoidStr.TransitionSet.src (h : (Ψ : μ.cat.Uniformizer).Trans Ψ') :
          (Ψ : μ.cat.Uniformizer).O)) ∧
      IsLocalHomeomorph (fun h : MT Fbar Ψ Ψ' =>
        (GroupoidStr.TransitionSet.tgt (h : (Ψ : μ.cat.Uniformizer).Trans Ψ') :
          (Ψ' : μ.cat.Uniformizer).O))) ∧
    -- `u` is continuous
    (∀ Ψ : Fb.Unif, Continuous (uMap Fbar Ψ)) ∧
    -- the multiplication is continuous on the fibred product
    (∀ Ψ Ψ' Ψ'' : Fb.Unif, Continuous (mMap Fbar Ψ Ψ' Ψ'')) ∧
    -- `ι` is a homeomorphism
    (∀ Ψ Ψ' : Fb.Unif, ∃ e : MT Fbar Ψ Ψ' ≃ₜ MT Fbar Ψ' Ψ,
      ∀ h : (Ψ : μ.cat.Uniformizer).Trans Ψ',
        e h = (GroupoidStr.TransitionSet.inv h : (Ψ' : μ.cat.Uniformizer).Trans Ψ)) ∧
    -- `p : M(Ψ̄, Ψ̄') → M(Ψ, Ψ')` is continuous
    (∀ Ψ Ψ' : Fb.Unif, Continuous (pMap Fbar Ψ Ψ'))

end RoundTrip.V19_59
