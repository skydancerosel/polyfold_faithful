import Polyfold
/-! Blind formalization of V10_52 (the text's Part II, §10.5, `[d]` and `|[D]|`, p. 504 of the
Springer 2021 book; 2017 pp. 364–365).

Text: a diagram `D` covers a diagram `d` of the underlying ep-groupoids, so `[D]` covers
`[d] : X → X'`; `|[D]| = |Ψ| ∘ |Φ|⁻¹ : |W| → |W'|` does not depend on the representative.

Choices:
- Setting: universe 0, strong bundles over ep-groupoids the project's `SEP.{0}`, diagrams
  `D : W ←Φ W'' →Ψ W'` the project's `SDiagram A A'` (a strong bundle equivalence `Φ`, a strong
  bundle functor `Ψ`, morphisms of `SEP`: pairs `(ϕ, Φ)` of the functor `ϕ` of the bases and the
  functor `Φ` of the total ep-groupoids `(W, 𝐖)`), generalized strong bundle maps the project's
  `GenSBMap A A'` with `[D] = SDiagram.cls D` (V10_51 compares these with the text).
- "the diagram `d` covered by `D`" (`baseDiagB`, mine): `X ←φ X'' →ψ X'`, `φ`, `ψ` the base functors
  of `Φ`, `Ψ`; `φ` is an equivalence by the definition of a strong bundle equivalence (the
  project's field `isEquivalence_base`).  It is a diagram of the project's `EPLocalization.Diagram`
  (2021 p. 483), its class `[d]` the morphism `EPLoc.homMk d` of `EP(E⁻¹)`.
- "`[D]` covers `[d]`" (conjuncts (a), (b)): `[d]` depends only on `[D]` (for diagrams with a
  common refinement the classes `[d]` agree; the classes of the project are generated by that
  relation, so this is the well-definedness), and the project's `GenSBMap.base` (its "[D] covers
  [d]") sends `[D]` to `[d]`.
- Orbit spaces `|W|` (conjuncts (c)–(e)): of the total ep-groupoid `(W, 𝐖)` (the project's
  `E.toEpGroupoid`), with the project's orbit projection `π` (`GroupoidStr.π`, the quotient by
  "there is a morphism").  `|Φ|`, `|Ψ|` are `|w''| ↦ |Φ(w'')|`, `|Ψ(w'')|`.
- "`|[D]| = |Ψ| ∘ |Φ|⁻¹`": (c) `|Φ| : |W''| → |W|` is a bijection (so `|Φ|⁻¹` exists), stated
  on representatives; (d) the project's `GenSBMap.orbitMap [D]` maps `|Φ(w'')|` to `|Ψ(w'')|`,
  which by (c) characterizes it as `|Ψ| ∘ |Φ|⁻¹`; (e) "does not depend on the representative":
  for equivalent `D`, `D'` (a common refinement), `|Ψ| ∘ |Φ|⁻¹ = |Ψ'| ∘ |Φ'|⁻¹`, stated on
  representatives: `|Φ(w₁)| = |Φ'(w₂)|` implies `|Ψ(w₁)| = |Ψ'(w₂)|`.
- Nothing looks false to me.
-/
namespace RoundTrip.V10_52
open Polyfold CategoryTheory

/-- The diagram `d : X ←φ X'' →ψ X'` of the base ep-groupoids covered by
`D : W ←Φ W'' →Ψ W'`. -/
def baseDiagB {A A' : SEP.{0}} (D : SBLocalization.SDiagram A A') :
    EPLocalization.Diagram A.baseEP A'.baseEP :=
  ⟨D.B.baseEP, D.Φ.ϕ,
    EpStrongBundle.IsStrongBundleEquivalence.isEquivalence_base D.isEquivalence_Φ, D.Ψ.ϕ⟩

/-- `[D]` covers the generalized map `[d]` of the bases, and `|[D]| = |Ψ| ∘ |Φ|⁻¹` is well
defined and independent of the representative. -/
def B : Prop :=
  ∀ A A' : SEP.{0},
    -- (a) `[d]` depends only on `[D]`
    (∀ D D' : SBLocalization.SDiagram A A', D.Equiv D' →
      EPLocalization.EPLoc.homMk (baseDiagB D) = EPLocalization.EPLoc.homMk (baseDiagB D')) ∧
    -- (b) the project's `[D] ↦ [d]`
    (∀ D : SBLocalization.SDiagram A A',
      D.cls.base = EPLocalization.EPLoc.homMk (baseDiagB D)) ∧
    -- (c) `|Φ| : |W''| → |W|` is a bijection
    (∀ D : SBLocalization.SDiagram A A',
      (∀ w : A.W, ∃ w'' : D.B.W, A.E.toEpGroupoid.π (D.Φ.Φ.obj w'') = A.E.toEpGroupoid.π w) ∧
      (∀ w₁ w₂ : D.B.W, A.E.toEpGroupoid.π (D.Φ.Φ.obj w₁) = A.E.toEpGroupoid.π (D.Φ.Φ.obj w₂) →
        D.B.E.toEpGroupoid.π w₁ = D.B.E.toEpGroupoid.π w₂)) ∧
    -- (d) `|[D]| ∘ |Φ| = |Ψ|`
    (∀ (D : SBLocalization.SDiagram A A') (w'' : D.B.W),
      D.cls.orbitMap (A.E.toEpGroupoid.π (D.Φ.Φ.obj w'')) =
        A'.E.toEpGroupoid.π (D.Ψ.Φ.obj w'')) ∧
    -- (e) `|Ψ| ∘ |Φ|⁻¹` does not depend on the representative
    (∀ D D' : SBLocalization.SDiagram A A', D.Equiv D' →
      ∀ (w₁ : D.B.W) (w₂ : D'.B.W),
        A.E.toEpGroupoid.π (D.Φ.Φ.obj w₁) = A.E.toEpGroupoid.π (D'.Φ.Φ.obj w₂) →
        A'.E.toEpGroupoid.π (D.Ψ.Φ.obj w₁) = A'.E.toEpGroupoid.π (D'.Ψ.Φ.obj w₂))

end RoundTrip.V10_52
