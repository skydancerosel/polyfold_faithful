import Polyfold
/-! Blind formalization of V8_46 (the 2021 book, Part II, §8.3, Definition 8.3.5, p. 379).

Text: an auxiliary norm for the strong bundle `(P : W → X, μ)` over the ep-groupoid `X` is a
continuous `N : W_{0,1} → [0, ∞)` which (1) restricts to a complete norm on every fibre,
(2) satisfies `h_k → 0_x` whenever `P(h_k) → x` and `N(h_k) → 0`, and (3) is invariant:
`N(h) = N(k)` if `h = μ(φ, k)`.

Choices:
- This item is a definition.  B says that the project's `EpStrongBundle.IsAuxNorm` is the text's
  notion `IsAuxNormB` written below.
- Setting: `Obj Mor : Type` (universe 0) with the instances of the project's `EpGroupoid`,
  `X : EpGroupoid Obj Mor`; `W : Type` with its topology (`T2`, paracompact), `P : W → Obj` with
  the linear structures on the fibres `P⁻¹(x)`, `B : StrongBundle X.PObj P` (Part I's strong
  bundle over the object M-polyfold) and `E : EpStrongBundle X B` (the structure map `μ`,
  2017 Definition 8.4, read with `#print`).  `W` is taken in the same universe as `Obj`.
- `W_{0,1}`: the project's `B.One` (the points of `W` whose fibre part lies on level `1`), with
  the project's topology on it (`B.instTopologicalSpaceOne`, generated by the level-`1` charts:
  the topology of `W[1]`, checked with `#synth`/`#print`).  "continuous" refers to it, and so does
  "`h_k → 0_x`" in (2).  `0_x` is the project's `B.zeroOne x` (the zero of the fibre over `x`, as
  a point of `W_{0,1}`).
- The values lie in `[0, ∞)`: `N : B.One → ℝ` with `0 ≤ N h` for all `h` (stated separately).
- (1) "a complete norm on every fibre": Part I's `B.IsCompleteFiberNorm N x` (Definition 5.1 (1)),
  read with `#print`: on the fibre `(W_{0,1})_x` (a submodule of `P⁻¹(x)`), `N v = 0 → v = 0`,
  `N(t v) = |t| N v`, `N(v + w) ≤ N v + N w`, and `N`-Cauchy sequences `N`-converge.
- (2): for every sequence `h : ℕ → W_{0,1}` and every `x`, `P(h_k) → x` in `X` and `N(h_k) → 0`
  imply `h_k → 0_x` in `W_{0,1}`.
- (3): for all `h, k ∈ W_{0,1}` and morphisms `φ` with `s(φ) = P(k)`, `h = μ(φ, k)` implies
  `N(h) = N(k)`.
- Nothing looks false to me.
-/
namespace RoundTrip.V8_46
open Polyfold Filter Topology

section
variable {Obj Mor : Type} [TopologicalSpace Obj] [T2Space Obj] [ParacompactSpace Obj]
  [TopologicalSpace Mor] [T2Space Mor] [ParacompactSpace Mor] {X : EpGroupoid Obj Mor}
  {W : Type} [TopologicalSpace W] [T2Space W] [ParacompactSpace W] {P : W → Obj}
  [∀ x, AddCommGroup (P ⁻¹' {x})] [∀ x, Module ℝ (P ⁻¹' {x})] {B : StrongBundle X.PObj P}

/-- **Definition 8.3.5**: an auxiliary norm for the strong bundle `(P, μ)` over `X`. -/
def IsAuxNormB (E : EpStrongBundle X B) (N : B.One → ℝ) : Prop :=
  Continuous N ∧
  (∀ h : B.One, 0 ≤ N h) ∧
  (∀ x : Obj, B.IsCompleteFiberNorm N x) ∧
  (∀ (h : ℕ → B.One) (x : Obj),
    Tendsto (fun k => P (B.oneVal (h k))) atTop (𝓝 x) →
    Tendsto (fun k => N (h k)) atTop (𝓝 0) →
    Tendsto h atTop (𝓝 (B.zeroOne x))) ∧
  (∀ (h k : B.One) (φ : Mor) (hk : P (B.oneVal k) = X.src φ),
    B.oneVal h = E.μ ⟨(φ, B.oneVal k), hk⟩ → N h = N k)

end

/-- Definition 8.3.5: the project's auxiliary norms of a strong bundle over an ep-groupoid are
the text's. -/
def B : Prop :=
  ∀ (Obj Mor : Type) [TopologicalSpace Obj] [T2Space Obj] [ParacompactSpace Obj]
    [TopologicalSpace Mor] [T2Space Mor] [ParacompactSpace Mor] (X : EpGroupoid Obj Mor)
    (W : Type) [TopologicalSpace W] [T2Space W] [ParacompactSpace W] (P : W → Obj)
    [∀ x, AddCommGroup (P ⁻¹' {x})] [∀ x, Module ℝ (P ⁻¹' {x})] (B : StrongBundle X.PObj P)
    (E : EpStrongBundle X B) (N : B.One → ℝ),
    E.IsAuxNorm N ↔ IsAuxNormB E N

end RoundTrip.V8_46
