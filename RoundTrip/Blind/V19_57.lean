import Polyfold
/-! Blind formalization of V19_57 (the text's §19.6, Proposition 19.6.9, p. 898 of the Springer
2021 book; 2017: Proposition 19.7).

Text: `T̄` is metrizable if and only if `T` is metrizable.

Choices:
- Setting: universe `0`: a groupoidal category `C : GroupoidalCategory.{0}` (the text's `S`), a
  functor `μ : S → Ban` (`C.BanFunctor`, §19.6; `E_μ` = `μ.cat`), and a basic strong bundle
  construction `Bs = (F̄, 𝓕̄)` (`C.BasicStrongBundleConstruction μ`, Definition 19.6.6) with
  underlying basic construction `(F, 𝓕)` = `Bs.base`.
- Hypothesis added: `Bs.base.U.HasClassUniformizers` (every class of `|S|` contains an object with
  a uniformizer of `F`), under which `T` and `T̄` are topologies; the text presupposes it.
- `T` on `|S|` = the vocabulary's `Bs.base.natTop hB` (open sets = `NatOpen`, Definition 19.2.1).
- `T̄` on `|E|` = the topology generated by the vocabulary's `Bs.BarOpen` (the collection of
  Definition 19.6.7 as printed; by Theorem 19.6.8 (1) its open sets are exactly that collection).
  I did not use the project's `topE`/`topS`.
- Metrizable = Mathlib's `TopologicalSpace.MetrizableSpace`.
- Nothing looks doubtful to me.
-/
namespace RoundTrip.V19_57
open Polyfold

/-- Proposition 19.6.9: `T̄` on `|E_μ|` is metrizable iff `T` on `|S|` is. -/
def B : Prop :=
  ∀ (C : GroupoidalCategory.{0}) (μ : C.BanFunctor) (Bs : C.BasicStrongBundleConstruction μ)
    (hB : Bs.base.U.HasClassUniformizers),
    @TopologicalSpace.MetrizableSpace μ.cat.OrbitSpace
        (TopologicalSpace.generateFrom {W | Bs.BarOpen W}) ↔
      @TopologicalSpace.MetrizableSpace C.OrbitSpace (Bs.base.natTop hB)

end RoundTrip.V19_57
