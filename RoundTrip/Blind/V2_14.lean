import Polyfold
/-! Blind formalization of V2_14 (the text's §2.2, the paragraph after Definition 2.14, p. 25).

Text: `x` is on level `m` if `φ(x) ∈ O_m` for a chart around `x` ("independent of the choice of a
chart"); `X_m` is the set of such points, topologized by the basis of sets `φ⁻¹(W)`, `W` open in
`O_m`; `X = X_0 ⊃ X_1 ⊃ ⋯ ⊃ X_∞ = ⋂ X_m`.

Choices:
- This item is a definition plus properties.  Setting: `X : Type` (spaces put in `Type`; the
  project's `MPolyfold` is universe-polymorphic, this is the instance `u = 0`) with
  `[TopologicalSpace X] [T2Space X] [ParacompactSpace X]` and an M-polyfold structure
  `P : MPolyfold X` (Definition 2.13; see my `RoundTrip/Blind/V2_13.lean`).  "Chart around `x`":
  an `MChart X` with `P.IsChart φ` (a chart of the maximal atlas, checked with `#print`) and
  `x ∈ φ.source`.
- `O_m = O ∩ E_m` is `E.lvlSet O m` (checked with `#print`: `ι_m⁻¹(O) ⊆ E_m`, `ι_m = E.toBase m`
  the composite inclusion `E_m → E₀`), and "`φ(x) ∈ O_m`" is "`φ(x) = ι_m z` for some
  `z ∈ O_m`".  `levelSetB P m` is the set of points on level `m` (existential in the chart);
  "independent of the choice of a chart" is the property: for `x ∈ X_m` EVERY chart around `x`
  has `φ(x) ∈ O_m`.
- "`W` open in `O_m`": `W = W' ∩ O_m` with `W'` open in `E_m`; the basis set is
  `φ⁻¹(W) = {x ∈ V | φ(x) = ι_m z, z ∈ W' ∩ O_m}` (`levelBasisB`), over all charts `φ` of the
  structure.  These are subsets of `X_m`; on the type `X_m` I use their traces
  (`Subtype.val ⁻¹'`).  "Topologized by the basis": the project's topology `P.levelTopology m` on
  its `X_m` (`↥(P.levelSet m)`) is the one generated by the family, AND the family is a basis of
  it (`IsTopologicalBasis`); the latter is part of the text's claim ("the basis").
- "`X = X_0 ⊃ X_1 ⊃ ⋯ ⊃ X_∞ = ⋂ X_m`": as sets, `X_0 = X`, `X_{m+1} ⊆ X_m`, and the project's
  `X_∞` (`P.smoothSet`) is `⋂ X_m`.  I read "`X = X_0`" as an equality of sets (the topology of
  `X_0` coinciding with that of `X` is not asserted).
- B also asserts that the project's `P.levelSet m` is `levelSetB P m`.
- Nothing looks false to me.
-/
namespace RoundTrip.V2_14
open Polyfold

section
variable {X : Type} [TopologicalSpace X] [T2Space X] [ParacompactSpace X]

/-- `X_m`: the points `x` with `φ(x) ∈ O_m` for a chart `φ` around `x`. -/
def levelSetB (P : MPolyfold X) (m : ℕ) : Set X :=
  {x | ∃ φ : MChart X, P.IsChart φ ∧ x ∈ φ.source ∧
    ∃ z ∈ φ.model.E.lvlSet φ.model.O m, φ.model.E.toBase m z = φ.toPartialEquiv x}

/-- The family of the sets `φ⁻¹(W)`, `φ` a chart, `W = W' ∩ O_m` open in `O_m`. -/
def levelBasisB (P : MPolyfold X) (m : ℕ) : Set (Set X) :=
  {s | ∃ φ : MChart X, P.IsChart φ ∧ ∃ W' : Set (φ.model.E.lvl m), IsOpen W' ∧
    s = {x | x ∈ φ.source ∧
      ∃ z ∈ W' ∩ φ.model.E.lvlSet φ.model.O m, φ.model.E.toBase m z = φ.toPartialEquiv x}}

/-- The traces of the family `levelBasisB P m` on a subset `A ⊆ X`. -/
def levelBasisOn (P : MPolyfold X) (m : ℕ) (A : Set X) : Set (Set A) :=
  (fun s : Set X => (Subtype.val ⁻¹' s : Set A)) '' levelBasisB P m

end

/-- The filtration `X = X_0 ⊃ X_1 ⊃ ⋯ ⊃ X_∞ = ⋂ X_m` of an M-polyfold: the level sets (independent
of the chart) and their topologies, given by the basis of the sets `φ⁻¹(W)`. -/
def B : Prop :=
  ∀ (X : Type) [TopologicalSpace X] [T2Space X] [ParacompactSpace X] (P : MPolyfold X),
    -- the project's `X_m` is the text's
    (∀ m : ℕ, P.levelSet m = levelSetB P m) ∧
    -- independence of the chart
    (∀ (m : ℕ), ∀ x ∈ levelSetB P m, ∀ φ : MChart X, P.IsChart φ → x ∈ φ.source →
      ∃ z ∈ φ.model.E.lvlSet φ.model.O m, φ.model.E.toBase m z = φ.toPartialEquiv x) ∧
    -- the topology of `X_m` is generated by the family, which is a basis of it
    (∀ m : ℕ,
      P.levelTopology m = TopologicalSpace.generateFrom (levelBasisOn P m (P.levelSet m)) ∧
      @TopologicalSpace.IsTopologicalBasis _ (P.levelTopology m)
        (levelBasisOn P m (P.levelSet m))) ∧
    -- `X = X_0 ⊃ X_1 ⊃ ⋯ ⊃ X_∞ = ⋂ X_m`
    levelSetB P 0 = Set.univ ∧
    (∀ m : ℕ, levelSetB P (m + 1) ⊆ levelSetB P m) ∧
    P.smoothSet = ⋂ m : ℕ, levelSetB P m

end RoundTrip.V2_14
