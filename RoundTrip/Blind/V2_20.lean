import Polyfold
/-! Blind formalization of V2_20 (the text's §2.2, Proposition 2.19, p. 27; proof §2.6.3).

Text: (1) the family `𝓑` is a basis of a Hausdorff topology on `TX`.  (2) `p : TX → X_1` is
continuous and open.  (3) `TX` is metrizable, hence paracompact.

Choices:
- Setting: `X : Type` (spaces in `Type`; the project's `MPolyfold` is universe-polymorphic, this
  is `u = 0`; `TX` lives in `Type 1`) with `[TopologicalSpace X] [T2Space X] [ParacompactSpace X]`,
  `P : MPolyfold X` (Definition 2.13).  Charts: `MChart X` with `P.IsChart φ` (maximal atlas,
  checked with `#print`).
- `TX` is the project's `P.TangentSpace` (classes of the project's tuples `P.TangentPre`; my
  `RoundTrip/Blind/V2_18.lean` and `V2_19.lean` state these are the text's tuples and classes).
- `𝓑` (Definition 2.18) is my `TfamB P` (copied from `RoundTrip/Blind/V2_19.lean`): the sets
  `(Tφ)⁻¹(W) = {α ∈ TV | Tφ α ∈ W}`, `φ` a chart of `X`, `W` open in `TE₀ = E_1 × E_0`
  (equivalently `W ∩ TO` open in `TO`), with `TV` the classes over `V = dom φ` and
  `Tφ[(x, φ, h)] = (φ(x), h)` computed with a representative in the chart `φ` (`TφB`, chosen,
  junk `0` off `TV`).  I do not use the topology instance the project puts on `P.TangentSpace`:
  the topology here is `τB P = generateFrom 𝓑` (V2_19 asserts the project's instance is it).
- (1): `𝓑` is a topological basis of `τB P`, and `τB P` is Hausdorff.
- (2): `p` is the project's `P.tangentProj` (V2_19 asserts `p[(x, φ, h)] = x`); `X_1` carries the
  project's `P.levelTopology 1` (checked with `#print`; `RoundTrip/Blind/V2_14.lean` states it is
  the text's topology on `X_1`), passed explicitly.  `p` is continuous and an open map.
- (3): `τB P` is metrizable (`MetrizableSpace`) and paracompact (stated separately, as "hence").
- Nothing looks false to me.
-/
namespace RoundTrip.V2_20
open Polyfold

/-- `TE = E¹ ⊕ E`. -/
noncomputable abbrev TEB (E : ScBanach) : ScBanach := E.shift.prod E

section
variable {X : Type} [TopologicalSpace X] [T2Space X] [ParacompactSpace X]

/-- `TV`: the classes `[(x, ψ, h)]` with `x ∈ V`, `V` the domain of `φ`. -/
def TVB (P : MPolyfold X) (φ : MChart X) : Set P.TangentSpace :=
  {α | ∃ p : P.TangentPre, MPolyfold.TangentSpace.mk p = α ∧ p.x ∈ φ.source}

/-- The vector `(φ(x), h) ∈ TE₀` of a tuple `(x, φ, h)`, `φ(x)` seen in `E_1`. -/
noncomputable def vecB {P : MPolyfold X} (p : P.TangentPre) : (TEB p.φ.model.E).lvl 0 :=
  (Function.invFun (p.φ.model.E.toBase 1) (p.φ.toPartialEquiv p.x), p.h)

open Classical in
/-- `Tφ : TV → TO`, `[(x, φ, h)] ↦ (φ(x), h)`, computed with a chosen representative in the
chart `φ` (junk `0` when there is none). -/
noncomputable def TφB (P : MPolyfold X) (φ : MChart X) (α : P.TangentSpace) :
    (TEB φ.model.E).lvl 0 :=
  if h : ∃ p : P.TangentPre, p.φ = φ ∧ MPolyfold.TangentSpace.mk p = α then
    cast (congrArg (fun c : MChart X => (TEB c.model.E).lvl 0) h.choose_spec.1) (vecB h.choose)
  else 0

/-- The family `𝓑` of the sets `(Tφ)⁻¹(W)`, `φ` a chart of `X`, `W` open. -/
def TfamB (P : MPolyfold X) : Set (Set P.TangentSpace) :=
  {s | ∃ φ : MChart X, P.IsChart φ ∧ ∃ W : Set ((TEB φ.model.E).lvl 0), IsOpen W ∧
    s = {α | α ∈ TVB P φ ∧ TφB P φ α ∈ W}}

/-- The topology on `TX` generated by `𝓑`. -/
@[instance_reducible] def τB (P : MPolyfold X) : TopologicalSpace P.TangentSpace :=
  TopologicalSpace.generateFrom (TfamB P)

end

/-- Proposition 2.19: `𝓑` is a basis of a Hausdorff topology on `TX`; `p : TX → X_1` is
continuous and open; `TX` is metrizable, hence paracompact. -/
def B : Prop :=
  ∀ (X : Type) [TopologicalSpace X] [T2Space X] [ParacompactSpace X] (P : MPolyfold X),
    -- (1)
    (@TopologicalSpace.IsTopologicalBasis _ (τB P) (TfamB P) ∧ @T2Space _ (τB P)) ∧
    -- (2)
    (@Continuous _ _ (τB P) (P.levelTopology 1) P.tangentProj ∧
      @IsOpenMap _ _ (τB P) (P.levelTopology 1) P.tangentProj) ∧
    -- (3)
    (@TopologicalSpace.MetrizableSpace _ (τB P) ∧ @ParacompactSpace _ (τB P))

end RoundTrip.V2_20
