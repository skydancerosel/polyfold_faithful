import Polyfold
/-! Blind formalization of V5_12 (the text's §5.2, Theorem 5.7, p. 172).

Text: over a tame `X`, if `S = f⁻¹(0)` is compact in `X_0`, it is a compact subset of `X_∞`
("`X_∞` is a metric space"; "from Theorem 5.6 we conclude that `x_k → x` on every level").

Choices:
- Setting: `X Y : Type` (universe 0, as asked); `PX : MPolyfold X`, `P : Y → X` with the
  fibrewise linear structure as instances on the fibres, `Bd : StrongBundle PX P` (Definition
  2.51).  "Over a tame `X`": `PX.IsTame` (Definition 2.37, an equivalent atlas of tame charts — a
  property of the given structure); the bundle itself is not assumed tame.
- `f`: an sc-Fredholm section, as in the surrounding results (Theorems 5.5, 5.6): the project's
  `Bd.IsScFredholmSection f` (Definition 3.14, checked with `#print`: sc-smooth, regularizing, an
  sc-Fredholm germ at every smooth point, germ data in some compatible strong bundle chart).  I did
  not use the tame-chart variant `IsScFredholmSectionTame` since only `X` is said to be tame.
- `S = f⁻¹(0) = {x | f(x) = 0_x}` (`IsZeroAt`).  "Compact in `X_0`": `IsCompact S` in `X` (the
  topology of `X = X_0`).
- "a compact subset of `X_∞`": `S ⊆ X_∞ = ⋂ X_m` (`PX.smoothSet`) and `S`, seen in the subtype
  `X_∞` (`PX.SmoothLevel`), is compact for the inverse-limit topology on `X_∞`: the coarsest
  topology making every inclusion `X_∞ → X_m` continuous, `X_m` with its level topology
  (`PX.levelTopology m`, generated by the sets `φ⁻¹(W)`, `W` open in `O_m`).  This is the topology
  of convergence on every level, matching "`x_k → x` on every level"; it is `smoothTopology` below
  (the same definition as in `RoundTrip/Blind/V2_17.lean`).  I did not use whatever topology
  instance the project may put on `SmoothLevel`.
- Nothing looks false to me.
-/
namespace RoundTrip.V5_12
open Polyfold

/-- The inverse-limit topology on `X_∞`: the coarsest one making all inclusions
`X_∞ → X_m` continuous. -/
@[instance_reducible] def smoothTopology {X : Type} [TopologicalSpace X] [T2Space X]
    [ParacompactSpace X] (P : MPolyfold X) : TopologicalSpace P.SmoothLevel :=
  ⨅ m : ℕ, TopologicalSpace.induced (fun x : P.SmoothLevel => P.smoothIncl x m)
    (P.levelTopology m)

/-- Theorem 5.7: over a tame M-polyfold, the solution set of an sc-Fredholm section, if compact in
`X_0`, consists of smooth points and is compact in `X_∞`. -/
def B : Prop :=
  ∀ {X : Type} [TopologicalSpace X] [T2Space X] [ParacompactSpace X] (PX : MPolyfold X)
    {Y : Type} [TopologicalSpace Y] [T2Space Y] [ParacompactSpace Y] (P : Y → X)
    [∀ x, AddCommGroup (P ⁻¹' {x})] [∀ x, Module ℝ (P ⁻¹' {x})]
    (Bd : StrongBundle PX P) (f : X → Y),
    PX.IsTame → Bd.IsScFredholmSection f →
    IsCompact {x | IsZeroAt P f x} →
      {x | IsZeroAt P f x} ⊆ PX.smoothSet ∧
        @IsCompact PX.SmoothLevel (smoothTopology PX) {p | IsZeroAt P f (PX.smoothVal p)}

end RoundTrip.V5_12
