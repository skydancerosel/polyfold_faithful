import Polyfold
/-! Blind formalization of V19_85 (the text's §19.7, Propositions 19.7.23 and 19.7.24,
pp. 923–924 of the Springer 2021 book; 2017: Proposition 19.9).

Text: (V2) for `𝒜` iff for `ℬ`; `|𝒜|` paracompact iff `|ℬ|` is.

Choices:
- Setting: universe `0`: groupoidal categories `A`, `B`, a finite-to-one covering functor
  `P : A → B` (Definition 19.7.1; vocabulary `IsFiniteToOneCovering`) and a basic construction
  `Bh` for `P` (Definition 19.7.11; vocabulary `CoveringBasicConstruction P`, with underlying basic
  construction `(F, 𝓕)` = `Bh.toBasic` for `B`).
- Hypothesis added: `Bh.toBasic.U.HasClassUniformizers` (every class of `|B|` has an object `β`
  with `F(β) ≠ ∅`), the standing assumption under which `T_{|B|}` is a topology (Theorem 19.2.2);
  the text's use of `T_{|B|}` presupposes it.  No metrizability and no compatibility hypothesis
  (the vocabulary's `IsCompatible`) is assumed.
- `T_{|B|}` = the vocabulary's `Bh.toBasic.natTop hB` (open sets `NatOpen`, Definition 19.2.1).
  `T_{|A|}` = the topology generated by the collection of Definition 19.7.16 (the vocabulary's
  `NatOpenA`, checked by `#print`: `W` belongs to it if every `z̄ ∈ W` has a representative `β` of
  `|P|(z̄)`, `Ψ̂ ∈ F̂(β)`, `e ∈ E` with `|Ψ̂(e)| = z̄` and an open `V ∋ e` with `|Ψ̂(V)| ⊂ W`).  I did
  not use the project's `natTopA` (which takes `IsCompatible`).
- (V2) for `ℬ` (Definition 19.4.1 (2)): the vocabulary's `Bh.toBasic.PropernessV2 hB` (for every
  `Ψ ∈ F` and `o ∈ O` an open `U(o) ∋ o` with `cl_{|B|} |Ψ(U(o))| ⊂ |Ψ(O)|`).  (V2) for `𝒜`: the
  same condition read through the uniformizers `Ψ̂ : E → A` of `F̂`, for every `Ψ̂` in `F̂` and
  every `e ∈ E`, with the closure in `T_{|A|}` (written with the vocabulary's
  `Chapter19.OrbitChartV2`, checked by `#print`).
- Paracompact = Mathlib's `ParacompactSpace` for `T_{|A|}`, `T_{|B|}`.
- B is the conjunction of the two equivalences.  Nothing looks doubtful to me.
-/
namespace RoundTrip.V19_85
open Polyfold
open GroupoidalCategory

/-- `T_{|A|}`: generated by the collection of Definition 19.7.16. -/
@[instance_reducible]
def topA {A B : GroupoidalCategory.{0}} {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr}
    (Bh : CoveringBasicConstruction P) : TopologicalSpace A.OrbitSpace :=
  TopologicalSpace.generateFrom {W | Bh.NatOpenA W}

/-- (V2) for `𝒜`, read through the uniformizers `Ψ̂ : E → A` of `F̂`. -/
def V2A {A B : GroupoidalCategory.{0}} {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr}
    (Bh : CoveringBasicConstruction P) : Prop :=
  ∀ (x : Bh.hatU.Unif) (e : x.Ψh.ObjE),
    @Chapter19.OrbitChartV2 _ _ _ (topA Bh) (fun d => A.π (x.Ψh.hat.obj d)) e

/-- Propositions 19.7.23 and 19.7.24: (V2) and paracompactness pass between `𝒜` and `ℬ`. -/
def B : Prop :=
  ∀ (A B : GroupoidalCategory.{0}) (P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr),
    IsFiniteToOneCovering P →
    ∀ (Bh : CoveringBasicConstruction P) (hB : Bh.toBasic.U.HasClassUniformizers),
      (V2A Bh ↔ Bh.toBasic.PropernessV2 hB) ∧
      (@ParacompactSpace A.OrbitSpace (topA Bh) ↔
        @ParacompactSpace B.OrbitSpace (Bh.toBasic.natTop hB))

end RoundTrip.V19_85
