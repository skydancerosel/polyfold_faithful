import Polyfold
/-! Blind formalization of V5_11 (the text's §5.2, Theorem 5.6, p. 172).

Text: for an sc-Fredholm `f` and `f(x) = 0` there are open sets `x ∈ U(i + 1) ⊆ U(i) ⊆ X_0` with
`cl_{X_0}{y ∈ U(i) | f(y) = 0}` a compact subset of `X_i`.

Choices:
- Setting: `X Y : Type` (universe 0, as asked); `PX : MPolyfold X`, `P : Y → X` with the
  fibrewise linear structure as instances on the fibres, `Bd : StrongBundle PX P` (Definition
  2.51), as in `RoundTrip/Blind/V5_12.lean`.
- No tameness: the statement (unlike Theorems 5.5, 5.7 and Corollary 5.8 around it) does not say
  "tame", and nothing in it presupposes tameness.
- `f` sc-Fredholm: the project's `Bd.IsScFredholmSection f` (Definition 3.14, checked with
  `#print`: sc-smooth section, regularizing, an sc-Fredholm germ at every smooth point).
- `f(x) = 0`: `IsZeroAt P f x` (`f x = 0_x`).
- The sets `U(i)`: a sequence `U : ℕ → Set X`, `i = 0, 1, 2, …`, each open in `X = X_0`, all
  containing `x`, decreasing (`U(i + 1) ⊆ U(i)`).
- "`cl_{X_0}{y ∈ U(i) | f(y) = 0}` is a compact subset of `X_i`": the closure `K_i` in `X` of
  `{y ∈ U(i) | f(y) = 0_y}` is contained in `X_i` (`PX.levelSet i`) and, as a subset of the level
  `X_i` with its own topology (`PX.levelTopology i`, generated by the sets `φ⁻¹(W)`, `W` open in
  `O_i`; the project's level topology, as in `RoundTrip/Blind/V2_17.lean`), it is compact.
- Nothing looks false to me.
-/
namespace RoundTrip.V5_11
open Polyfold

/-- Theorem 5.6: near a zero `x` of an sc-Fredholm section there is a decreasing sequence of open
neighbourhoods `U(i)` of `x` such that the closure of the zeros in `U(i)` is a compact subset of
the level `X_i`. -/
def B : Prop :=
  ∀ {X : Type} [TopologicalSpace X] [T2Space X] [ParacompactSpace X] (PX : MPolyfold X)
    {Y : Type} [TopologicalSpace Y] [T2Space Y] [ParacompactSpace Y] (P : Y → X)
    [∀ x, AddCommGroup (P ⁻¹' {x})] [∀ x, Module ℝ (P ⁻¹' {x})]
    (Bd : StrongBundle PX P) (f : X → Y),
    Bd.IsScFredholmSection f → ∀ x : X, IsZeroAt P f x →
      ∃ U : ℕ → Set X,
        (∀ i, IsOpen (U i)) ∧ (∀ i, x ∈ U i) ∧ (∀ i, U (i + 1) ⊆ U i) ∧
        ∀ i : ℕ,
          closure {y | y ∈ U i ∧ IsZeroAt P f y} ⊆ PX.levelSet i ∧
          @IsCompact (PX.levelSet i) (PX.levelTopology i)
            {p | p.1 ∈ closure {y | y ∈ U i ∧ IsZeroAt P f y}}

end RoundTrip.V5_11
