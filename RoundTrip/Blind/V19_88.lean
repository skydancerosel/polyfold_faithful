import Polyfold
/-! Blind formalization of V19_88 (the text's §19.7, Definition 19.7.27 and Theorem 19.7.28,
p. 928 of the Springer 2021 book; new in the 2021 edition).

Text: a basic construction for `P` with `|ℬ|` metrizable defines a proper polyfold covering
structure.

Choices:
- Setting: universe `0`: groupoidal categories `A`, `B`, a finite-to-one covering functor
  `P : A → B` (Definition 19.7.1; vocabulary `IsFiniteToOneCovering`) and a basic construction
  `Bh = (F̂, 𝓕)` for `P` (Definition 19.7.11; vocabulary `CoveringBasicConstruction P`, underlying
  basic construction `Bh.toBasic` for `B`).
- Hypotheses: `Bh.toBasic.U.HasClassUniformizers` (standing assumption under which `T_{|B|}` is a
  topology, Theorem 19.2.2) and `T_{|B|}` (vocabulary `Bh.toBasic.natTop hB`) metrizable.  No
  compatibility hypothesis (the vocabulary's `IsCompatible`) is assumed.
- GCTs: `ℬ` = `(B, T_{|B|})`, the vocabulary's `Bh.toBasic.toGCTOfMetrizable hB hm`, with the
  polyfold structure of Theorem 19.5.3 (2) built from `(F, 𝓕)` (the vocabulary's
  `BasicConstruction.toPolyfoldConstruction hm`).  `𝒜` = `(A, T_{|A|})` with `T_{|A|}` the topology
  generated by the collection of Definition 19.7.16 (vocabulary `NatOpenA`); a GCT needs a
  metrizable orbit space, so the metrizability of `T_{|A|}` is part of the claim (existential
  `hA`).  I did not use the project's `natTopA`, `gctA`, `toGCTA` (they take `IsCompatible`).
- "proper polyfold covering structure" = Definition 17.8.13 (vocabulary
  `ProperPolyfoldCoveringStructure P` for `P : 𝒜 → ℬ`), which is defined for a proper covering
  functor of GCTs (Definition 17.8.1); so I also claim `P.IsProperCoveringGCT` (presupposed by
  the notion).
- "defines": the structure is the one built from the basic construction: (i) its polyfold
  structure of `ℬ` is that of `(F, 𝓕)` (`S.SB = toPolyfoldConstruction hm`); (ii) its proper
  covering uniformizers at `β` correspond to the members of `F̂(β)`: every `Ψ̂ ∈ F̂(β)` has a
  member `U` of `S` at `β` with the same `Ψ : G ⋉ O → B` and the same image `Ψ̂(E)` of objects in
  `A`, and conversely.  (The types of the two kinds of uniformizers differ, so I compare these
  data rather than the uniformizers themselves; the M-polyfold structures on the `M(Ψ̂, Ψ̂')` are
  then determined up to the identification by the field `isLocalScDiffeo_p`.)  This rendering
  of "defines" is a choice.
- Nothing looks doubtful to me.
-/
namespace RoundTrip.V19_88
open Polyfold
open GroupoidalCategory

/-- `T_{|A|}`: generated by the collection of Definition 19.7.16. -/
@[instance_reducible]
def topA {A B : GroupoidalCategory.{0}} {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr}
    (Bh : CoveringBasicConstruction P) : TopologicalSpace A.OrbitSpace :=
  TopologicalSpace.generateFrom {W | Bh.NatOpenA W}

/-- The GCT `𝒜 = (A, T_{|A|})`, given the metrizability of `T_{|A|}`. -/
def GA {A B : GroupoidalCategory.{0}} {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr}
    (Bh : CoveringBasicConstruction P)
    (hA : @TopologicalSpace.MetrizableSpace A.OrbitSpace (topA Bh)) : GCT.{0} :=
  @GCT.mk A (topA Bh) hA

/-- Definition 19.7.27 and Theorem 19.7.28: the proper polyfold covering structure of `P`. -/
def B : Prop :=
  ∀ (A B : GroupoidalCategory.{0}) (P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr),
    IsFiniteToOneCovering P →
    ∀ (Bh : CoveringBasicConstruction P) (hB : Bh.toBasic.U.HasClassUniformizers)
      (hm : @TopologicalSpace.MetrizableSpace B.OrbitSpace (Bh.toBasic.natTop hB)),
      ∃ hA : @TopologicalSpace.MetrizableSpace A.OrbitSpace (topA Bh),
        @GroupoidFunctor.IsProperCoveringGCT (GA Bh hA) (Bh.toBasic.toGCTOfMetrizable hB hm) P ∧
        ∃ S : @ProperPolyfoldCoveringStructure (GA Bh hA)
            (Bh.toBasic.toGCTOfMetrizable hB hm) P,
          S.SB = BasicConstruction.toPolyfoldConstruction hm ∧
          (∀ (β : B.Obj), ∀ Ψh ∈ Bh.hatU.F β, ∃ U ∈ S.toC.F β,
            U.Ψ = Ψh.Ψ ∧ Set.range U.hat.obj = Set.range Ψh.hat.obj) ∧
          (∀ (β : B.Obj), ∀ U ∈ S.toC.F β, ∃ Ψh ∈ Bh.hatU.F β,
            U.Ψ = Ψh.Ψ ∧ Set.range U.hat.obj = Set.range Ψh.hat.obj)

end RoundTrip.V19_88
