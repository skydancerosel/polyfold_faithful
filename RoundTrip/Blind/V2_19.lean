import Polyfold
/-! Blind formalization of V2_19 (the text's §2.2, Definition 2.18, pp. 26–27).

Text: `TX` is the set of equivalence classes `[(x, φ, h)]`, `T_xX` the classes over `x ∈ X_1`, a
vector space; `TV` is the set of classes over `V` and `Tφ : TV → TO`,
`[(x, φ, h)] ↦ (φ(x), h)`, is linear on fibres.  `TX` is topologized by the sets `(Tφ)⁻¹(W)`,
`W` open in `TO`.

Choices:
- This item is a definition plus properties.  Setting: `X : Type` (spaces in `Type`; the project's
  `MPolyfold` is universe-polymorphic, this is `u = 0`; `TX` then lives in `Type 1`, as its points
  carry charts) with `[TopologicalSpace X] [T2Space X] [ParacompactSpace X]`, `P : MPolyfold X`
  (Definition 2.13).  Charts: `MChart X` with `P.IsChart φ` (maximal atlas, checked).
- Tuples and `∼`: the project's `P.TangentPre` (checked with `#print`; my
  `RoundTrip/Blind/V2_18.lean` states they are the text's tuples) with the text's relation
  `RelB` (copied from V2_18: `x = x'` and `T(φ ∘ ψ⁻¹)(ψ(x))h' = h`).  `TX` is the project's
  `P.TangentSpace` with the class map `TangentSpace.mk`; B says every element is a class and two
  classes agree iff the tuples are `RelB`-related ("`TX` is the set of equivalence classes").
- `p : TX → X_1`, `[(x, φ, h)] ↦ x` (Definition 2.18 uses it for `T_xX`): B says the project's
  `P.tangentProj` sends `[(x, φ, h)]` to `x`.  `T_xX` (`TxXB`) is the set of classes of tuples
  with base point `x`; B says the project's `P.tangentFiber x` is it.
- "a vector space ... `Tφ` linear on fibres": there is a real vector space structure on `T_xX`
  for which, for EVERY chart `φ` around `x`, the fibre map `α ↦ h` of `Tφ` is linear.  (Such a
  structure is unique when it exists, since that map is injective; this is my rendering of "the"
  vector space `T_xX` with `Tφ` linear on fibres.)
- `TV` (`TVB`): the classes of tuples with base point in `V`; B says the project's
  `tangentChartSet φ` is it.  `Tφ` (`TφB`): `α ↦ (φ(x), h)` for a representative `(x, φ, h)` of
  `α` in the chart `φ` (chosen; junk `0` off `TV`); `φ(x)` is its level-1 point (the lift of
  `φ(x)` to `E_1`), so `Tφ α ∈ TE₀ = E_1 × E_0` (`TEB E = E¹ ⊕ E`; the project's
  `ScBanach.tangent` is the same, reducibly).  The text's formula needs: every `α ∈ TV` has a
  representative in the chart `φ`, and the formula does not depend on the representative (B:
  `TφB φ [(x, φ, h)] = (φ(x), h)` for every tuple).  `Tφ` maps `TV` into `TO` (`TOB R`,
  Definition 2.5, for every retraction `R` onto `O`).  B says the project's `tangentChartMap`
  agrees with `TφB` on `TV`.
- Topology: the family `TfamB` of the sets `(Tφ)⁻¹(W) = {α ∈ TV | Tφ α ∈ W}`, `φ` a chart, `W`
  open in `TE₀` (since `Tφ(TV) ⊆ TO`, these are the preimages of the open sets `W ∩ TO` of `TO`).
  "Topologized by": the topology of `TX` (the instance the project puts on `P.TangentSpace`) is
  the one generated by `TfamB`.  That `TfamB` is a basis of a Hausdorff topology is Proposition
  2.19 (my `RoundTrip/Blind/V2_20.lean`).
- Nothing looks false to me.
-/
namespace RoundTrip.V2_19
open Polyfold

/-- `TE = E¹ ⊕ E`. -/
noncomputable abbrev TEB (E : ScBanach) : ScBanach := E.shift.prod E

/-- `TO = {(r(x), Dr(x)h) : x ∈ U₁, h ∈ E}`, computed with the retraction `R` (Definition 2.5). -/
def TOB {E : ScBanach} {C : Set (E.lvl 0)} (R : ScRetraction E C) : Set ((TEB E).lvl 0) :=
  {p | ∃ x₁ : E.lvl 1, E.toBase 1 x₁ ∈ R.U ∧ ∃ h : E.lvl 0,
    E.toBase 1 p.1 = R.toFun (E.toBase 1 x₁) ∧ p.2 = scDeriv R.U R.toFun x₁ h}

section
variable {X : Type} [TopologicalSpace X] [T2Space X] [ParacompactSpace X]

/-- **Definition 2.17**: `(x, φ, h) ∼ (x', ψ, h')` if `x = x'` and `T(φ ∘ ψ⁻¹)(ψ(x))h' = h`
(as in `RoundTrip/Blind/V2_18.lean`). -/
def RelB {P : MPolyfold X} (p q : P.TangentPre) : Prop :=
  p.x = q.x ∧
    ∃ R : ScRetraction q.φ.model.E q.φ.model.C,
      R.retract = q.φ.toPartialEquiv '' (q.φ.source ∩ p.φ.source) ∧
      ∃ y₁ : q.φ.model.E.lvl 1, q.φ.model.E.toBase 1 y₁ = q.φ.toPartialEquiv q.x ∧
        scDeriv R.U
          (((p.φ.toPartialEquiv : X → p.φ.model.E.lvl 0) ∘ q.φ.symm) ∘ R.toFun) y₁ q.h = p.h

/-- `T_xX`: the classes `[(x, φ, h)]` over `x`. -/
def TxXB (P : MPolyfold X) (x : X) : Set P.TangentSpace :=
  {α | ∃ p : P.TangentPre, MPolyfold.TangentSpace.mk p = α ∧ p.x = x}

/-- `TV`: the classes `[(x, ψ, h)]` with `x ∈ V`, `V` the domain of `φ`. -/
def TVB (P : MPolyfold X) (φ : MChart X) : Set P.TangentSpace :=
  {α | ∃ p : P.TangentPre, MPolyfold.TangentSpace.mk p = α ∧ p.x ∈ φ.source}

/-- The vector `(φ(x), h) ∈ TE₀` of a tuple `(x, φ, h)`, `φ(x)` seen in `E_1`. -/
noncomputable def vecB {P : MPolyfold X} (p : P.TangentPre) : (TEB p.φ.model.E).lvl 0 :=
  (Function.invFun (p.φ.model.E.toBase 1) (p.φ.toPartialEquiv p.x), p.h)

open Classical in
/-- `Tφ : TV → TO`, `[(x, φ, h)] ↦ (φ(x), h)`, computed with a chosen representative in the
chart `φ` (junk `0` when there is none). -/
noncomputable def TφB (P : MPolyfold X) (φ : MChart X) (α : P.TangentSpace) :
    (TEB φ.model.E).lvl 0 :=
  if h : ∃ p : P.TangentPre, p.φ = φ ∧ MPolyfold.TangentSpace.mk p = α then
    cast (congrArg (fun c : MChart X => (TEB c.model.E).lvl 0) h.choose_spec.1) (vecB h.choose)
  else 0

/-- The family of the sets `(Tφ)⁻¹(W)`, `φ` a chart of `X`, `W` open. -/
def TfamB (P : MPolyfold X) : Set (Set P.TangentSpace) :=
  {s | ∃ φ : MChart X, P.IsChart φ ∧ ∃ W : Set ((TEB φ.model.E).lvl 0), IsOpen W ∧
    s = {α | α ∈ TVB P φ ∧ TφB P φ α ∈ W}}

end

/-- Definition 2.18: `TX` is the set of classes; `T_xX` is a vector space; `Tφ : TV → TO`,
`[(x, φ, h)] ↦ (φ(x), h)` is well defined and linear on fibres; `TX` carries the topology
generated by the sets `(Tφ)⁻¹(W)`; and the project's objects are these. -/
def B : Prop :=
  ∀ (X : Type) [TopologicalSpace X] [T2Space X] [ParacompactSpace X] (P : MPolyfold X),
    -- `TX` is the set of equivalence classes
    (∀ α : P.TangentSpace, ∃ p : P.TangentPre, MPolyfold.TangentSpace.mk p = α) ∧
    (∀ p q : P.TangentPre,
      MPolyfold.TangentSpace.mk p = MPolyfold.TangentSpace.mk q ↔ RelB p q) ∧
    -- `p[(x, φ, h)] = x`, and `T_xX` is the set of classes over `x`
    (∀ p : P.TangentPre, P.levelVal 1 (P.tangentProj (MPolyfold.TangentSpace.mk p)) = p.x) ∧
    (∀ x : P.Level 1, P.tangentFiber x = TxXB P (P.levelVal 1 x)) ∧
    -- `T_xX` is a vector space, and every `Tφ` is linear on it
    (∀ x : P.Level 1,
      ∃ (_ : AddCommGroup (TxXB P (P.levelVal 1 x))) (_ : Module ℝ (TxXB P (P.levelVal 1 x))),
        ∀ φ : MChart X, P.IsChart φ → P.levelVal 1 x ∈ φ.source →
          IsLinearMap ℝ (fun α : TxXB P (P.levelVal 1 x) => (TφB P φ α).2)) ∧
    -- `TV` is the set of classes over `V`
    (∀ φ : MChart X, P.IsChart φ → MPolyfold.tangentChartSet (P := P) φ = TVB P φ) ∧
    -- `Tφ[(x, φ, h)] = (φ(x), h)` is well defined on `TV`, with values in `TO`
    (∀ φ : MChart X, P.IsChart φ → ∀ α ∈ TVB P φ,
      ∃ p : P.TangentPre, p.φ = φ ∧ MPolyfold.TangentSpace.mk p = α) ∧
    (∀ p : P.TangentPre, TφB P p.φ (MPolyfold.TangentSpace.mk p) = vecB p) ∧
    (∀ φ : MChart X, P.IsChart φ → ∀ R : ScRetraction φ.model.E φ.model.C,
      R.retract = φ.model.O → ∀ α ∈ TVB P φ, TφB P φ α ∈ TOB R) ∧
    -- the project's `Tφ` is this map on `TV`
    (∀ (φ : MChart X) (hφ : P.IsChart φ), ∀ α ∈ TVB P φ,
      MPolyfold.tangentChartMap hφ α = TφB P φ α) ∧
    -- the topology of `TX`
    (inferInstance : TopologicalSpace P.TangentSpace) = TopologicalSpace.generateFrom (TfamB P)

end RoundTrip.V2_19
