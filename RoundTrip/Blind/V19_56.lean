namespace RoundTrip.V19_56
open Polyfold

/-- Theorem 19.6.8: the natural topology `T̄` on `|E_μ|`. -/
def B : Prop :=
  ∀ (C : GroupoidalCategory.{0}) (μ : C.BanFunctor) (Bs : C.BasicStrongBundleConstruction μ)
    (hB : Bs.base.U.HasClassUniformizers),
    letI : TopologicalSpace C.OrbitSpace := Bs.base.natTop hB
    letI : TopologicalSpace μ.cat.OrbitSpace :=
      TopologicalSpace.generateFrom {W | Bs.BarOpen W}
    -- (1) `T̄` is a topology
    (∀ W : Set μ.cat.OrbitSpace, IsOpen W ↔ Bs.BarOpen W) ∧
    -- (2) images of open sets are open
    (∀ (α : C.Obj), ∀ Ψe ∈ Bs.U.F α, ∀ V : Set Ψe.O, IsOpen V →
      IsOpen ((fun a => μ.cat.π (Ψe.obj a)) '' V)) ∧
    -- (3) `|Ψ̄| : G\K → |E|` is a homeomorphism onto an open set
    (∀ (α : C.Obj), ∀ Ψe ∈ Bs.U.F α,
      ∃ e : MulAction.orbitRel.Quotient Ψe.G Ψe.O → μ.cat.OrbitSpace,
        (∀ a : Ψe.O, e (Quotient.mk _ a) = μ.cat.π (Ψe.obj a)) ∧ Topology.IsOpenEmbedding e) ∧
    -- (4) `|P|⁻¹(V)` is metrizable for small open `V`
    (∀ z : C.OrbitSpace, ∃ V : Set C.OrbitSpace, IsOpen V ∧ z ∈ V ∧
      TopologicalSpace.MetrizableSpace (μ.orbitProj ⁻¹' V)) ∧
    -- (5) `|P|` is continuous
    Continuous μ.orbitProj

end RoundTrip.V19_56
