import Polyfold
/-! Blind formalization of V7_6 (the text's Part II, §7.1, pp. 227–228 of the 2017 book: the
levels of an ep-groupoid, the filtration of `|X|`, and the degeneracy indices).

Text: `X` and `𝐗` carry the filtrations `X = X₀ ⊃ X₁ ⊃ ⋯ ⊃ X_∞ = ⋂ X_k` (similarly for `𝐗`), with
`X_∞` dense in every `X_k`; `ml(x) ∈ ℕ ∪ {∞}` is the largest `m` (or `∞`) with `x ∈ X_m`.  Since
`s, t` are local sc-diffeomorphisms and so preserve the levels, `ml(x) = ml(y) = ml(φ)` for every
`φ : x → y`; hence the filtration `|X| = |X₀| ⊃ |X₁| ⊃ ⋯ ⊃ |X_∞| = ⋂ |X_k|`.  The degeneracy
indices `d_X`, `d_𝐗` are invariant under local sc-diffeomorphisms (Proposition 2.7), so
`d_X(s φ) = d_𝐗(φ) = d_X(t φ)`; in particular `d_X(x) = d_X(x')` if `x ∼ x'`.

Choices:
- Setting: `Obj Mor : Type` (universe 0), Hausdorff paracompact, `X : EpGroupoid Obj Mor`
  (`RoundTrip/Blind/V7_3.lean`).  The claims are made for the object space `X.PObj` and the
  morphism space `X.PMor` of every ep-groupoid (as the text says "the M-polyfolds `X` and `𝐗`").
- Levels: the project's `MPolyfold.levelSet m` (`X_m`, checked with `#print`: points mapped into
  `E_m` by a chart of the structure) and `smoothSet` (checked: `⋂ m, levelSet m`).  "`X_∞` dense in
  `X_k`" is density in `X_k` with its own topology (the level-`k` topology generated by the sets
  `φ⁻¹(W)`, `W` open in `O_k`, the project's `MPolyfold.levelTopology k`), of the set of points of
  `X_k` lying in `X_∞`.
- `ml`: the project's `MPolyfold.maxLevel` (`ℕ∞`; checked: `⨆ m, ⨆ (_ : x ∈ X_m), m`), claimed to
  be the text's `ml`: `m ≤ ml(x) ↔ x ∈ X_m` for every `m : ℕ` (which pins down `ml(x)` as the
  largest such `m`, or `⊤ = ∞` when `x ∈ X_m` for all `m`), for objects and for morphisms.
- "`s, t` preserve the levels" is asserted as `φ ∈ 𝐗_m ↔ s φ ∈ X_m` (and the same for `t`), for
  every `m`; then `ml(s φ) = ml(φ) = ml(t φ)`.
- `|X_k| = π(X_k)` (the project's `orbitLevel X k`, checked: `π '' levelSet k`; B asserts it is
  `π '' X_k`), `|X_∞| = π(X_∞)`; the filtration claim: `|X₀| = |X|`, `|X_{k+1}| ⊆ |X_k|`,
  `|X_∞| = ⋂_k |X_k|`.
- `d_X`, `d_𝐗`: the project's `MPolyfold.degIndex` (Definition 2.22, see
  `RoundTrip/Blind/V2_26.lean`); `x ∼ x'` is the project's `GroupoidStr.Isomorphic` (characterized
  in `RoundTrip/Blind/V7_1.lean`).  The general invariance (Proposition 2.7) is Part I's
  `RoundTrip/Blind/V2_28.lean` and is not repeated; only its instances for `s`, `t` are claimed.
- Nothing looks false to me.
-/
namespace RoundTrip.V7_6
open Polyfold

section
variable {Z : Type} [TopologicalSpace Z] [T2Space Z] [ParacompactSpace Z]

/-- The filtration `Z = Z₀ ⊃ Z₁ ⊃ ⋯ ⊃ Z_∞ = ⋂ Z_k` of an M-polyfold, with `Z_∞` dense in every
`Z_k` (for the topology of `Z_k`). -/
def FiltrationB (P : MPolyfold Z) : Prop :=
  P.levelSet 0 = Set.univ ∧
  (∀ k, P.levelSet (k + 1) ⊆ P.levelSet k) ∧
  P.smoothSet = ⋂ k, P.levelSet k ∧
  ∀ k, @Dense ↥(P.levelSet k) (P.levelTopology k) {z | (z : Z) ∈ P.smoothSet}

/-- `ml(z)` is the largest `m` with `z ∈ Z_m`, or `∞` (`⊤`) if there is none. -/
def IsMaxLevelB (P : MPolyfold Z) (ml : Z → ℕ∞) : Prop :=
  ∀ (z : Z) (m : ℕ), (m : ℕ∞) ≤ ml z ↔ z ∈ P.levelSet m

end

/-- The levels of an ep-groupoid: filtrations of `X`, `𝐗` and `|X|`, `ml` and `d` constant along
morphisms. -/
def B : Prop :=
  ∀ (Obj Mor : Type) [TopologicalSpace Obj] [T2Space Obj] [ParacompactSpace Obj]
    [TopologicalSpace Mor] [T2Space Mor] [ParacompactSpace Mor] (X : EpGroupoid Obj Mor),
    -- filtrations of `X` and `𝐗`, `X_∞` dense in `X_k`
    FiltrationB X.PObj ∧ FiltrationB X.PMor ∧
    -- `ml` (the project's `maxLevel`) on `X` and `𝐗`
    IsMaxLevelB X.PObj X.PObj.maxLevel ∧ IsMaxLevelB X.PMor X.PMor.maxLevel ∧
    -- `s`, `t` preserve the levels
    (∀ (φ : Mor) (m : ℕ), (φ ∈ X.PMor.levelSet m ↔ X.src φ ∈ X.PObj.levelSet m) ∧
      (φ ∈ X.PMor.levelSet m ↔ X.tgt φ ∈ X.PObj.levelSet m)) ∧
    -- `ml(x) = ml(φ) = ml(y)` for `φ : x → y`
    (∀ φ : Mor, X.PObj.maxLevel (X.src φ) = X.PMor.maxLevel φ ∧
      X.PMor.maxLevel φ = X.PObj.maxLevel (X.tgt φ)) ∧
    -- the induced filtration of `|X|`, with `|X_k| = π(X_k)`
    (∀ k, X.orbitLevel k = X.π '' X.PObj.levelSet k) ∧
    X.π '' X.PObj.levelSet 0 = Set.univ ∧
    (∀ k, X.π '' X.PObj.levelSet (k + 1) ⊆ X.π '' X.PObj.levelSet k) ∧
    X.π '' X.PObj.smoothSet = ⋂ k, X.π '' X.PObj.levelSet k ∧
    -- `d_X(s φ) = d_𝐗(φ) = d_X(t φ)`, and `d_X` is constant on isomorphism classes
    (∀ φ : Mor, X.PObj.degIndex (X.src φ) = X.PMor.degIndex φ ∧
      X.PMor.degIndex φ = X.PObj.degIndex (X.tgt φ)) ∧
    (∀ x x' : Obj, X.Isomorphic x x' → X.PObj.degIndex x = X.PObj.degIndex x')

end RoundTrip.V7_6
