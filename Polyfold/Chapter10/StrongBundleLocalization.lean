/-! ### Operations on natural transformations of strong bundle functors -/

section NatTransOps

variable {Obj Mor : Type u} [TopologicalSpace Obj] [T2Space Obj] [ParacompactSpace Obj]
  [TopologicalSpace Mor] [T2Space Mor] [ParacompactSpace Mor] {X : EpGroupoid Obj Mor}
  {W : Type u} [TopologicalSpace W] [T2Space W] [ParacompactSpace W] {P : W → Obj}
  [∀ x, AddCommGroup (P ⁻¹' {x})] [∀ x, Module ℝ (P ⁻¹' {x})] {B : StrongBundle X.PObj P}
  [ParacompactSpace (pullbackSpace P X.src)]
  {Obj' Mor' : Type u} [TopologicalSpace Obj'] [T2Space Obj'] [ParacompactSpace Obj']
  [TopologicalSpace Mor'] [T2Space Mor'] [ParacompactSpace Mor'] {X' : EpGroupoid Obj' Mor'}
  {W' : Type u} [TopologicalSpace W'] [T2Space W'] [ParacompactSpace W'] {P' : W' → Obj'}
  [∀ x, AddCommGroup (P' ⁻¹' {x})] [∀ x, Module ℝ (P' ⁻¹' {x})] {B' : StrongBundle X'.PObj P'}
  [ParacompactSpace (pullbackSpace P' X'.src)]
  {Obj'' Mor'' : Type u} [TopologicalSpace Obj''] [T2Space Obj''] [ParacompactSpace Obj'']
  [TopologicalSpace Mor''] [T2Space Mor''] [ParacompactSpace Mor''] {X'' : EpGroupoid Obj'' Mor''}
  {W'' : Type u} [TopologicalSpace W''] [T2Space W''] [ParacompactSpace W''] {P'' : W'' → Obj''}
  [∀ x, AddCommGroup (P'' ⁻¹' {x})] [∀ x, Module ℝ (P'' ⁻¹' {x})]
  {B'' : StrongBundle X''.PObj P''} [ParacompactSpace (pullbackSpace P'' X''.src)]
  {E : EpStrongBundle X B} {E' : EpStrongBundle X' B'} {E'' : EpStrongBundle X'' B''}

namespace EpStrongBundle.StrongBundleNatTrans

variable {ϕ ψ χ : EpFunctor X X'} {Φ Ψ Χ : EpFunctor E.toEpGroupoid E'.toEpGroupoid}

/-- The natural transformation `T : Φ → Ψ` of the functors `(W, 𝐖) → (W', 𝐖')` underlying a
natural transformation of strong bundle functors; `T` is sc-smooth by Remark 10.4.9
(`isStrongBundleMap_T`). -/
def toEpNatTrans (θ : E.StrongBundleNatTrans E' ϕ ψ Φ Ψ) (hΦ : E.IsStrongBundleFunctor E' ϕ Φ) :
    EpNatTrans Φ Ψ where
  app := θ.T
  isScSmoothMap_app := (θ.isStrongBundleMap_T hΦ).isScSmoothMap
  src_app := θ.src_T
  tgt_app := θ.tgt_T
  naturality := θ.naturality

@[simp] theorem toEpNatTrans_app (θ : E.StrongBundleNatTrans E' ϕ ψ Φ Ψ)
    (hΦ : E.IsStrongBundleFunctor E' ϕ Φ) (w : W) : (θ.toEpNatTrans hΦ).app w = θ.T w := rfl

/-- A natural transformation of strong bundle functors from a natural transformation of the
functors `(W, 𝐖) → (W', 𝐖')` and one of the base functors with `τ(P(w)) = P(T(w))`. -/
def ofEpNatTrans (σ : EpNatTrans Φ Ψ) (τ : EpNatTrans ϕ ψ)
    (h : ∀ w, τ.app (P w) = (σ.app w : Mor' × W').1) : E.StrongBundleNatTrans E' ϕ ψ Φ Ψ where
  T := σ.app
  src_T := σ.src_app
  tgt_T := σ.tgt_app
  naturality := σ.naturality
  τ := τ
  app_P := h

/-- The inverse `Ψ → Φ`, `w ↦ T(w)⁻¹`, covering `τ⁻¹`. -/
def symm (θ : E.StrongBundleNatTrans E' ϕ ψ Φ Ψ) (hΦ : E.IsStrongBundleFunctor E' ϕ Φ) :
    E.StrongBundleNatTrans E' ψ ϕ Ψ Φ :=
  ofEpNatTrans (θ.toEpNatTrans hΦ).symm θ.τ.symm fun w => by
    change X'.inv (θ.τ.app (P w)) = X'.inv (θ.T w : Mor' × W').1
    rw [θ.app_P]

/-- The composite `Φ → Ψ → Χ`, `w ↦ T'(w) ∘ T(w)`, covering `τ' ∘ τ`. -/
def trans (θ : E.StrongBundleNatTrans E' ϕ ψ Φ Ψ) (θ' : E.StrongBundleNatTrans E' ψ χ Ψ Χ)
    (hΦ : E.IsStrongBundleFunctor E' ϕ Φ) (hΨ : E.IsStrongBundleFunctor E' ψ Ψ) :
    E.StrongBundleNatTrans E' ϕ χ Φ Χ :=
  ofEpNatTrans ((θ.toEpNatTrans hΦ).trans (θ'.toEpNatTrans hΨ)) (θ.τ.trans θ'.τ) fun w => by
    change X'.comp (θ'.τ.app (P w)) (θ.τ.app (P w)) = (morComp (θ'.T w) (θ.T w) : Mor' × W').1
    rw [morComp_val ((θ'.src_T w).trans (θ.tgt_T w).symm), θ.app_P, θ'.app_P]

/-- Whiskering by a strong bundle functor `H` covering `η`: `Φ ∘ H → Ψ ∘ H`, `w ↦ T(H(w))`,
covering `τ ∘ η`. -/
def whiskerLeft (θ : E.StrongBundleNatTrans E' ϕ ψ Φ Ψ) (hΦ : E.IsStrongBundleFunctor E' ϕ Φ)
    {η : EpFunctor X'' X} {H : EpFunctor E''.toEpGroupoid E.toEpGroupoid}
    (hH : E''.IsStrongBundleFunctor E η H) :
    E''.StrongBundleNatTrans E' (ϕ.comp η) (ψ.comp η) (Φ.comp H) (Ψ.comp H) :=
  ofEpNatTrans ((θ.toEpNatTrans hΦ).whiskerLeft H) (θ.τ.whiskerLeft η) fun w => by
    change θ.τ.app (η.obj (P'' w)) = (θ.T (H.obj w) : Mor' × W').1
    rw [← θ.app_P (H.obj w), hH.isStrongBundleMap_obj.covers]

end EpStrongBundle.StrongBundleNatTrans

end NatTransOps

/-! ### Natural equivalence of morphisms of `SEP`; the total-space ep-groupoid -/

namespace SEP

variable {A A' A'' A''' : SEP.{u}}

/-- Two morphisms of `SEP` are **naturally equivalent** (Definition 10.4.8). -/
def NatEquiv (F G : A ⟶ A') : Prop :=
  A.E.StrongBundleNatEquiv A'.E (Hom.ϕ F) (Hom.ϕ G) (Hom.Φ F) (Hom.Φ G)

theorem NatEquiv.refl (F : A ⟶ A') : NatEquiv F F :=
  ⟨EpStrongBundle.StrongBundleNatTrans.refl (Hom.isStrongBundleFunctor F)⟩

theorem NatEquiv.symm {F G : A ⟶ A'} (h : NatEquiv F G) : NatEquiv G F :=
  let ⟨θ⟩ := h
  ⟨θ.symm (Hom.isStrongBundleFunctor F)⟩

theorem NatEquiv.trans {F G K : A ⟶ A'} (h : NatEquiv F G) (h' : NatEquiv G K) : NatEquiv F K :=
  let ⟨θ⟩ := h
  let ⟨θ'⟩ := h'
  ⟨θ.trans θ' (Hom.isStrongBundleFunctor F) (Hom.isStrongBundleFunctor G)⟩

theorem NatEquiv.comp_left {F G : A ⟶ A'} (h : NatEquiv F G) (K : A'' ⟶ A) :
    NatEquiv (K ≫ F) (K ≫ G) :=
  let ⟨θ⟩ := h
  ⟨θ.whiskerLeft (Hom.isStrongBundleFunctor F) (Hom.isStrongBundleFunctor K)⟩

/-- Naturally equivalent morphisms of `SEP` induce the same map `|W| → |W'|` (p. 503). -/
theorem NatEquiv.orbitMap_eq {F G : A ⟶ A'} (h : NatEquiv F G) :
    (Hom.Φ F).orbitMap = (Hom.Φ G).orbitMap :=
  EpStrongBundle.StrongBundleNatEquiv.orbitMap_eq h

/-- The base ep-groupoid `X` of a strong bundle over an ep-groupoid, as an object of `EP`
(`SEP.toEP.obj A`, `baseEP_eq`). -/
abbrev baseEP (A : SEP.{u}) : EP.{u} := ⟨A.Obj, A.Mor, A.X⟩

theorem baseEP_eq (A : SEP.{u}) : A.baseEP = SEP.toEP.obj A := rfl

/-- The ep-groupoid `(W, 𝐖)` of a strong bundle over an ep-groupoid, as an object of `EP`. -/
abbrev totalEP (A : SEP.{u}) : EP.{u} := ⟨A.W, pullbackSpace A.P A.X.src, A.E.toEpGroupoid⟩

/-- Naturally equivalent morphisms of `SEP` are naturally equivalent as functors
`(W, 𝐖) → (W', 𝐖')` (Remark 10.4.9: `T` is sc-smooth). -/
theorem NatEquiv.total {F G : A ⟶ A'} (h : NatEquiv F G) :
    (Hom.Φ F).NaturallyEquivalent (Hom.Φ G) :=
  let ⟨θ⟩ := h
  ⟨θ.toEpNatTrans (Hom.isStrongBundleFunctor F)⟩

/-- Naturally equivalent morphisms of `SEP` cover naturally equivalent functors. -/
theorem NatEquiv.base {F G : A ⟶ A'} (h : NatEquiv F G) :
    (Hom.ϕ F).NaturallyEquivalent (Hom.ϕ G) :=
  let ⟨θ⟩ := h
  ⟨θ.τ⟩

end SEP

/-! ### Diagrams of strong bundles -/

namespace SBLocalization

open EPLocalization

/-- A **diagram** `D : W ←Φ W'' →Ψ W'` of strong bundles over ep-groupoids (2021 p. 504): a
strong bundle `(P'' : W'' → X'', μ'')`, a strong bundle equivalence `Φ : W'' → W` and a strong
bundle functor `Ψ : W'' → W'` (morphisms of `SEP`). -/
structure SDiagram (A A' : SEP.{u}) : Type (u + 1) where
  /-- The middle strong bundle `W''`. -/
  B : SEP.{u}
  /-- The strong bundle equivalence `Φ : W'' → W`. -/
  Φ : B ⟶ A
  isEquivalence_Φ : SEP.equivalences Φ
  /-- The strong bundle functor `Ψ : W'' → W'`. -/
  Ψ : B ⟶ A'

namespace SDiagram

variable {A A' A'' : SEP.{u}}

/-- `Φ` as a strong bundle equivalence. -/
theorem hΦ (D : SDiagram A A') :
    D.B.E.IsStrongBundleEquivalence A.E (SEP.Hom.ϕ D.Φ) (SEP.Hom.Φ D.Φ) :=
  D.isEquivalence_Φ

/-- `D'` is a **refinement** of `D` (the strong bundle version of Definition 10.3.1, 2021
p. 504): a strong bundle equivalence `H : W''' → W''` with `Φ ∘ H ≃ Φ'` and `Ψ ∘ H ≃ Ψ'`
(Definition 10.4.8). -/
def IsRefinement (D' D : SDiagram A A') : Prop :=
  ∃ H : D'.B ⟶ D.B, SEP.equivalences H ∧ SEP.NatEquiv (H ≫ D.Φ) D'.Φ ∧
    SEP.NatEquiv (H ≫ D.Ψ) D'.Ψ

/-- `W ←(Φ∘H) W''' →(Ψ∘H) W'` for a strong bundle equivalence `H : W''' → W''`. -/
def precomp (D : SDiagram A A') {C : SEP.{u}} (H : C ⟶ D.B) (hH : SEP.equivalences H) :
    SDiagram A A' :=
  ⟨C, H ≫ D.Φ, SEP.equivalences.comp_mem _ _ hH D.isEquivalence_Φ, H ≫ D.Ψ⟩

/-- The first example of a refinement: `W ←(Φ∘H) W''' →(Ψ∘H) W'` refines `D`. -/
theorem isRefinement_precomp (D : SDiagram A A') {C : SEP.{u}} (H : C ⟶ D.B)
    (hH : SEP.equivalences H) : (D.precomp H hH).IsRefinement D :=
  ⟨H, hH, .refl _, .refl _⟩

/-- The second example: if `Φ' ≃ Φ` and `Ψ' ≃ Ψ`, then `W ←Φ' W'' →Ψ' W'` refines `D`
(`H = 1`). -/
theorem isRefinement_of_natEquiv (D : SDiagram A A') (Φ' : D.B ⟶ A) (hΦ' : SEP.equivalences Φ')
    (Ψ' : D.B ⟶ A') (h₁ : SEP.NatEquiv Φ' D.Φ) (h₂ : SEP.NatEquiv Ψ' D.Ψ) :
    (⟨D.B, Φ', hΦ', Ψ'⟩ : SDiagram A A').IsRefinement D :=
  ⟨𝟙 _, SEP.equivalences.id_mem _, h₁.symm, h₂.symm⟩

theorem IsRefinement.refl (D : SDiagram A A') : D.IsRefinement D :=
  ⟨𝟙 _, SEP.equivalences.id_mem _, .refl _, .refl _⟩

/-- **The strong bundle version of Lemma 10.3.2**: a refinement of a refinement of `D` is a
refinement of `D`. -/
theorem IsRefinement.trans {D D' D'' : SDiagram A A'} (h'' : D''.IsRefinement D')
    (h' : D'.IsRefinement D) : D''.IsRefinement D := by
  obtain ⟨H, hH, hΦ, hΨ⟩ := h'
  obtain ⟨H', hH', hΦ', hΨ'⟩ := h''
  exact ⟨H' ≫ H, SEP.equivalences.comp_mem _ _ hH' hH, (hΦ.comp_left H').trans hΦ',
    (hΨ.comp_left H').trans hΨ'⟩

/-- `D''` is a **common refinement** of `(D, D')` (Definition 10.3.3, strong bundle case). -/
def IsCommonRefinement (D'' D D' : SDiagram A A') : Prop := D''.IsRefinement D ∧ D''.IsRefinement D'

/-- Two diagrams are **equivalent** if they have a common refinement (2021 p. 504, following
Definition 10.3.5). -/
def Equiv (D D' : SDiagram A A') : Prop := ∃ D'' : SDiagram A A', D''.IsCommonRefinement D D'

theorem Equiv.refl (D : SDiagram A A') : Equiv D D := ⟨D, .refl D, .refl D⟩

theorem Equiv.symm {D D' : SDiagram A A'} (h : Equiv D D') : Equiv D' D :=
  let ⟨D'', h₁, h₂⟩ := h
  ⟨D'', h₂, h₁⟩

theorem IsRefinement.equiv {D' D : SDiagram A A'} (h : D'.IsRefinement D) : Equiv D' D :=
  ⟨D', .refl D', h⟩

/-! #### The underlying diagram of ep-groupoids and the diagram of total spaces -/

/-- **The diagram `d : X ←φ X'' →ψ X'` of the underlying ep-groupoids** covered by `D`
(2021 p. 504). -/
def base (D : SDiagram A A') : Diagram A.baseEP A'.baseEP :=
  ⟨D.B.baseEP, SEP.Hom.ϕ D.Φ, D.hΦ.isEquivalence_base, SEP.Hom.ϕ D.Ψ⟩

/-- The diagram `(W, 𝐖) ←Φ (W'', 𝐖'') →Ψ (W', 𝐖')` of the total-space ep-groupoids. -/
def total (D : SDiagram A A') : Diagram A.totalEP A'.totalEP :=
  ⟨D.B.totalEP, SEP.Hom.Φ D.Φ, D.hΦ.isEquivalence, SEP.Hom.Φ D.Ψ⟩

/-- A refinement of strong bundle diagrams covers a refinement of the underlying diagrams. -/
theorem IsRefinement.base {D' D : SDiagram A A'} (h : D'.IsRefinement D) :
    D'.base.IsRefinement D.base := by
  obtain ⟨H, hH, hΦ, hΨ⟩ := h
  exact ⟨SEP.Hom.ϕ H, hH.isEquivalence_base, hΦ.base, hΨ.base⟩

/-- A refinement of strong bundle diagrams is a refinement of the total-space diagrams. -/
theorem IsRefinement.total {D' D : SDiagram A A'} (h : D'.IsRefinement D) :
    D'.total.IsRefinement D.total := by
  obtain ⟨H, hH, hΦ, hΨ⟩ := h
  exact ⟨SEP.Hom.Φ H, hH.isEquivalence, hΦ.total, hΨ.total⟩

theorem Equiv.base {D D' : SDiagram A A'} (h : Equiv D D') : Diagram.Equiv D.base D'.base :=
  let ⟨D'', h₁, h₂⟩ := h
  ⟨D''.base, h₁.base, h₂.base⟩

theorem Equiv.total {D D' : SDiagram A A'} (h : Equiv D D') : Diagram.Equiv D.total D'.total :=
  let ⟨D'', h₁, h₂⟩ := h
  ⟨D''.total, h₁.total, h₂.total⟩

/-! #### The maps of orbit spaces -/

/-- **`|D| = |Ψ| ∘ |Φ|⁻¹ : |W| → |W'|`** (2021 p. 504). -/
def orbitMap (D : SDiagram A A') : A.E.toEpGroupoid.OrbitSpace → A'.E.toEpGroupoid.OrbitSpace :=
  D.total.orbitMap

theorem continuous_orbitMap (D : SDiagram A A') : Continuous D.orbitMap :=
  D.total.continuous_orbitMap

/-- `|D|` is unchanged under refinement (Lemma 10.3.6 for the total spaces). -/
theorem IsRefinement.orbitMap_eq {D' D : SDiagram A A'} (h : D'.IsRefinement D) :
    D.orbitMap = D'.orbitMap :=
  Diagram.lemma_10_3_6 h.total

theorem Equiv.orbitMap_eq {D D' : SDiagram A A'} (h : Equiv D D') : D.orbitMap = D'.orbitMap :=
  h.total.orbitMap_eq

/-- `|D|(|Φ|(q)) = |Ψ|(q)`. -/
theorem orbitMap_orbitMap_Φ (D : SDiagram A A') (q : D.B.E.toEpGroupoid.OrbitSpace) :
    D.orbitMap ((SEP.Hom.Φ D.Φ).orbitMap q) = (SEP.Hom.Φ D.Ψ).orbitMap q :=
  D.total.orbitMap_orbitMap_F q

/-- **The commutative diagram `|D|`** (2021 p. 505): `|P'| ∘ |D| = |d| ∘ |P|`. -/
theorem orbitMap_square (D : SDiagram A A') :
    A'.E.projFunctor.orbitMap ∘ D.orbitMap = D.base.orbitMap ∘ A.E.projFunctor.orbitMap := by
  funext q
  obtain ⟨r, rfl⟩ := D.hΦ.isEquivalence.isHomeomorph_orbitMap.surjective q
  induction r using Quotient.inductionOn with | h w => ?_
  simp only [Function.comp_apply]
  rw [orbitMap_orbitMap_Φ]
  change A'.E.projFunctor.orbitMap ((SEP.Hom.Φ D.Ψ).orbitMap (D.B.E.toEpGroupoid.π w)) =
    D.base.orbitMap (A.E.projFunctor.orbitMap ((SEP.Hom.Φ D.Φ).orbitMap
      (D.B.E.toEpGroupoid.π w)))
  simp only [GroupoidFunctor.orbitMap_π]
  have h₁ : A.X.π (A.E.projFunctor.obj ((SEP.Hom.Φ D.Φ).obj w)) =
      D.base.F.orbitMap (D.B.X.π (D.B.P w)) := by
    change _ = (SEP.Hom.ϕ D.Φ).orbitMap (D.B.X.π (D.B.P w))
    rw [GroupoidFunctor.orbitMap_π]
    exact congrArg A.X.π (D.hΦ.covers w)
  rw [h₁]
  refine Eq.trans ?_ (Diagram.orbitMap_orbitMap_F D.base _).symm
  change A'.X.π (A'.P ((SEP.Hom.Φ D.Ψ).obj w)) = (SEP.Hom.ϕ D.Ψ).orbitMap (D.B.X.π (D.B.P w))
  rw [GroupoidFunctor.orbitMap_π, (SEP.Hom.isStrongBundleFunctor D.Ψ).isStrongBundleMap_obj.covers]

end SDiagram

end SBLocalization

/-! ### The isotropy homomorphism of a diagram of ep-groupoids (2021 p. 505) -/

namespace EPLocalization.Diagram

variable {X Y : EP.{u}} (d : Diagram X Y)

/-- **The group homomorphism `γ : G_x → G'_{x'}`** of 2021 p. 505, for `x'' ∈ A` and morphisms
`a : φ(x'') → x`, `b : ψ(x'') → x'`: the composite of `g ↦ a⁻¹ ∘ g ∘ a`, of the inverse of
`φ : G_{x''} → G_{φ(x'')}`, of `ψ : G_{x''} → G_{ψ(x'')}` and of `ℓ ↦ b ∘ ℓ ∘ b⁻¹`. -/
def isotropyHom {x : X.Obj} {x' : Y.Obj} {x'' : d.A.Obj} (a : X.Mor)
    (ha : X.X.src a = d.F.obj x'') (ha' : X.X.tgt a = x) (b : Y.Mor)
    (hb : Y.X.src b = d.Φ.obj x'') (hb' : Y.X.tgt b = x') :
    X.X.Isotropy x →* Y.X.Isotropy x' :=
  (Y.X.isotropyConj b hb hb').toMonoidHom.comp ((d.Φ.isotropyHom x'').comp
    ((MulEquiv.ofBijective _ (d.isEquivalence_F.bijective_isotropyHom x'')).symm.toMonoidHom.comp
      (X.X.isotropyConj (X.X.inv a) (by rw [GroupoidStr.src_inv, ha'])
        (by rw [GroupoidStr.tgt_inv, ha])).toMonoidHom))

/-- The values of `γ`: `γ(g) = b ∘ ψ(k) ∘ b⁻¹` for the `k ∈ G_{x''}` with
`φ(k) = a⁻¹ ∘ g ∘ a`. -/
theorem isotropyHom_spec {x : X.Obj} {x' : Y.Obj} {x'' : d.A.Obj} (a : X.Mor)
    (ha : X.X.src a = d.F.obj x'') (ha' : X.X.tgt a = x) (b : Y.Mor)
    (hb : Y.X.src b = d.Φ.obj x'') (hb' : Y.X.tgt b = x') (g : X.X.Isotropy x) :
    ∃ k : d.A.X.Isotropy x'',
      d.F.mor k.val = X.X.comp (X.X.comp (X.X.inv a) g.val) a ∧
      (d.isotropyHom a ha ha' b hb hb' g).val =
        Y.X.comp (Y.X.comp b (d.Φ.mor k.val)) (Y.X.inv b) := by
  set e := MulEquiv.ofBijective _ (d.isEquivalence_F.bijective_isotropyHom x'')
  set c := X.X.isotropyConj (X.X.inv a) (by rw [GroupoidStr.src_inv, ha'])
    (by rw [GroupoidStr.tgt_inv, ha]) g
  refine ⟨e.symm c, ?_, rfl⟩
  have h1 : d.F.isotropyHom x'' (e.symm c) = c := e.apply_symm_apply c
  have h2 := congrArg GroupoidStr.Isotropy.val h1
  rw [EpFunctor.isotropyHom_val] at h2
  rw [h2, GroupoidStr.isotropyConj_val, GroupoidStr.inv_inv]

/-- If `ψ` is an equivalence too (the case of a generalized isomorphism), `γ` is a group
isomorphism. -/
theorem bijective_isotropyHom (hΦ : d.Φ.IsEquivalence) {x : X.Obj} {x' : Y.Obj} {x'' : d.A.Obj}
    (a : X.Mor) (ha : X.X.src a = d.F.obj x'') (ha' : X.X.tgt a = x) (b : Y.Mor)
    (hb : Y.X.src b = d.Φ.obj x'') (hb' : Y.X.tgt b = x') :
    Bijective (d.isotropyHom a ha ha' b hb hb') :=
  (Y.X.isotropyConj b hb hb').bijective.comp ((hΦ.bijective_isotropyHom x'').comp
    ((MulEquiv.ofBijective _ (d.isEquivalence_F.bijective_isotropyHom x'')).symm.bijective.comp
      (X.X.isotropyConj (X.X.inv a) _ _).bijective))

/-- **The data of `γ` exist** (2021 p. 505): if `|[d]|(|x|) = |x'|`, there are `x''` and
morphisms `a : φ(x'') → x`, `b : ψ(x'') → x'`. -/
theorem exists_isotropyData {x : X.Obj} {x' : Y.Obj} (h : d.orbitMap (X.X.π x) = Y.X.π x') :
    ∃ (x'' : d.A.Obj) (a : X.Mor) (b : Y.Mor), X.X.src a = d.F.obj x'' ∧ X.X.tgt a = x ∧
      Y.X.src b = d.Φ.obj x'' ∧ Y.X.tgt b = x' := by
  obtain ⟨x'', a, ha, ha'⟩ := d.isEquivalence_F.exists_iso x
  have hq : d.F.orbitMap (d.A.X.π x'') = X.X.π x := by
    rw [GroupoidFunctor.orbitMap_π]
    exact X.X.π_eq_π_iff.2 ⟨a, ha, ha'⟩
  have h' := (orbitMap_eq_of hq).symm.trans h
  rw [GroupoidFunctor.orbitMap_π] at h'
  obtain ⟨b, hb, hb'⟩ := Y.X.π_eq_π_iff.1 h'
  exact ⟨x'', a, b, ha, ha', hb, hb'⟩

end EPLocalization.Diagram

/-! ### Generalized strong bundle maps; Definitions 10.5.1 and 10.5.2 -/

namespace SBLocalization

open EPLocalization

variable {A A' : SEP.{u}}

/-- **A generalized strong bundle map `[D] : W → W'`** (2021 p. 504): the class of a diagram
`D : W ←Φ W'' →Ψ W'` for the equivalence of diagrams (common refinements), taken in `Quot`, i.e.
for the equivalence relation generated by `SDiagram.Equiv` (see the module docstring). -/
def GenSBMap (A A' : SEP.{u}) : Type (u + 1) := Quot (SDiagram.Equiv (A := A) (A' := A'))

namespace SDiagram

/-- The class `[D]`. -/
def cls (D : SDiagram A A') : GenSBMap A A' := Quot.mk _ D

theorem cls_eq_cls_of_equiv {D D' : SDiagram A A'} (h : Equiv D D') : D.cls = D'.cls :=
  Quot.sound h

theorem cls_surjective (f : GenSBMap A A') : ∃ D : SDiagram A A', D.cls = f :=
  Quot.exists_rep f

/-- The diagram `1_W = W ←1 W →1 W`. -/
def id (A : SEP.{u}) : SDiagram A A := ⟨A, 𝟙 A, SEP.equivalences.id_mem A, 𝟙 A⟩

/-- The diagram `W ←1 W →Ψ W'` of a strong bundle functor (a morphism of `SEP`). -/
def ofHom (Ψ : A ⟶ A') : SDiagram A A' := ⟨A, 𝟙 A, SEP.equivalences.id_mem A, Ψ⟩

/-- The reversed diagram `W' ←Ψ W'' →Φ W` of a diagram whose `Ψ` is a strong bundle
equivalence (the inverse diagram of Theorem 10.5.4). -/
def symm (D : SDiagram A A') (hΨ : SEP.equivalences D.Ψ) : SDiagram A' A :=
  ⟨D.B, D.Ψ, hΨ, D.Φ⟩

end SDiagram

namespace GenSBMap

/-- **`[D]` covers `[d]`** (2021 p. 504): the generalized map `[d] : X → X'` of the underlying
ep-groupoids (Definition 10.3.9), well defined on classes. -/
def base (f : GenSBMap A A') : EPLoc.of A.baseEP ⟶ EPLoc.of A'.baseEP :=
  Quot.lift (fun D : SDiagram A A' => EPLoc.homMk D.base)
    (fun _ _ h => EPLoc.homMk_eq_homMk_iff.2 h.base) f

@[simp] theorem base_cls (D : SDiagram A A') : D.cls.base = EPLoc.homMk D.base := rfl

/-- The generalized map `(W, 𝐖) → (W', 𝐖')` of the total-space ep-groupoids. -/
def total (f : GenSBMap A A') : EPLoc.of A.totalEP ⟶ EPLoc.of A'.totalEP :=
  Quot.lift (fun D : SDiagram A A' => EPLoc.homMk D.total)
    (fun _ _ h => EPLoc.homMk_eq_homMk_iff.2 h.total) f

@[simp] theorem total_cls (D : SDiagram A A') : D.cls.total = EPLoc.homMk D.total := rfl

/-- **`|[D]| = |Ψ| ∘ |Φ|⁻¹ : |W| → |W'|`** (2021 p. 504): it does not depend on the
representative. -/
def orbitMap (f : GenSBMap A A') : A.E.toEpGroupoid.OrbitSpace → A'.E.toEpGroupoid.OrbitSpace :=
  Quot.lift SDiagram.orbitMap (fun _ _ h => h.orbitMap_eq) f

@[simp] theorem orbitMap_cls (D : SDiagram A A') : D.cls.orbitMap = D.orbitMap := rfl

theorem orbitMap_eq_total (f : GenSBMap A A') : f.orbitMap = EPLoc.orbitMap f.total :=
  Quot.inductionOn f fun _ => rfl

theorem continuous_orbitMap (f : GenSBMap A A') : Continuous f.orbitMap :=
  Quot.inductionOn (motive := fun f : GenSBMap A A' => Continuous f.orbitMap) f
    fun D => D.continuous_orbitMap

/-- **The commutative diagram `|D|`** (2021 p. 505) on classes: `|P'| ∘ |[D]| = |[d]| ∘ |P|`. -/
theorem orbitMap_square (f : GenSBMap A A') :
    A'.E.projFunctor.orbitMap ∘ f.orbitMap = EPLoc.orbitMap f.base ∘ A.E.projFunctor.orbitMap :=
  Quot.inductionOn (motive := fun f : GenSBMap A A' =>
    A'.E.projFunctor.orbitMap ∘ f.orbitMap = EPLoc.orbitMap f.base ∘ A.E.projFunctor.orbitMap) f
    fun D => D.orbitMap_square

/-- **2021 Definition 10.5.2, p. 506 (2017: Definition 10.15, p. 366)**: a generalized strong
bundle map is a **generalized strong bundle isomorphism** if it is the class of a diagram
`W ←Φ W'' →Ψ W'` in which both `Φ` and `Ψ` are strong bundle equivalences. -/
def IsGeneralizedIso (f : GenSBMap A A') : Prop :=
  ∃ D : SDiagram A A', D.cls = f ∧ SEP.equivalences D.Ψ

/-- **2021 Remark 10.5.3, p. 506 (new in the 2021 edition)**, the comparison with Theorem 10.3.10:
a generalized strong bundle isomorphism covers a generalized isomorphism of the base
ep-groupoids, and induces one of the total-space ep-groupoids; its map of orbit spaces is a
homeomorphism. -/
theorem remark_10_5_3 {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) :
    EPLoc.IsGeneralizedIso f.base ∧ EPLoc.IsGeneralizedIso f.total ∧ IsHomeomorph f.orbitMap := by
  obtain ⟨D, rfl, hΨ⟩ := hf
  exact ⟨(EPLoc.theorem_10_3_10 D.base).1.2 hΨ.isEquivalence_base,
    (EPLoc.theorem_10_3_10 D.total).1.2 hΨ.isEquivalence,
    D.total.isHomeomorph_orbitMap hΨ.isEquivalence⟩

/-- The class of the reversed diagram of a representative with both legs equivalences is a
generalized strong bundle isomorphism `W' → W`. -/
theorem isGeneralizedIso_symm (D : SDiagram A A') (hΨ : SEP.equivalences D.Ψ) :
    (D.symm hΨ).cls.IsGeneralizedIso :=
  ⟨D.symm hΨ, rfl, D.isEquivalence_Φ⟩

/-- `i(Ψ) = [W ←1 W →Ψ W']` is a generalized strong bundle isomorphism for a strong bundle
equivalence `Ψ`. -/
theorem isGeneralizedIso_ofHom {Ψ : A ⟶ A'} (hΨ : SEP.equivalences Ψ) :
    (SDiagram.ofHom Ψ).cls.IsGeneralizedIso :=
  ⟨SDiagram.ofHom Ψ, rfl, hΨ⟩

end GenSBMap

/-- **2021 Definition 10.5.1, p. 506 (2017: Definition 10.14, p. 366)**: the objects of
`SEP(F⁻¹)`, the strong bundles over ep-groupoids (a one-field structure around `SEP`). -/
structure SEPLoc : Type (u + 1) where
  /-- A strong bundle over an ep-groupoid as an object of `SEP(F⁻¹)`. -/
  of ::
  /-- The strong bundle underlying an object of `SEP(F⁻¹)`. -/
  toSEP : SEP.{u}

namespace SEPLoc

/-- **2021 Definition 10.5.1**: the morphisms of `SEP(F⁻¹)`, the generalized strong bundle maps.
(The composition is not constructed; see the module docstring.) -/
instance : Quiver SEPLoc.{u} where
  Hom X Y := GenSBMap X.toSEP Y.toSEP

/-- The identity `[1_W] = [W ←1 W →1 W]`. -/
def idHom (X : SEPLoc.{u}) : X ⟶ X := (SDiagram.id X.toSEP).cls

/-- The map `i : SEP → SEP(F⁻¹)` on objects and morphisms, `Ψ ↦ [W ←1 W →Ψ W']` (the analog of
Theorem 10.3.14). -/
def localizationPrefunctor : SEP.{u} ⥤q SEPLoc.{u} where
  obj A := of A
  map Ψ := (SDiagram.ofHom Ψ).cls

theorem localizationPrefunctor_map_id (A : SEP.{u}) :
    localizationPrefunctor.map (𝟙 A) = idHom (of A) := rfl

end SEPLoc

end SBLocalization

end Polyfold
