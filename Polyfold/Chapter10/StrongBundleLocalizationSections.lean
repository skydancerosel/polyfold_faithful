import Polyfold.Chapter10.StrongBundleLocalization

/-!
Hofer–Wysocki–Zehnder, *Polyfold and Fredholm Theory* (Springer 2021; 2017 arXiv 1707.08941),
Part II, Chapter 10, §10.5 "Localization in the Strong Bundle Case" (pp. 507–508; 2017: p. 367):
**Theorem 10.5.4** (2017: Theorem 10.9), the positive half of **Remark 10.5.5**, and the reduction
behind **Proposition 10.5.6** (Remark 10.5.5 and Proposition 10.5.6 are new in the 2021 edition).
Numbers and pages are the 2021 text's, the 2017 ones in parentheses.  The diagrams and
Definitions 10.5.1, 10.5.2 are in `StrongBundleLocalization.lean`, the witnesses in
`StrongBundleLocalizationExamples.lean`.

# Push-forward and pull-back of section functors

## The text, paraphrased

(p. 507) For a generalized strong bundle isomorphism `[D] : (P, μ) → (P', μ')` and a
representative `W ←Φ W'' →Ψ W'` with both legs strong bundle equivalences, `[D]_* f = Ψ_* Φ* f`
and `[D]* g = Φ_* Ψ* g`.  The definition is independent of the representative: for a refinement
`H : W''' → W''` one has `Ψ_* Φ* f = Ψ_* H_* H* Φ* f = (Ψ ∘ H)_* (Φ ∘ H)* f = Ψ'_* Φ'* f` by
Propositions 10.4.2–10.4.4.  By Theorem 10.4.5 both preserve sc⁺- and sc-Fredholm section
functors.  (Theorem 10.5.4, pp. 507–508) `[D]_* : Γ(P, μ) → Γ(P', μ')` is a well-defined
isomorphism whose inverse is given by the inverse diagram and equals `[D]*`; the same holds on
`Γ⁺` and on `Fred`; and `|[D]| = |[D']|` implies `[D]_* = [D']_*` and `[D]* = [D']*`.
(Remark 10.5.5, p. 508) `|D| = |D'|` does not in general give `[D] = [D']`, but it gives
`[D]_* = [D']_*`, `[D]* = [D']*`.  (Proposition 10.5.6) The local regularity property
(Definition 8.4.2) passes along generalized strong bundle isomorphisms (as in the ep-groupoid
case, with Proposition 10.4.7).  (Theorem 10.5.7) If both strong bundles have the local
regularity property, `|[D]| = |[D']|` implies `[D] = [D']` (from Proposition 10.4.7).

## What is formalized (namespace `Polyfold.SBLocalization`)

* `EpStrongBundle.π_μ`, `π_eq_π_of_isFunctorialSection`, and `eq_of_forall_π_eq`: a section
  functor is determined by the orbits of its values in `(W, 𝐖)`.
* `SDiagram.pushforward` (`Ψ_* Φ* f`), `SDiagram.pullback` (`Φ_* Ψ* g`, the push-forward along the
  reversed diagram), with `mapsTo_*`, `invOn_pullback_pushforward`, `bijOn_pushforward(_plus)`.
* `SDiagram.π_pushforward`: `|[D]_* f (x')| = |D|(|f(x)|)` whenever `|d|(|x|) = |x'|`;
  `base_orbitMap_eq_of_orbitMap_eq` (`|d|` is determined by `|D|`);
  `pushforward_eq_of_orbitMap_eq`, `pullback_eq_of_orbitMap_eq`: **diagrams with the same `|D|`
  have the same push-forward and pull-back**.
* `SDiagram.pushforward_eq_of_isRefinement`: the text's argument through Propositions
  10.4.2–10.4.4, proved as printed.
* `GenSBMap.pushforward`, `GenSBMap.pullback` (`[D]_*`, `[D]*`), `pushforward_eq`, `pullback_eq`,
  and **Theorem 10.5.4**: `GenSBMap.theorem_10_5_4` (well defined for every representative with
  both legs equivalences; mutually inverse bijections of `Γ`; `[D⁻¹]_* = [D]*`; the same on
  `Γ⁺`; `|[D]| = |[D']|` implies `[D]_* = [D']_*` and `[D]* = [D']*`).  Its last part is the
  positive half of **Remark 10.5.5**.
* `GenSBMap.iff_of_isGeneralizedIso`: a property of strong bundles invariant under strong bundle
  equivalences is invariant under generalized strong bundle isomorphisms (the argument of
  Proposition 10.5.6; the analogue of `EPLoc.iff_of_isGeneralizedIso`).

## What the text leaves implicit, and the choices made

* **Independence of the representative.**  The classes are taken in the quotient by the
  equivalence relation generated by "having a common refinement" (see
  `StrongBundleLocalization.lean`).  Independence is proved through orbit spaces: a section
  functor `g` is determined by the orbits `|g(x')|` (isotropy fixes `g(x')`), and
  `|[D]_* f (x')| = |D|(|f(x)|)`, while `|D|` is an invariant of the class.  This proves more than
  the text's step (equal push-forwards for any two diagrams with `|D| = |D'|`), and makes the
  last assertion of Theorem 10.5.4 and of Remark 10.5.5 immediate.  The text's own step for a
  refinement is `pushforward_eq_of_isRefinement`.
* "Isomorphism" of the vector spaces `Γ` is read here as mutually inverse bijections, since
  `Γ(P, μ)` is a set of maps `X → W` (Chapter 8 proves closure under the operations).  Since
  2026-11-09 the linear isomorphism is `GenSBMap.pushforwardEquiv`, with `Γ(P, μ)` realised as a
  submodule of `Π_x W_x` (`EpStrongBundle.sectionSpace`, `SectionFunctorLinear2021.lean`).
* `[D]_*` is defined with a representative chosen once (`GenSBMap.rep`), and
  `theorem_10_5_4` shows it equals `Ψ_* Φ* f` for every representative.

## Not formalized

* The `Fred` part of Theorem 10.5.4 is not in this file: it is `theorem_10_5_4_fred`
  (`FredholmEquivalence.lean`, with `theorem_10_4_5_fred` for Theorem 10.4.5).
* **Proposition 10.5.6**: `iff_of_isGeneralizedIso` reduces it to Proposition 10.4.6 (the local
  regularity property under strong bundle equivalences), as the text does; both are formalized
  since 2026-11-12, with Definition 8.4.2 read as `IsLRLocal`: `SBLocalization.proposition_10_5_6`
  and `EpStrongBundle.proposition_10_4_6` (`GapP2_GBundleLR.lean`).
* **Theorem 10.5.7**: it rests on Proposition 10.4.7 (formalized since 2026-11-12,
  `EpStrongBundle.proposition_10_4_7`, `GapP2_GBundleFamily.lean`), and turning the
  local morphisms `α_z` into a common refinement of two diagrams needs the weak fibred product of
  strong bundles over ep-groupoids, which the repository does not have.  The ep-groupoid
  analogue, Theorem 10.3.19, is not formalized either.
* The negative half of Remark 10.5.5 is in `StrongBundleLocalizationExamples.lean`.
-/

set_option maxSynthPendingDepth 3

open Set Function Topology Filter CategoryTheory

noncomputable section

namespace Polyfold

universe u

/-! ### Section functors and orbits -/

section Orbits

variable {Obj Mor : Type u} [TopologicalSpace Obj] [T2Space Obj] [ParacompactSpace Obj]
  [TopologicalSpace Mor] [T2Space Mor] [ParacompactSpace Mor] {X : EpGroupoid Obj Mor}
  {W : Type u} [TopologicalSpace W] [T2Space W] [ParacompactSpace W] {P : W → Obj}
  [∀ x, AddCommGroup (P ⁻¹' {x})] [∀ x, Module ℝ (P ⁻¹' {x})] {B : StrongBundle X.PObj P}
  [ParacompactSpace (pullbackSpace P X.src)] {E : EpStrongBundle X B}

namespace EpStrongBundle

/-- `|μ(σ, w)| = |w|`: `(σ, w) : w → μ(σ, w)` is a morphism of `(W, 𝐖)`. -/
theorem π_μ (E : EpStrongBundle X B) (q : pullbackSpace P X.src) :
    E.toEpGroupoid.π (E.μ q) = E.toEpGroupoid.π (q : Mor × W).2 :=
  ((GroupoidStr.π_eq_π_iff _).2 ⟨q, rfl, rfl⟩).symm

/-- A section functor maps isomorphic objects to isomorphic points of `(W, 𝐖)`: for `k : x → y`,
`(k, f(x)) : f(x) → μ(k, f(x)) = f(y)`. -/
theorem π_eq_π_of_isFunctorialSection {f : Obj → W} {hf : IsSection P f}
    (hfun : E.IsFunctorialSection hf) {x y : Obj} (h : X.π x = X.π y) :
    E.toEpGroupoid.π (f x) = E.toEpGroupoid.π (f y) := by
  obtain ⟨k, hk, hk'⟩ := X.π_eq_π_iff.1 h
  refine (GroupoidStr.π_eq_π_iff _).2 ⟨sectionPair hf k, ?_, ?_⟩
  · change f (X.src k) = f x
    rw [hk]
  · change E.μ (sectionPair hf k) = f y
    rw [← hfun k, hk']

/-- **A section functor is determined by the orbits of its values**: if `f(x)` and `g(x)` lie in
one orbit of `(W, 𝐖)` for every `x`, then `f = g`.  A morphism `(σ, f(x)) : f(x) → g(x)` has
`σ ∈ G_x`, and `f(x) = μ(σ, f(x))` since `f` is functorial. -/
theorem eq_of_forall_π_eq {f g : Obj → W} {hf : IsSection P f} (hfun : E.IsFunctorialSection hf)
    (hg : IsSection P g) (h : ∀ x, E.toEpGroupoid.π (f x) = E.toEpGroupoid.π (g x)) : f = g := by
  funext x
  obtain ⟨q, hs, ht⟩ := (GroupoidStr.π_eq_π_iff _).1 (h x)
  have hs' : (q : Mor × W).2 = f x := hs
  have ht' : E.μ q = g x := ht
  have hsσ : X.src (q : Mor × W).1 = x := by
    rw [← (q.2 : P (q : Mor × W).2 = X.src (q : Mor × W).1), hs', hf x]
  have htσ : X.tgt (q : Mor × W).1 = x := by rw [← E.P_μ q, ht', hg x]
  calc f x = f (X.tgt (q : Mor × W).1) := by rw [htσ]
    _ = E.μ (sectionPair hf (q : Mor × W).1) := hfun _
    _ = E.μ q := E.μ_congr (Prod.ext rfl (by
          change f (X.src (q : Mor × W).1) = (q : Mor × W).2
          rw [hsσ, hs']))
    _ = g x := ht'

end EpStrongBundle

end Orbits

namespace SBLocalization

open EPLocalization

variable {A A' : SEP.{u}}

/-- A morphism of `SEP` in the class `F` is a strong bundle equivalence. -/
theorem sbe {F : A ⟶ A'} (h : SEP.equivalences F) :
    A.E.IsStrongBundleEquivalence A'.E (SEP.Hom.ϕ F) (SEP.Hom.Φ F) :=
  h

namespace SDiagram

/-! ### Push-forward and pull-back along a diagram of strong bundle equivalences -/

/-- **The push-forward `[D]_* f = Ψ_* Φ* f`** (2021 p. 507) along a diagram `D` whose `Ψ` is a
strong bundle equivalence too. -/
def pushforward (D : SDiagram A A') (hΨ : SEP.equivalences D.Ψ) (f : A.Obj → A.W) :
    A'.Obj → A'.W :=
  (sbe hΨ).pushforward (D.hΦ.pullback f)

/-- **The pull-back `[D]* g = Φ_* Ψ* g`** (2021 p. 507), the push-forward along the reversed
diagram. -/
def pullback (D : SDiagram A A') (hΨ : SEP.equivalences D.Ψ) (g : A'.Obj → A'.W) :
    A.Obj → A.W :=
  (D.symm hΨ).pushforward D.isEquivalence_Φ g

theorem pullback_def (D : SDiagram A A') (hΨ : SEP.equivalences D.Ψ) (g : A'.Obj → A'.W) :
    D.pullback hΨ g = D.hΦ.pushforward ((sbe hΨ).pullback g) := rfl

variable (D : SDiagram A A') (hΨ : SEP.equivalences D.Ψ)

theorem mapsTo_pushforward :
    MapsTo (D.pushforward hΨ) A.E.sectionFunctors A'.E.sectionFunctors :=
  (EpStrongBundle.theorem_10_4_5 (sbe hΨ)).1.1.comp
    (EpStrongBundle.theorem_10_4_5 D.hΦ).1.2.1

theorem mapsTo_pushforward_plus :
    MapsTo (D.pushforward hΨ) A.E.plusSectionFunctors A'.E.plusSectionFunctors :=
  (EpStrongBundle.theorem_10_4_5 (sbe hΨ)).2.2.1.comp
    (EpStrongBundle.theorem_10_4_5 D.hΦ).2.2.2

theorem mapsTo_pullback :
    MapsTo (D.pullback hΨ) A'.E.sectionFunctors A.E.sectionFunctors :=
  (D.symm hΨ).mapsTo_pushforward D.isEquivalence_Φ

theorem mapsTo_pullback_plus :
    MapsTo (D.pullback hΨ) A'.E.plusSectionFunctors A.E.plusSectionFunctors :=
  (D.symm hΨ).mapsTo_pushforward_plus D.isEquivalence_Φ

/-- `[D]* ∘ [D]_* = 1` and `[D]_* ∘ [D]* = 1` on section functors (Theorem 10.4.5 for `Φ`
and `Ψ`). -/
theorem invOn_pullback_pushforward :
    InvOn (D.pullback hΨ) (D.pushforward hΨ) A.E.sectionFunctors A'.E.sectionFunctors := by
  have h₁ := (EpStrongBundle.theorem_10_4_5 D.hΦ).1
  have h₂ := (EpStrongBundle.theorem_10_4_5 (sbe hΨ)).1
  refine ⟨fun f hf => ?_, fun g hg => ?_⟩
  · change D.hΦ.pushforward ((sbe hΨ).pullback ((sbe hΨ).pushforward (D.hΦ.pullback f))) = f
    rw [h₂.2.2.1.1 (h₁.2.1 hf), h₁.2.2.1.2 hf]
  · change (sbe hΨ).pushforward (D.hΦ.pullback (D.hΦ.pushforward ((sbe hΨ).pullback g))) = g
    rw [h₁.2.2.1.1 (h₂.2.1 hg), h₂.2.2.1.2 hg]

theorem bijOn_pushforward :
    BijOn (D.pushforward hΨ) A.E.sectionFunctors A'.E.sectionFunctors :=
  (D.invOn_pullback_pushforward hΨ).bijOn (D.mapsTo_pushforward hΨ) (D.mapsTo_pullback hΨ)

theorem bijOn_pushforward_plus :
    BijOn (D.pushforward hΨ) A.E.plusSectionFunctors A'.E.plusSectionFunctors :=
  ((D.invOn_pullback_pushforward hΨ).mono A.E.plusSectionFunctors_subset
    A'.E.plusSectionFunctors_subset).bijOn (D.mapsTo_pushforward_plus hΨ)
    (D.mapsTo_pullback_plus hΨ)

/-! ### The push-forward through the orbit spaces -/

/-- `|d|(|φ(a)|) = |x'|` for the chosen `a` and `σ : ψ(a) → x'` of the push-forward along `Ψ`. -/
theorem base_orbitMap_preObj (x' : A'.Obj) :
    D.base.orbitMap (A.X.π ((SEP.Hom.ϕ D.Φ).obj ((sbe hΨ).preObj x'))) = A'.X.π x' := by
  refine (Diagram.orbitMap_eq_of (r := D.B.X.π ((sbe hΨ).preObj x')) ?_).trans ?_
  · change (SEP.Hom.ϕ D.Φ).orbitMap _ = _
    rw [GroupoidFunctor.orbitMap_π]
  · change (SEP.Hom.ϕ D.Ψ).orbitMap _ = _
    rw [GroupoidFunctor.orbitMap_π]
    exact A'.X.π_eq_π_iff.2 ⟨(sbe hΨ).preMor x', (sbe hΨ).src_preMor x', (sbe hΨ).tgt_preMor x'⟩

/-- **The push-forward through the orbit spaces**: for `f ∈ Γ(P, μ)` and `x ∈ X`, `x' ∈ X'` with
`|[d]|(|x|) = |x'|`, the orbit of `([D]_* f)(x')` is `|[D]|(|f(x)|)`. -/
theorem π_pushforward {f : A.Obj → A.W} (hf : f ∈ A.E.sectionFunctors) {x : A.Obj} {x' : A'.Obj}
    (hx : D.base.orbitMap (A.X.π x) = A'.X.π x') :
    A'.E.toEpGroupoid.π (D.pushforward hΨ f x') = D.orbitMap (A.E.toEpGroupoid.π (f x)) := by
  obtain ⟨hs, hfun⟩ := hf
  set a := (sbe hΨ).preObj x'
  set h := D.hΦ.pullback f
  have hh : IsSection D.B.P h := D.hΦ.isSection_pullback f
  -- `|φ(a)| = |x|`, since `|d|` is injective
  have hxa : A.X.π x = A.X.π ((SEP.Hom.ϕ D.Φ).obj a) :=
    (D.base.isHomeomorph_orbitMap (sbe hΨ).isEquivalence_base).injective
      (hx.trans (D.base_orbitMap_preObj hΨ x').symm)
  -- `|D|(|f(x)|) = |Ψ(h(a))|`
  have h₁ : D.orbitMap (A.E.toEpGroupoid.π (f x)) =
      A'.E.toEpGroupoid.π ((SEP.Hom.Φ D.Ψ).obj (h a)) := by
    refine (Diagram.orbitMap_eq_of (d := D.total) (r := D.B.E.toEpGroupoid.π (h a)) ?_).trans ?_
    · change (SEP.Hom.Φ D.Φ).orbitMap _ = _
      rw [GroupoidFunctor.orbitMap_π, D.hΦ.obj_pullback hs.1]
      exact (EpStrongBundle.π_eq_π_of_isFunctorialSection hfun hxa).symm
    · change (SEP.Hom.Φ D.Ψ).orbitMap _ = _
      rw [GroupoidFunctor.orbitMap_π]
  rw [h₁]
  -- `([D]_* f)(x') = μ'(σ, Ψ(h(a)))`
  change A'.E.toEpGroupoid.π ((sbe hΨ).pushforward h x') = _
  rw [(sbe hΨ).pushforward_def hh]
  exact A'.E.π_μ _

/-- `|d|` is determined by `|D|`: `|P'| ∘ |D| = |d| ∘ |P|` with `|P|` surjective. -/
theorem base_orbitMap_eq_of_orbitMap_eq {D₁ D₂ : SDiagram A A'} (h : D₁.orbitMap = D₂.orbitMap) :
    D₁.base.orbitMap = D₂.base.orbitMap := by
  funext q
  obtain ⟨r, rfl⟩ := A.E.surjective_orbitMap_projFunctor q
  have h₁ := congrFun D₁.orbitMap_square r
  have h₂ := congrFun D₂.orbitMap_square r
  simp only [Function.comp_apply] at h₁ h₂
  rw [← h₁, ← h₂, h]

/-- **`|[D]| = |[D']|` implies `[D]_* = [D']_*`** (2021 Theorem 10.5.4, last assertion), for
representatives with both legs strong bundle equivalences. -/
theorem pushforward_eq_of_orbitMap_eq {D₁ D₂ : SDiagram A A'} (hΨ₁ : SEP.equivalences D₁.Ψ)
    (hΨ₂ : SEP.equivalences D₂.Ψ) (h : D₁.orbitMap = D₂.orbitMap) :
    EqOn (D₁.pushforward hΨ₁) (D₂.pushforward hΨ₂) A.E.sectionFunctors := by
  intro f hf
  have hb := base_orbitMap_eq_of_orbitMap_eq h
  obtain ⟨hs₁, hfun₁⟩ := D₁.mapsTo_pushforward hΨ₁ hf
  obtain ⟨hs₂, -⟩ := D₂.mapsTo_pushforward hΨ₂ hf
  refine EpStrongBundle.eq_of_forall_π_eq hfun₁ hs₂.1 fun x' => ?_
  set x := (SEP.Hom.ϕ D₁.Φ).obj ((sbe hΨ₁).preObj x')
  have hx₁ : D₁.base.orbitMap (A.X.π x) = A'.X.π x' := D₁.base_orbitMap_preObj hΨ₁ x'
  have hx₂ : D₂.base.orbitMap (A.X.π x) = A'.X.π x' := by rw [← hb]; exact hx₁
  rw [D₁.π_pushforward hΨ₁ hf hx₁, D₂.π_pushforward hΨ₂ hf hx₂, h]

/-- `|D⁻¹| ∘ |D| = 1`: the orbit map of the reversed diagram is the inverse of `|D|`. -/
theorem orbitMap_symm_orbitMap (q : A.E.toEpGroupoid.OrbitSpace) :
    (D.symm hΨ).orbitMap (D.orbitMap q) = q := by
  obtain ⟨r, rfl⟩ := D.hΦ.isEquivalence.isHomeomorph_orbitMap.surjective q
  rw [orbitMap_orbitMap_Φ]
  exact (D.symm hΨ).orbitMap_orbitMap_Φ r

theorem orbitMap_orbitMap_symm (q : A'.E.toEpGroupoid.OrbitSpace) :
    D.orbitMap ((D.symm hΨ).orbitMap q) = q := by
  obtain ⟨r, rfl⟩ := (sbe hΨ).isEquivalence.isHomeomorph_orbitMap.surjective q
  have e := (D.symm hΨ).orbitMap_orbitMap_Φ r
  change (D.symm hΨ).orbitMap ((SEP.Hom.Φ D.Ψ).orbitMap r) = (SEP.Hom.Φ D.Φ).orbitMap r at e
  rw [e]
  exact D.orbitMap_orbitMap_Φ r

/-- `|D₁| = |D₂|` implies `|D₁⁻¹| = |D₂⁻¹|`. -/
theorem orbitMap_symm_eq {D₁ D₂ : SDiagram A A'} (hΨ₁ : SEP.equivalences D₁.Ψ)
    (hΨ₂ : SEP.equivalences D₂.Ψ) (h : D₁.orbitMap = D₂.orbitMap) :
    (D₁.symm hΨ₁).orbitMap = (D₂.symm hΨ₂).orbitMap := by
  funext q
  conv_lhs => rw [← D₂.orbitMap_orbitMap_symm hΨ₂ q, ← h]
  exact D₁.orbitMap_symm_orbitMap hΨ₁ _

/-- **`|[D]| = |[D']|` implies `[D]* = [D']*`** (2021 Theorem 10.5.4, last assertion). -/
theorem pullback_eq_of_orbitMap_eq {D₁ D₂ : SDiagram A A'} (hΨ₁ : SEP.equivalences D₁.Ψ)
    (hΨ₂ : SEP.equivalences D₂.Ψ) (h : D₁.orbitMap = D₂.orbitMap) :
    EqOn (D₁.pullback hΨ₁) (D₂.pullback hΨ₂) A'.E.sectionFunctors :=
  pushforward_eq_of_orbitMap_eq D₁.isEquivalence_Φ D₂.isEquivalence_Φ
    (orbitMap_symm_eq hΨ₁ hΨ₂ h)

/-- **The text's argument for the independence of the representative** (2021 p. 507): if `D'`
refines `D` by `H`, both with `Ψ`, `Ψ'` strong bundle equivalences, then
`Ψ'_* Φ'* f = (Ψ ∘ H)_* (Φ ∘ H)* f = Ψ_* H_* H* Φ* f = Ψ_* Φ* f` (Propositions 10.4.2–10.4.4). -/
theorem pushforward_eq_of_isRefinement {D D' : SDiagram A A'} (hΨ : SEP.equivalences D.Ψ)
    (hΨ' : SEP.equivalences D'.Ψ) (h : D'.IsRefinement D) :
    EqOn (D'.pushforward hΨ') (D.pushforward hΨ) A.E.sectionFunctors := by
  obtain ⟨H, hH, hΦH, hΨH⟩ := h
  intro f hf
  have hΦc : D'.B.E.IsStrongBundleEquivalence A.E (SEP.Hom.ϕ (H ≫ D.Φ)) (SEP.Hom.Φ (H ≫ D.Φ)) :=
    D.hΦ.comp (sbe hH)
  have hΨc : D'.B.E.IsStrongBundleEquivalence A'.E (SEP.Hom.ϕ (H ≫ D.Ψ)) (SEP.Hom.Φ (H ≫ D.Ψ)) :=
    (sbe hΨ).comp (sbe hH)
  have hk : D'.hΦ.pullback f ∈ D'.B.E.sectionFunctors :=
    (EpStrongBundle.theorem_10_4_5 D'.hΦ).1.2.1 hf
  have hk' : D.hΦ.pullback f ∈ D.B.E.sectionFunctors :=
    (EpStrongBundle.theorem_10_4_5 D.hΦ).1.2.1 hf
  -- `Φ'* f = (Φ ∘ H)* f = H* Φ* f` (Propositions 10.4.2, 10.4.4)
  have e₁ : hΦc.pullback f = D'.hΦ.pullback f :=
    EpStrongBundle.proposition_10_4_2 hΦc D'.hΦ hΦH.orbitMap_eq hf
  have e₂ : hΦc.pullback f = (sbe hH).pullback (D.hΦ.pullback f) :=
    (EpStrongBundle.proposition_10_4_4 (sbe hH) D.hΦ).1 f hf.1.1
  -- `Ψ'_* = (Ψ ∘ H)_* = Ψ_* H_*` (Propositions 10.4.3, 10.4.4)
  have e₃ : (sbe hΨ').pushforward (D'.hΦ.pullback f) = hΨc.pushforward (D'.hΦ.pullback f) :=
    (EpStrongBundle.proposition_10_4_3 hΨc (sbe hΨ') hΨH.orbitMap_eq hk).symm
  have e₄ : hΨc.pushforward (D'.hΦ.pullback f) =
      (sbe hΨ).pushforward ((sbe hH).pushforward (D'.hΦ.pullback f)) :=
    (EpStrongBundle.proposition_10_4_4 (sbe hH) (sbe hΨ)).2 _ hk.1.1 hk.2
  -- `H_* H* = 1` (Theorem 10.4.5)
  have e₅ : (sbe hH).pushforward ((sbe hH).pullback (D.hΦ.pullback f)) = D.hΦ.pullback f :=
    (sbe hH).pushforward_pullback hk'.1.1 hk'.2
  change (sbe hΨ').pushforward (D'.hΦ.pullback f) = (sbe hΨ).pushforward (D.hΦ.pullback f)
  rw [e₃, e₄, ← e₁, e₂, e₅]

end SDiagram

/-! ### Theorem 10.5.4 -/

namespace GenSBMap

/-- A representative of a generalized strong bundle isomorphism with both legs strong bundle
equivalences (Definition 10.5.2). -/
def rep {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) : SDiagram A A' := hf.choose

theorem cls_rep {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) : (rep hf).cls = f :=
  hf.choose_spec.1

theorem isEquivalence_rep_Ψ {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) :
    SEP.equivalences (rep hf).Ψ :=
  hf.choose_spec.2

/-- **The push-forward `[D]_* : Γ(P, μ) → Γ(P', μ')`** of a generalized strong bundle
isomorphism (2021 p. 507), `Ψ_* Φ* f` for a representative with both legs strong bundle
equivalences (chosen once; `pushforward_eq` shows the independence of the choice). -/
def pushforward {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) :
    (A.Obj → A.W) → A'.Obj → A'.W :=
  (rep hf).pushforward (isEquivalence_rep_Ψ hf)

/-- **The pull-back `[D]* : Γ(P', μ') → Γ(P, μ)`**, `Φ_* Ψ* g` (2021 p. 507). -/
def pullback {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) : (A'.Obj → A'.W) → A.Obj → A.W :=
  (rep hf).pullback (isEquivalence_rep_Ψ hf)

/-- `[D]_*` does not depend on the representative: it is `Ψ_* Φ* f` for every representative
with both legs strong bundle equivalences. -/
theorem pushforward_eq {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) {D : SDiagram A A'}
    (hD : D.cls = f) (hΨ : SEP.equivalences D.Ψ) :
    EqOn (pushforward hf) (D.pushforward hΨ) A.E.sectionFunctors :=
  SDiagram.pushforward_eq_of_orbitMap_eq _ hΨ (by
    rw [← orbitMap_cls, ← orbitMap_cls, cls_rep, hD])

theorem pullback_eq {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) {D : SDiagram A A'}
    (hD : D.cls = f) (hΨ : SEP.equivalences D.Ψ) :
    EqOn (pullback hf) (D.pullback hΨ) A'.E.sectionFunctors :=
  SDiagram.pullback_eq_of_orbitMap_eq _ hΨ (by
    rw [← orbitMap_cls, ← orbitMap_cls, cls_rep, hD])

/-- **2021 Theorem 10.5.4, pp. 507–508 (2017: Theorem 10.9, p. 367)**: for a generalized strong
bundle isomorphism `[D] : (P, μ) → (P', μ')`,
* `[D]_* f = Ψ_* Φ* f` and `[D]* g = Φ_* Ψ* g` for every representative `W ←Φ W'' →Ψ W'` with
  both legs strong bundle equivalences (well defined);
* `[D]_* : Γ(P, μ) → Γ(P', μ')` is a bijection with inverse `[D]*`;
* the inverse is given by the inverse diagram: `[D⁻¹]_* = [D]*`, `[D⁻¹] = [W' ←Ψ W'' →Φ W]`;
* the same holds for sc⁺-section functors `Γ⁺(P, μ) → Γ⁺(P', μ')`;
* if `[D']` is another generalized strong bundle isomorphism with `|[D]| = |[D']|`, then
  `[D]_* = [D']_*` and `[D]* = [D']*`.
The part on `Fred` is `theorem_10_5_4_fred` (`FredholmEquivalence.lean`); the linear isomorphism
is `GenSBMap.pushforwardEquiv` (`SectionFunctorLinear2021.lean`). -/
theorem theorem_10_5_4 {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) :
    (∀ (D : SDiagram A A') (hΨ : SEP.equivalences D.Ψ), D.cls = f →
      EqOn (pushforward hf) (D.pushforward hΨ) A.E.sectionFunctors ∧
      EqOn (pullback hf) (D.pullback hΨ) A'.E.sectionFunctors) ∧
    (MapsTo (pushforward hf) A.E.sectionFunctors A'.E.sectionFunctors ∧
      MapsTo (pullback hf) A'.E.sectionFunctors A.E.sectionFunctors ∧
      InvOn (pullback hf) (pushforward hf) A.E.sectionFunctors A'.E.sectionFunctors ∧
      BijOn (pushforward hf) A.E.sectionFunctors A'.E.sectionFunctors) ∧
    (∀ (D : SDiagram A A') (hΨ : SEP.equivalences D.Ψ) (_ : D.cls = f),
      EqOn (pushforward (isGeneralizedIso_symm D hΨ)) (pullback hf) A'.E.sectionFunctors) ∧
    (MapsTo (pushforward hf) A.E.plusSectionFunctors A'.E.plusSectionFunctors ∧
      MapsTo (pullback hf) A'.E.plusSectionFunctors A.E.plusSectionFunctors ∧
      BijOn (pushforward hf) A.E.plusSectionFunctors A'.E.plusSectionFunctors) ∧
    (∀ (f' : GenSBMap A A') (hf' : f'.IsGeneralizedIso), f.orbitMap = f'.orbitMap →
      EqOn (pushforward hf) (pushforward hf') A.E.sectionFunctors ∧
      EqOn (pullback hf) (pullback hf') A'.E.sectionFunctors) := by
  set D := rep hf
  set hΨ := isEquivalence_rep_Ψ hf
  refine ⟨fun D' hΨ' hD' => ⟨pushforward_eq hf hD' hΨ', pullback_eq hf hD' hΨ'⟩,
    ⟨D.mapsTo_pushforward hΨ, D.mapsTo_pullback hΨ, D.invOn_pullback_pushforward hΨ,
      D.bijOn_pushforward hΨ⟩, fun D' hΨ' hD' => ?_,
    ⟨D.mapsTo_pushforward_plus hΨ, D.mapsTo_pullback_plus hΨ, D.bijOn_pushforward_plus hΨ⟩,
    fun f' hf' h => ⟨?_, ?_⟩⟩
  · intro g hg
    rw [pushforward_eq (isGeneralizedIso_symm D' hΨ') rfl D'.isEquivalence_Φ hg,
      pullback_eq hf hD' hΨ' hg]
    rfl
  · exact SDiagram.pushforward_eq_of_orbitMap_eq hΨ (isEquivalence_rep_Ψ hf') (by
      rw [← orbitMap_cls, ← orbitMap_cls, cls_rep, cls_rep, h])
  · exact SDiagram.pullback_eq_of_orbitMap_eq hΨ (isEquivalence_rep_Ψ hf') (by
      rw [← orbitMap_cls, ← orbitMap_cls, cls_rep, cls_rep, h])

end GenSBMap

/-! ### Proposition 10.5.6: the reduction to strong bundle equivalences -/

/-- A property of strong bundles over ep-groupoids which is invariant under strong bundle
equivalences is invariant under generalized strong bundle isomorphisms (the argument of
Proposition 10.5.6: `W ←Φ W'' →Ψ W'` with `Φ`, `Ψ` strong bundle equivalences). -/
theorem GenSBMap.iff_of_isGeneralizedIso (Pr : SEP.{u} → Prop)
    (hPr : ∀ {C C' : SEP.{u}} (F : C ⟶ C'), SEP.equivalences F → (Pr C ↔ Pr C'))
    {f : GenSBMap A A'} (hf : f.IsGeneralizedIso) : Pr A ↔ Pr A' := by
  obtain ⟨D, -, hΨ⟩ := hf
  exact (hPr D.Φ D.isEquivalence_Φ).symm.trans (hPr D.Ψ hΨ)

end SBLocalization

