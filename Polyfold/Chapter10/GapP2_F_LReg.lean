import Polyfold.Chapter10.EquivalenceLR
import Polyfold.Chapter10.LocalizationCategory

/-!
Hofer–Wysocki–Zehnder, *Polyfold and Fredholm Theory* (Springer 2021), Part II, Chapter 10,
§10.1, p. 461 (new in the 2021 edition): **the full subcategory `EP_lreg`** of `EP` generated by
the ep-groupoids with the local regularity property (Definition 7.4.19), and the closing
sentence of the proof of Proposition 10.1.9 (p. 469): along an equivalence, membership in
`EP_lreg` passes from one side to the other.

## What is formalized

* `EP.lreg : ObjectProperty EP.{u}`, `X ↦ (LR) for X`, and `EP.Lreg := EP.lreg.FullSubcategory`
  with Mathlib's full subcategory structure: the inclusion `EP.lreg.ι` is fully faithful
  (`EP.fullyFaithful_ι_lreg`).
* `EP.lreg_iff_of_isEquivalence` (p. 469): for an equivalence `F : X → Y`, `X ∈ EP_lreg` iff
  `Y ∈ EP_lreg` (Proposition 10.1.9); `EP.lreg` is closed under the isomorphisms of `EP`
  (`EP.isClosedUnderIsomorphisms_lreg`, from (E1)).
* The same subcategory of `EP(E⁻¹)`: `EPLoc.lreg`, closed under the isomorphisms of `EP(E⁻¹)`
  (`EPLoc.isClosedUnderIsomorphisms_lreg`, by Theorem 10.3.10 and Proposition 10.1.9), and
  `EPLoc.lreg_A_of_lreg`: the middle ep-groupoid of a diagram out of an object of `EP_lreg` is
  in `EP_lreg`.
* Witness: the point ep-groupoid is an object (`EP.lreg_pointEP`, `EP.Lreg.point`).
-/

set_option maxSynthPendingDepth 3

open CategoryTheory

noncomputable section

namespace Polyfold

universe u

namespace EP

/-- **2021 §10.1, p. 461 (new in the 2021 edition)**: the property of an ep-groupoid to have the
local regularity property (LR) (Definition 7.4.19), the objects of `EP_lreg`. -/
def lreg : ObjectProperty EP.{u} := fun X => X.X.IsLR

/-- **2021 §10.1, p. 461 (new in the 2021 edition)**: the full subcategory `EP_lreg` of `EP`
generated by the ep-groupoids with the local regularity property. -/
abbrev Lreg : Type (u + 1) := EP.lreg.{u}.FullSubcategory

/-- `EP_lreg` is a full subcategory: the inclusion `EP_lreg → EP` is fully faithful. -/
def fullyFaithful_ι_lreg : EP.lreg.{u}.ι.FullyFaithful := EP.lreg.fullyFaithfulι

instance : EP.lreg.{u}.ι.Full := inferInstance
instance : EP.lreg.{u}.ι.Faithful := inferInstance

/-- **2021 p. 469 (end of the first half of the proof of Proposition 10.1.9)**: for an
equivalence `F : X → Y`, `X` is an object of `EP_lreg` iff `Y` is. -/
theorem lreg_iff_of_isEquivalence {X Y : EP.{u}} {F : X ⟶ Y} (hF : EpFunctor.IsEquivalence F) :
    EP.lreg X ↔ EP.lreg Y :=
  EpFunctor.proposition_10_1_9 hF

/-- `EP_lreg` is closed under the isomorphisms of `EP` (isomorphisms are equivalences, (E1)). -/
instance isClosedUnderIsomorphisms_lreg : EP.lreg.{u}.IsClosedUnderIsomorphisms where
  of_iso e h := (lreg_iff_of_isEquivalence (EPLocalization.isEquivalence_of_isIso e.hom)).1 h

/-- **Witness**: the point ep-groupoid has (LR). -/
theorem lreg_pointEP : EP.lreg EpGroupoid.Examples.pointEP :=
  EpGroupoid.Examples.isSLR_pointEP 0

/-- **Witness**: the point ep-groupoid as an object of `EP_lreg`. -/
def Lreg.point : EP.Lreg.{0} := ⟨EpGroupoid.Examples.pointEP, lreg_pointEP⟩

end EP

namespace EPLocalization.EPLoc

/-- The objects of `EP(E⁻¹)` with the local regularity property. -/
def lreg : ObjectProperty EPLoc.{u} := fun X => EP.lreg X.toEP

/-- The middle ep-groupoid `A` of a diagram `X ←F A →Φ Y` with `X ∈ EP_lreg` is in `EP_lreg`
(Proposition 10.1.9 for `F`). -/
theorem lreg_A_of_lreg {X Y : EP.{u}} (d : Diagram X Y) (hX : EP.lreg X) : EP.lreg d.A :=
  (EP.lreg_iff_of_isEquivalence d.isEquivalence_F).2 hX

/-- `EP_lreg` is closed under the isomorphisms of `EP(E⁻¹)`: by Theorem 10.3.10 an isomorphism
`[X ←F A →Φ Y]` has both legs equivalences, and Proposition 10.1.9 applies to each. -/
instance isClosedUnderIsomorphisms_lreg : EPLoc.lreg.{u}.IsClosedUnderIsomorphisms where
  of_iso {X Y} e h := by
    obtain ⟨d, hd⟩ := homMk_surjective (X := X.toEP) (Y := Y.toEP) e.hom
    have hΦ : d.Φ.IsEquivalence := (isIso_homMk_iff d).1 (hd ▸ inferInstance)
    exact (EP.lreg_iff_of_isEquivalence hΦ).1 (lreg_A_of_lreg d h)

end EPLocalization.EPLoc

end Polyfold
