import Polyfold.Chapter2.TangentBundle

/-!
Hofer–Wysocki–Zehnder, *Polyfold and Fredholm Theory* (Springer 2021), Part I, §2.3,
**Proposition 2.3.15 (2)**, p. 39, proved in Appendix 2.7.3, pp. 76–77 (2014 preprint:
Proposition 2.3.15 (preprint 2.19) (2); 2017 arXiv 1707.08941: Proposition 2.5 (2)): the projection `p : TX → X¹`
of the tangent bundle is open.

# The projection `p : TX → X¹` is open

## The text, paraphrased

(Proposition 2.3.15, p. 39) The topology on `TX` generated by the sets `(Tφ)⁻¹(W)`, `W` open in
`TO`, is Hausdorff, metrizable, and makes `p : TX → X¹` continuous and open.  (Appendix 2.7.3,
p. 77) For openness, `p((Tφ)⁻¹(W)) = φ⁻¹(π(W))` with `π : TO → O₁` the projection onto the first
factor; that `π` is open is stated without proof.

## What is formalized

* `ScRetraction.exists_isOpen_tangent_section` (the local step, the openness of `π`): for a
  retract `O = r(U)` and `(o, h) ∈ TO ∩ W`, `W` open in `TE₀ = E₁ × E₀`, there is an open
  `N ∋ o` of `E₁` such that every `o' ∈ N ∩ O₁` carries a vector `(o', h') ∈ TO ∩ W`, namely
  `h' = Dr(o') h`.  The map `o' ↦ Tr(o', h) = (o', Dr(o') h)` is continuous on `U₁` (`Tr` is
  sc⁰), maps `O₁` into `TO`, and sends `o` to `(o, h)` because `Dr(o) h = h` on `T_oO`.
* **`MPolyfold.isOpenMap_tangentProj`** (the global step): `p : TX → X¹` is an open map, for every
  M-polyfold.  An open `S ⊆ TX` around `α` is read in the tangent chart `Tφ` of a representative
  of `α` as `TO ∩ W`, and the open set `N` of the local step gives the basic open set
  `{y ∈ X¹ | y ∈ V, φ(y) ∈ N}` of `X¹` inside `p(S)`.
* `MPolyfold.proposition_2_3_15_two`: Proposition 2.3.15 (2) in full (continuous and open).

This makes the field `isOpenMap_tangentProj` of Chapter 7's `MPolyfold.SmoothRegular`
unnecessary and closes gap G.8 (row V2.20, "openness of `p` missing").  The hypotheses
`IsOpenMap tangentProj` of the §7.4 and §8.1 results can be discharged with
`MPolyfold.isOpenMap_tangentProj` (`Chapter7/ZhouFacts.lean`, `Chapter8/TangentZhouFacts.lean`).
-/

open Set Filter Topology Function

noncomputable section

namespace Polyfold

variable {E : ScBanach}

/-- **The local step of 2021 Proposition 2.3.15 (2)**: for a retract `O = r(U)` and a vector
`(o, h) ∈ TO` lying in an open set `W ⊆ TE₀`, there is an open neighbourhood `N` of `o` in `E₁`
such that every `o' ∈ N ∩ O₁` is the base point of a vector `(o', h') ∈ TO ∩ W`
(`h' = Dr(o') h`).  So `pr₁ : TO → O₁` is open at `(o, h)`. -/
theorem ScRetraction.exists_isOpen_tangent_section {C : Set (E 0)} (R : ScRetraction E C)
    {o : E 1} {h : E 0} (hoh : ((o, h) : E.tangent 0) ∈ R.tangent) {W : Set (E.tangent 0)}
    (hW : IsOpen W) (hoW : ((o, h) : E.tangent 0) ∈ W) :
    ∃ N : Set (E 1), IsOpen N ∧ o ∈ N ∧
      ∀ o' ∈ N ∩ E.lvlSet R.retract 1, ∃ h' : E 0, ((o', h') : E.tangent 0) ∈ R.tangent ∩ W := by
  have ho : o ∈ E.lvlSet R.retract 1 := R.fst_mem_of_mem_tangent hoh
  have hcont : ContinuousOn (fun z : E 1 => tangentMap R.U R ((z, h) : E.tangent 0))
      (E.lvlSet R.U 1) :=
    R.isSc1.tangentMap_isSc0.continuousOn_base.comp
      (continuous_id.prodMk continuous_const).continuousOn fun _ hz => hz
  obtain ⟨N, hN, hNeq⟩ := (continuousOn_iff'.1 hcont) W hW
  have hfix : tangentMap R.U R ((o, h) : E.tangent 0) = (o, h) := (R.mem_tangent_iff.1 hoh).2
  have hoU : o ∈ E.lvlSet R.U 1 := R.lvlSet_retract_subset 1 ho
  refine ⟨N, hN, ?_, fun o' ho' => ?_⟩
  · have : o ∈ (fun z : E 1 => tangentMap R.U R ((z, h) : E.tangent 0)) ⁻¹' W ∩
        E.lvlSet R.U 1 := ⟨by simp only [mem_preimage, hfix]; exact hoW, hoU⟩
    rw [hNeq] at this
    exact this.1
  · obtain ⟨ho'N, ho'O⟩ := ho'
    have ho'U : o' ∈ E.lvlSet R.U 1 := R.lvlSet_retract_subset 1 ho'O
    have hmem : o' ∈ (fun z : E 1 => tangentMap R.U R ((z, h) : E.tangent 0)) ⁻¹' W ∩
        E.lvlSet R.U 1 := by rw [hNeq]; exact ⟨ho'N, ho'U⟩
    have heq : tangentMap R.U R ((o', h) : E.tangent 0) = (o', scDeriv R.U R o' h) := by
      change (levelMap R 1 o', scDeriv R.U R o' h) = _
      rw [R.levelMap_one_eq_self ho'O]
    refine ⟨scDeriv R.U R o' h, ?_, ?_⟩
    · rw [← heq]; exact ⟨(o', h), ho'U, rfl⟩
    · rw [← heq]; exact hmem.1

namespace MPolyfold

universe u

variable {X : Type u} [TopologicalSpace X] [T2Space X] [ParacompactSpace X] (P : MPolyfold X)

/-- **2021 Proposition 2.3.15 (2), openness** (2014 Proposition 2.19 (2), 2017 Proposition 2.5 (2);
gap G.8): the projection `p : TX → X¹` of the tangent bundle of an M-polyfold is an open map. -/
theorem isOpenMap_tangentProj : IsOpenMap P.tangentProj := by
  intro S hS
  rw [isOpen_iff_mem_nhds]
  rintro _ ⟨α, hαS, rfl⟩
  obtain ⟨p, rfl⟩ := TangentSpace.exists_rep α
  set φ := p.φ with hφdef
  have hφ : P.IsChart φ := p.isChart
  obtain ⟨R, hR⟩ := φ.model.isScRetract
  have hTO : retractTangent φ.model.E φ.model.C φ.model.O = R.tangent := by
    rw [← hR, retractTangent_eq]
  -- `Tφ(S ∩ TV) = TO ∩ W`
  set χ := tangentChart hφ (TangentSpace.mk p) with hχ
  have hsub : S ∩ tangentChartSet φ ⊆ χ.source := inter_subset_right
  obtain ⟨W, hW, hWeq⟩ : ∃ W : Set (φ.model.E.tangent 0), IsOpen W ∧
      tangentChartMap hφ '' (S ∩ tangentChartSet φ) = R.tangent ∩ W := by
    obtain ⟨W, hW, hWeq⟩ := χ.exists_isOpen_image_eq hsub (hS.inter (isOpen_tangentChartSet hφ))
    exact ⟨W, hW, hWeq.trans (congrArg (· ∩ W) hTO)⟩
  -- the vector `Tφ(α) = (φ(x), h)`
  have hpV : TangentSpace.mk p ∈ tangentChartSet (P := P) φ := p.mem_source
  have hvec : tangentChartMap hφ (TangentSpace.mk p) =
      ((levelLift φ 1 p.x, p.h) : φ.model.E.tangent 0) :=
    tangentChartMap_mk_self p
  have hmemT : ((levelLift φ 1 p.x, p.h) : φ.model.E.tangent 0) ∈ R.tangent ∩ W := by
    rw [← hWeq, ← hvec]; exact ⟨_, ⟨hαS, hpV⟩, rfl⟩
  obtain ⟨N, hN, hoN, hNsec⟩ := R.exists_isOpen_tangent_section hmemT.1 hW hmemT.2
  -- the basic open set `{y ∈ X¹ | y ∈ V, φ(y) ∈ N}` lies in `p(S)`
  refine Filter.mem_of_superset ((P.isOpen_level_basic hφ hN).mem_nhds ⟨p.mem_source, hoN⟩) ?_
  rintro y ⟨hyV, hyN⟩
  have hyO : levelLift φ 1 (P.levelVal 1 y) ∈ φ.model.E.lvlSet R.retract 1 := by
    rw [ScBanach.mem_lvlSet, P.toBase_levelLift hφ hyV (levelVal_mem y), hR]
    exact φ.mapsTo_model _ hyV
  obtain ⟨h', hh'⟩ := hNsec _ ⟨hyN, hyO⟩
  rw [← hWeq] at hh'
  obtain ⟨β, ⟨hβS, hβV⟩, hβ⟩ := hh'
  refine ⟨β, hβS, level_ext ?_⟩
  have h1 := congrArg Prod.fst hβ
  change (tangentChartMap hφ β).1 = levelLift φ 1 (P.levelVal 1 y) at h1
  rw [tangentChartMap_fst hφ hβV] at h1
  have h2 := congrArg (φ.model.E.toBase 1) h1
  rw [P.toBase_levelLift hφ hβV (levelVal_mem _), P.toBase_levelLift hφ hyV (levelVal_mem y)] at h2
  exact φ.toPartialEquiv.injOn hβV hyV h2

/-- **2021 Proposition 2.3.15 (2)** (2014 Proposition 2.19 (2), 2017 Proposition 2.5 (2)): the
projection `p : TX → X¹` is continuous and open. -/
theorem _root_.Polyfold.proposition_2_3_15_two :
    Continuous P.tangentProj ∧ IsOpenMap P.tangentProj :=
  ⟨continuous_tangentProj, P.isOpenMap_tangentProj⟩

end MPolyfold

end Polyfold
