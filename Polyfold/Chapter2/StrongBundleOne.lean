import Polyfold.Chapter2.StrongBundlePullback

/-!
Hofer–Wysocki–Zehnder, *Polyfold and Fredholm Theory I* (2014 preprint), Part I, §2.5, the text
after **Definition 2.51** and **Definition 2.52**: the M-polyfold `Y[1]` of a strong bundle, the
projection `P[1]`, the chart independence of the double filtration, and sc⁺-sections as sc-smooth
maps into `Y[1]`.

# The M-polyfold `Y[1]` of a strong bundle

## The text, paraphrased

(After Definition 2.51) The strong bundle charts induce a double filtration `Y_{m,k}`,
`0 ≤ k ≤ m + 1`, and two M-polyfolds `Y[i]`, `Y[i]_m = Y_{m,m+i}` (`i = 0, 1`), with the charts
`Φ : P⁻¹(V)[i] → K[i]`; the projections `P[i] : Y[i] → X` are sc-smooth.  (Definition 2.52) An
sc⁺-section is a section that is sc-smooth as a map `X → Y[1]`.

## What is formalized

* `StrongBundleChart.liftOne` (`Φ(y)[1]`), `StrongBundle.oneSet` (`Y_{0,1}`) with
  `StrongBundle.mem_oneSet_iff` (chart independence), the type `StrongBundle.One` (`Y[1]`) with
  the topology generated by the charts `Φ[1]`, `StrongBundle.continuous_oneVal` (`Y[1] → Y` is
  continuous) and the `T2Space` instance.
* `StrongBundle.oneChart` (the chart `Φ[1] : P⁻¹(V)[1] → K[1]`), `oneChart_overlap`,
  `oneChart_transition`, `oneChart_compatible`, `StrongBundle.atlas1`,
  `StrongBundle.metrizableSpace_one` and the instance `paracompactSpace_one` (as in Theorem 2.16),
  `StrongBundle.toMPolyfold1` (**the M-polyfold `Y[1]`**), `StrongBundle.isScSmoothMap_proj1`
  (**`P[1] : Y[1] → X` is sc-smooth**), `StrongBundle.isScSmoothMap_oneVal` (`Y[1] → Y[0]` is
  sc-smooth).
* `StrongBundle.isScPlusSection_iff` (**Definition 2.52**: the chart-wise `IsScPlusSection` is
  "sc-smooth as a map `X → Y[1]`").
* `StrongBundle.mem_doubleLevel_iff` (the double filtration `Y_{m,k}` is chart independent).

## What the text leaves implicit, and the choices made

* `Y[1]` is the subset `Y_{0,1}` of `Y` with the topology generated by the sets `Φ[1]⁻¹(W)`, `W`
  open in `E ⊕ F¹` (the construction of `X_m` in §2.2); its Hausdorff property comes from the
  continuous injection into `Y`, its paracompactness from metrizability (the base is paracompact
  and `P[1]⁻¹(V) ≅ K[1]`).
* The charts of `Y[1]` are those induced by the given strong bundle atlas; the chart independence
  of `Y_{0,1}` and of `Y_{m,k}` uses the `F₁`-condition made explicit in
  `StrongBundleChart.Compatible`.
-/

open Set Filter Topology Function TopologicalSpace

noncomputable section

namespace Polyfold

universe u v

variable {X : Type u} [TopologicalSpace X] [T2Space X] [ParacompactSpace X] {PX : MPolyfold X}
  {Y : Type v} [TopologicalSpace Y] {P : Y → X}
  [∀ x, AddCommGroup (P ⁻¹' {x})] [∀ x, Module ℝ (P ⁻¹' {x})]

lemma strongShiftOne_mono {E F : ScBanach} {K K' : Set (E 0 × F 0)} (h : K ⊆ K') :
    strongShiftOne K ⊆ strongShiftOne K' := fun _ hp => h hp

namespace StrongBundleChart

variable (c : StrongBundleChart PX P)

lemma overlap_subset_K (c' : StrongBundleChart PX P) : c.overlap c' ⊆ c.K := by
  rintro _ ⟨y, hy, rfl⟩
  rw [← c.image_source]; exact ⟨y, hy.1, rfl⟩

/-- The point `Φ(y)[1] = (Φ(y)₁, Φ(y)₂ lifted to F₁)` of `E ⊕ F¹` (meaningful when the fibre
component of `Φ(y)` lies in `F₁`). -/
def liftOne (y : Y) : (c.φ.model.E.prod c.F.shift) 0 :=
  ((c y).1, Function.invFun (c.F.toBase 1) (c y).2)

lemma toBase_liftOne {y : Y} (hy : (c y).2 ∈ range (c.F.toBase 1)) :
    ((c.liftOne y).1, c.F.toBase 1 (c.liftOne y).2) = c y :=
  Prod.ext rfl (Function.invFun_eq hy)

lemma liftOne_mem {y : Y} (hy : y ∈ c.toPartialEquiv.source)
    (hy1 : (c y).2 ∈ range (c.F.toBase 1)) : c.liftOne y ∈ strongShiftOne c.K := by
  change ((c.liftOne y).1, c.F.toBase 1 (c.liftOne y).2) ∈ c.K
  rw [c.toBase_liftOne hy1, ← c.image_source]
  exact ⟨y, hy, rfl⟩

end StrongBundleChart

namespace StrongBundle

variable [T2Space Y] [ParacompactSpace Y] (B : StrongBundle PX P)

/-- The set `Y[1] = Y_{0,1}` (after Definition 2.51): the points whose fibre component lies in
`F₁` in the charts of the atlas. -/
def oneSet : Set Y :=
  {y | ∀ c ∈ B.atlas.charts, y ∈ c.toPartialEquiv.source → (c y).2 ∈ range (c.F.toBase 1)}

/-- `Y_{0,1}` is chart independent: it suffices to check one chart (the transition maps send
fibre components in `F₁` to fibre components in `F'₁`). -/
theorem mem_oneSet_iff {c : StrongBundleChart PX P} (hc : c ∈ B.atlas.charts) {y : Y}
    (hy : y ∈ c.toPartialEquiv.source) : y ∈ B.oneSet ↔ (c y).2 ∈ range (c.F.toBase 1) := by
  refine ⟨fun h => h c hc hy, fun h c' hc' hy' => ?_⟩
  have hcomp := B.atlas.compatible c hc c' hc'
  have hov : c y ∈ c.overlap c' := ⟨y, ⟨hy, hy'⟩, rfl⟩
  have := hcomp.2.2.2.2.1 (c y) hov h
  rwa [StrongBundleChart.transition, Function.comp_apply, c.toPartialEquiv.left_inv hy] at this

/-- `Y[1]` as a type. -/
def One : Type v := B.oneSet

/-- The topology of `Y[1]`, generated by the sets `Φ[1]⁻¹(W)`, `W` open in `E ⊕ F¹` (as for
`X_m` in §2.2). -/
instance : TopologicalSpace B.One :=
  TopologicalSpace.generateFrom {s | ∃ c ∈ B.atlas.charts,
    ∃ W : Set ((c.φ.model.E.prod c.F.shift) 0), IsOpen W ∧
      s = {y : B.oneSet | (y : Y) ∈ c.toPartialEquiv.source ∧ c.liftOne (y : Y) ∈ W}}

/-- The inclusion `Y[1] → Y`. -/
def oneVal (y : B.One) : Y := (y : B.oneSet).1

/-- A point of `Y_{0,1}` as an element of `Y[1]`. -/
def oneMk (y : Y) (hy : y ∈ B.oneSet) : B.One := (⟨y, hy⟩ : B.oneSet)

@[simp] lemma oneVal_oneMk (y : Y) (hy : y ∈ B.oneSet) : B.oneVal (B.oneMk y hy) = y := rfl

lemma oneVal_mem (y : B.One) : B.oneVal y ∈ B.oneSet := (y : B.oneSet).2

lemma oneVal_injective : Injective B.oneVal := fun _ _ h => Subtype.ext h

lemma isOpen_one_basic {c : StrongBundleChart PX P} (hc : c ∈ B.atlas.charts)
    {W : Set ((c.φ.model.E.prod c.F.shift) 0)} (hW : IsOpen W) :
    IsOpen {y : B.One | B.oneVal y ∈ c.toPartialEquiv.source ∧ c.liftOne (B.oneVal y) ∈ W} :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨c, hc, W, hW, rfl⟩

/-- The inclusion `Y[1] → Y` is continuous. -/
theorem continuous_oneVal : Continuous B.oneVal := by
  rw [continuous_def]
  intro V hV
  rw [isOpen_iff_forall_mem_open]
  intro y hy
  obtain ⟨c, hc, hyc⟩ := B.atlas.cover (B.oneVal y)
  obtain ⟨W, hW, hWeq⟩ := (c.toMChart B.continuous).exists_isOpen_image_eq
    (s := V ∩ c.toPartialEquiv.source) inter_subset_right (hV.inter (c.isOpen_source B.continuous))
  set W' : Set ((c.φ.model.E.prod c.F.shift) 0) :=
    (fun p => (p.1, c.F.toBase 1 p.2)) ⁻¹' W with hW'
  have hW'o : IsOpen W' :=
    hW.preimage (continuous_fst.prodMk ((c.F.toBase 1).continuous.comp continuous_snd))
  refine ⟨{z : B.One | B.oneVal z ∈ c.toPartialEquiv.source ∧ c.liftOne (B.oneVal z) ∈ W'}, ?_,
    B.isOpen_one_basic hc hW'o, ⟨hyc, ?_⟩⟩
  · rintro z ⟨hzc, hzW⟩
    have hz1 := (B.mem_oneSet_iff hc hzc).1 (B.oneVal_mem z)
    have h1 : c (B.oneVal z) ∈ (c.toMChart B.continuous).model.O ∩ W := by
      refine ⟨(c.toMChart B.continuous).mapsTo_model _ hzc, ?_⟩
      have : ((c.liftOne (B.oneVal z)).1, c.F.toBase 1 (c.liftOne (B.oneVal z)).2) ∈ W := hzW
      rwa [c.toBase_liftOne hz1] at this
    rw [← hWeq] at h1
    obtain ⟨w, hw, hweq⟩ := h1
    have : w = B.oneVal z := c.toPartialEquiv.injOn hw.2 hzc hweq
    rw [mem_preimage, ← this]; exact hw.1
  · have hy1 := (B.mem_oneSet_iff hc hyc).1 (B.oneVal_mem y)
    change ((c.liftOne (B.oneVal y)).1, c.F.toBase 1 (c.liftOne (B.oneVal y)).2) ∈ W
    rw [c.toBase_liftOne hy1]
    have : c (B.oneVal y) ∈ c.toPartialEquiv '' (V ∩ c.toPartialEquiv.source) :=
      ⟨_, ⟨hy, hyc⟩, rfl⟩
    rw [show c.toPartialEquiv '' (V ∩ c.toPartialEquiv.source) =
      (c.toMChart B.continuous).model.O ∩ W from hWeq] at this
    exact this.2

instance : T2Space B.One := T2Space.of_injective_continuous B.oneVal_injective B.continuous_oneVal

/-! ### The charts `Φ[1] : P⁻¹(V)[1] → K[1]` of `Y[1]` -/

section OneChart

variable {B} {c : StrongBundleChart PX P} (hc : c ∈ B.atlas.charts) (y₀ : B.One)

include hc in
lemma symm_mem_oneSet {z : (c.φ.model.E.prod c.F.shift) 0} (hz : z ∈ strongShiftOne c.K) :
    c.toPartialEquiv.symm (z.1, c.F.toBase 1 z.2) ∈ B.oneSet := by
  have hz' : (z.1, c.F.toBase 1 z.2) ∈ c.toPartialEquiv.target := by rw [c.target_eq]; exact hz
  rw [B.mem_oneSet_iff hc (c.toPartialEquiv.map_target hz'), c.toPartialEquiv.right_inv hz']
  exact ⟨z.2, rfl⟩

open scoped Classical in
/-- The inverse `K[1] → P⁻¹(V)[1]` of `Φ[1]`, with the junk value `y₀`. -/
def oneChartInv (z : (c.φ.model.E.prod c.F.shift) 0) : B.One :=
  if h : z ∈ strongShiftOne c.K then B.oneMk _ (symm_mem_oneSet hc h) else y₀

lemma oneVal_oneChartInv {z : (c.φ.model.E.prod c.F.shift) 0} (hz : z ∈ strongShiftOne c.K) :
    B.oneVal (oneChartInv hc y₀ z) = c.toPartialEquiv.symm (z.1, c.F.toBase 1 z.2) := by
  unfold oneChartInv; rw [dif_pos hz]; rfl

omit [T2Space Y] [ParacompactSpace Y] in
lemma liftOne_symm {z : (c.φ.model.E.prod c.F.shift) 0} (hz : z ∈ strongShiftOne c.K) :
    c.liftOne (c.toPartialEquiv.symm (z.1, c.F.toBase 1 z.2)) = z := by
  have hz' : (z.1, c.F.toBase 1 z.2) ∈ c.toPartialEquiv.target := by rw [c.target_eq]; exact hz
  unfold StrongBundleChart.liftOne
  rw [show c (c.toPartialEquiv.symm (z.1, c.F.toBase 1 z.2)) = (z.1, c.F.toBase 1 z.2) from
    c.toPartialEquiv.right_inv hz']
  exact Prod.ext rfl (c.F.toBase_injective 1 (Function.invFun_eq ⟨z.2, rfl⟩))

/-- The chart `Φ[1] : P⁻¹(V)[1] → K[1]` of `Y[1]` (after Definition 2.51), with model
`(K[1], C ◁ F, E ◁ F¹)`. -/
def oneChart : MChart B.One where
  model := ⟨c.φ.model.E.prod c.F.shift, c.φ.model.C ×ˢ univ, strongShiftOne c.K,
    c.isScRetract_one⟩
  toPartialEquiv :=
    { toFun := fun y => c.liftOne (B.oneVal y)
      invFun := oneChartInv hc y₀
      source := {y | B.oneVal y ∈ c.toPartialEquiv.source}
      target := strongShiftOne c.K
      map_source' := fun y hy => c.liftOne_mem hy ((B.mem_oneSet_iff hc hy).1 (B.oneVal_mem y))
      map_target' := fun z hz => by
        change B.oneVal (oneChartInv hc y₀ z) ∈ c.toPartialEquiv.source
        rw [oneVal_oneChartInv hc y₀ hz]
        exact c.toPartialEquiv.map_target (by rw [c.target_eq]; exact hz)
      left_inv' := fun y hy => by
        have hy1 := (B.mem_oneSet_iff hc hy).1 (B.oneVal_mem y)
        apply B.oneVal_injective
        rw [oneVal_oneChartInv hc y₀ (c.liftOne_mem hy hy1), c.toBase_liftOne hy1]
        exact c.toPartialEquiv.left_inv hy
      right_inv' := fun z hz => by
        change c.liftOne (B.oneVal (oneChartInv hc y₀ z)) = z
        rw [oneVal_oneChartInv hc y₀ hz]
        exact liftOne_symm hz }
  isOpen_source := by
    have := B.isOpen_one_basic hc (W := univ) isOpen_univ
    simpa using this
  target_eq := rfl
  continuousOn_toFun := by
    rw [continuousOn_iff']
    intro W hW
    refine ⟨{y : B.One | B.oneVal y ∈ c.toPartialEquiv.source ∧ c.liftOne (B.oneVal y) ∈ W},
      B.isOpen_one_basic hc hW, ?_⟩
    ext y
    exact ⟨fun h => ⟨⟨h.2, h.1⟩, h.2⟩, fun h => ⟨h.1.2, h.2⟩⟩
  continuousOn_invFun := by
    rw [continuousOn_iff_continuous_domRestrict]
    refine continuous_generateFrom_iff.2 ?_
    rintro _ ⟨c', hc', W, hW, rfl⟩
    obtain ⟨W₀, hW₀, hW₀eq⟩ := c.overlap_eq_inter c' B.continuous
    have hcont : ContinuousOn (shiftFiber (c.transition c')) (strongShiftOne (c.overlap c')) :=
      (B.atlas.compatible c hc c' hc').2.2.1.continuousOn
        (c.isScRetract_overlap_one c' B.continuous)
    obtain ⟨u, hu, hueq⟩ := (continuousOn_iff'.1 hcont) W hW
    set g : (c.φ.model.E.prod c.F.shift) 0 → c.φ.model.E 0 × c.F 0 :=
      fun p => (p.1, c.F.toBase 1 p.2) with hg
    have hgc : Continuous g := continuous_fst.prodMk ((c.F.toBase 1).continuous.comp continuous_snd)
    refine isOpen_induced_iff.2 ⟨g ⁻¹' W₀ ∩ u, (hW₀.preimage hgc).inter hu, ?_⟩
    ext ⟨z, hz⟩
    rw [iff_comm]
    have hz' : (z.1, c.F.toBase 1 z.2) ∈ c.toPartialEquiv.target := by
      rw [c.target_eq]; exact hz
    change (B.oneVal (oneChartInv hc y₀ z) ∈ c'.toPartialEquiv.source ∧
      c'.liftOne (B.oneVal (oneChartInv hc y₀ z)) ∈ W) ↔ _
    rw [oneVal_oneChartInv hc y₀ hz]
    have hov : z ∈ strongShiftOne (c.overlap c') ↔
        c.toPartialEquiv.symm (z.1, c.F.toBase 1 z.2) ∈ c'.toPartialEquiv.source := by
      constructor
      · rintro ⟨y, hy, hyeq⟩
        rw [← hyeq, c.toPartialEquiv.left_inv hy.1]; exact hy.2
      · intro h
        exact ⟨_, ⟨c.toPartialEquiv.map_target hz', h⟩, c.toPartialEquiv.right_inv hz'⟩
    have hsf : c'.liftOne (c.toPartialEquiv.symm (z.1, c.F.toBase 1 z.2)) =
        shiftFiber (c.transition c') z := rfl
    rw [hsf]
    have hovW : z ∈ strongShiftOne (c.overlap c') ↔ g z ∈ W₀ := by
      change (z.1, c.F.toBase 1 z.2) ∈ c.overlap c' ↔ _
      rw [hW₀eq]; exact ⟨fun h => h.2, fun h => ⟨hz, h⟩⟩
    constructor
    · rintro ⟨h1, h2⟩
      have hzov : z ∈ strongShiftOne (c.overlap c') := hov.2 h1
      have : z ∈ shiftFiber (c.transition c') ⁻¹' W ∩ strongShiftOne (c.overlap c') := ⟨h2, hzov⟩
      rw [hueq] at this
      exact ⟨hovW.1 hzov, this.1⟩
    · rintro ⟨h1, h2⟩
      have hzov : z ∈ strongShiftOne (c.overlap c') := hovW.2 h1
      refine ⟨hov.1 hzov, ?_⟩
      have : z ∈ u ∩ strongShiftOne (c.overlap c') := ⟨h2, hzov⟩
      rw [← hueq] at this
      exact this.1

lemma oneChart_apply (y : B.One) : oneChart hc y₀ y = c.liftOne (B.oneVal y) := rfl

lemma oneChart_source : (oneChart hc y₀).source = {y | B.oneVal y ∈ c.toPartialEquiv.source} :=
  rfl

lemma oneChart_symm_apply {z : (c.φ.model.E.prod c.F.shift) 0} (hz : z ∈ strongShiftOne c.K) :
    B.oneVal ((oneChart hc y₀).symm z) = c.toPartialEquiv.symm (z.1, c.F.toBase 1 z.2) :=
  oneVal_oneChartInv hc y₀ hz

/-- The overlap of two charts `Φ[1]`, `Φ'[1]` is `Φ(P⁻¹(V ∩ V'))[1]`. -/
lemma oneChart_overlap {c' : StrongBundleChart PX P} (hc' : c' ∈ B.atlas.charts) (y₀' : B.One) :
    (oneChart hc y₀).overlap (oneChart hc' y₀') = strongShiftOne (c.overlap c') := by
  ext z
  constructor
  · rintro ⟨y, ⟨hy, hy'⟩, rfl⟩
    have hy1 := (B.mem_oneSet_iff hc hy).1 (B.oneVal_mem y)
    change ((c.liftOne (B.oneVal y)).1, c.F.toBase 1 (c.liftOne (B.oneVal y)).2) ∈ c.overlap c'
    rw [c.toBase_liftOne hy1]
    exact ⟨_, ⟨hy, hy'⟩, rfl⟩
  · rintro ⟨w, ⟨hw, hw'⟩, hweq⟩
    have hw1 : w ∈ B.oneSet := (B.mem_oneSet_iff hc hw).2 (by rw [hweq]; exact ⟨z.2, rfl⟩)
    refine ⟨B.oneMk w hw1, ⟨hw, hw'⟩, ?_⟩
    change c.liftOne w = z
    unfold StrongBundleChart.liftOne
    rw [hweq]
    exact Prod.ext rfl (c.F.toBase_injective 1 (Function.invFun_eq ⟨z.2, rfl⟩))

lemma oneChart_transition {c' : StrongBundleChart PX P} (hc' : c' ∈ B.atlas.charts) (y₀' : B.One)
    {z : (c.φ.model.E.prod c.F.shift) 0} (hz : z ∈ strongShiftOne c.K) :
    (oneChart hc y₀).transition (oneChart hc' y₀') z = shiftFiber (c.transition c') z := by
  change c'.liftOne (B.oneVal ((oneChart hc y₀).symm z)) = _
  rw [oneChart_symm_apply hc y₀ hz]
  rfl

/-- The charts `Φ[1]` are pairwise compatible: their transition maps are the `[1]`-transition maps
`(Φ' ∘ Φ⁻¹)[1]` of Definition 2.50. -/
theorem oneChart_compatible {c' : StrongBundleChart PX P} (hc' : c' ∈ B.atlas.charts)
    (y₀' : B.One) : (oneChart hc y₀).Compatible (oneChart hc' y₀') := by
  have h := B.atlas.compatible c hc c' hc'
  constructor
  · rw [oneChart_overlap hc y₀ hc' y₀', oneChart_overlap hc' y₀' hc y₀]
    refine h.2.2.1.congr fun z hz => ?_
    exact (oneChart_transition hc y₀ hc' y₀' (strongShiftOne_mono (c.overlap_subset_K c') hz)).symm
  · rw [oneChart_overlap hc' y₀' hc y₀, oneChart_overlap hc y₀ hc' y₀']
    refine h.2.2.2.1.congr fun z hz => ?_
    exact (oneChart_transition hc' y₀' hc y₀ (strongShiftOne_mono (c'.overlap_subset_K c) hz)).symm

end OneChart

/-! ### The M-polyfold `Y[1]` and the projection `P[1]` -/

/-- The atlas of `Y[1]`: the charts `Φ[1]`. -/
def atlas1 : MAtlas B.One where
  charts := {χ | ∃ (c : StrongBundleChart PX P) (hc : c ∈ B.atlas.charts) (y₀ : B.One),
    χ = oneChart hc y₀}
  compatible := by
    rintro _ ⟨c, hc, y₀, rfl⟩ _ ⟨c', hc', y₀', rfl⟩
    exact oneChart_compatible hc y₀ hc' y₀'
  cover y := by
    obtain ⟨c, hc, hy⟩ := B.atlas.cover (B.oneVal y)
    exact ⟨oneChart hc y, ⟨c, hc, y, rfl⟩, hy⟩

/-- `Y[1]` is metrizable (as in Theorem 2.16: it is locally homeomorphic to the retracts `K[1]`
over a paracompact base). -/
theorem metrizableSpace_one : MetrizableSpace B.One := by
  rcases isEmpty_or_nonempty B.One with h | hne
  · infer_instance
  obtain ⟨y₀⟩ := hne
  refine metrizableSpace_of_pullback (P ∘ B.oneVal) (B.continuous.comp B.continuous_oneVal)
    fun x => ?_
  obtain ⟨y, rfl⟩ := B.surjective x
  obtain ⟨c, hc, hyc⟩ := B.atlas.cover y
  refine ⟨c.φ.source, c.φ.isOpen_source, by rw [c.source_eq] at hyc; exact hyc, ?_⟩
  have hset : (P ∘ B.oneVal) ⁻¹' c.φ.source = (oneChart hc y₀).source := by
    ext z
    change P (B.oneVal z) ∈ c.φ.source ↔ B.oneVal z ∈ c.toPartialEquiv.source
    rw [c.source_eq]; rfl
  rw [hset]
  exact (oneChart hc y₀).metrizableSpace_source

instance paracompactSpace_one : ParacompactSpace B.One := by
  have := B.metrizableSpace_one
  exact paracompactSpace_of_metrizableSpace _

/-- **The M-polyfold `Y[1]`** (after Definition 2.51): `Y_{0,1}` with the charts
`Φ[1] : P⁻¹(V)[1] → K[1]`. -/
def toMPolyfold1 : MPolyfold B.One := ⟨B.atlas1⟩

lemma isChart_oneChart {c : StrongBundleChart PX P} (hc : c ∈ B.atlas.charts) (y₀ : B.One) :
    B.toMPolyfold1.IsChart (oneChart hc y₀) :=
  B.toMPolyfold1.isChart_of_mem ⟨c, hc, y₀, rfl⟩

/-- **After Definition 2.51**: the projection `P[1] : Y[1] → X` is sc-smooth (in the charts `Φ[1]`
and `φ` it is the projection `K[1] → O`, Lemma 5.B). -/
theorem isScSmoothMap_proj1 : B.toMPolyfold1.IsScSmoothMap PX (P ∘ B.oneVal) := by
  refine MPolyfold.IsScSmoothOn.of_exists_charts isOpen_univ
    (B.continuous.comp B.continuous_oneVal).continuousOn fun y _ => ?_
  obtain ⟨c, hc, hy⟩ := B.atlas.cover (B.oneVal y)
  refine ⟨oneChart hc y, c.φ, (oneChart hc y).source, B.isChart_oneChart hc y, c.isChart,
    (oneChart hc y).isOpen_source, hy, fun z hz => ⟨mem_univ _, hz⟩, fun z hz => ?_, ?_⟩
  · have : B.oneVal z ∈ c.toPartialEquiv.source := hz
    rw [c.source_eq] at this; exact this
  · have h1 := c.isStrongBundleRetract.isScSmoothRetractMap_fst_one
    rw [c.base_K] at h1
    rw [(oneChart hc y).image_source]
    refine h1.congr fun k hk => ?_
    change k.1 = c.φ (P (B.oneVal ((oneChart hc y).symm k)))
    rw [oneChart_symm_apply hc y hk]
    have hk' : (k.1, c.F.toBase 1 k.2) ∈ c.toPartialEquiv.target := by
      rw [c.target_eq]; exact hk
    have := c.covers _ (c.toPartialEquiv.map_target hk')
    rw [c.toPartialEquiv.right_inv hk'] at this
    exact this

/-- The inclusion `Y[1] → Y[0]` is sc-smooth (in the charts it is `(u, h) ↦ (u, ι h)`). -/
theorem isScSmoothMap_oneVal : B.toMPolyfold1.IsScSmoothMap B.toMPolyfold0 B.oneVal := by
  refine MPolyfold.IsScSmoothOn.of_exists_charts isOpen_univ B.continuous_oneVal.continuousOn
    fun y _ => ?_
  obtain ⟨c, hc, hy⟩ := B.atlas.cover (B.oneVal y)
  refine ⟨oneChart hc y, c.toMChart B.continuous, (oneChart hc y).source, B.isChart_oneChart hc y,
    B.isChart_toMChart hc, (oneChart hc y).isOpen_source, hy, fun z hz => ⟨mem_univ _, hz⟩,
    fun z hz => hz, ?_⟩
  rw [(oneChart hc y).image_source]
  refine c.isStrongBundleRetract.isScSmoothRetractMap_shiftIncl.congr fun k hk => ?_
  change (k.1, c.F.toBase 1 k.2) = c (B.oneVal ((oneChart hc y).symm k))
  rw [oneChart_symm_apply hc y hk]
  have hk' : (k.1, c.F.toBase 1 k.2) ∈ c.toPartialEquiv.target := by rw [c.target_eq]; exact hk
  exact (c.toPartialEquiv.right_inv hk').symm

/-! ### Sc⁺-sections are the sc-smooth sections into `Y[1]` (Definition 2.52) -/

/-- **Definition 2.52**, sc⁺-sections: the chart-wise definition `IsScPlusSection` (the principal
parts take values in `F₁` and their representatives `O → K[1]` are sc-smooth) agrees with the
text's "`f` is sc-smooth as a map `X → Y[1]`". -/
theorem isScPlusSection_iff (f : X → Y) :
    B.IsScPlusSection f ↔
      IsSection P f ∧ ∃ g : X → B.One, B.oneVal ∘ g = f ∧ PX.IsScSmoothMap B.toMPolyfold1 g := by
  classical
  have hsrc : ∀ {c : StrongBundleChart PX P}, IsSection P f → ∀ x ∈ c.φ.source,
      f x ∈ c.toPartialEquiv.source := fun {c} hsec x hx => by
    rw [c.source_eq, mem_preimage, hsec x]; exact hx
  constructor
  · rintro ⟨hsec, hloc⟩
    have hmem : ∀ x, f x ∈ B.oneSet := fun x => by
      obtain ⟨c, hc, hxc⟩ := B.atlas.cover (f x)
      have hx : x ∈ c.φ.source := by
        rw [c.source_eq, mem_preimage, hsec x] at hxc; exact hxc
      exact (B.mem_oneSet_iff hc hxc).2 ((hloc c hc).1 x hx)
    set g : X → B.One := fun x => B.oneMk (f x) (hmem x) with hgdef
    refine ⟨hsec, g, rfl, ?_⟩
    -- in a chart `φ` of the base and `Φ[1]`, `g` is `(Φ[1])⁻¹ ∘ (local representative) ∘ φ`
    have hlocal : ∀ x, ∃ c : StrongBundleChart PX P, ∃ hc : c ∈ B.atlas.charts,
        x ∈ c.φ.source ∧ ContinuousOn g c.φ.source := fun x => by
      obtain ⟨c, hc, hxc⟩ := B.atlas.cover (f x)
      have hx : x ∈ c.φ.source := by
        rw [c.source_eq, mem_preimage, hsec x] at hxc; exact hxc
      refine ⟨c, hc, hx, ?_⟩
      have h2 := (hloc c hc).2
      have hcont := h2.continuousOn c.φ.model.isScRetract
      have h3 : ContinuousOn ((oneChart hc (g x)).symm ∘ localRepOne c f ∘ c.φ) c.φ.source :=
        ((oneChart hc (g x)).continuousOn_invFun.comp hcont fun z hz => h2.mapsTo hz).comp
          c.φ.continuousOn_toFun fun z hz => c.φ.mapsTo_model z hz
      refine h3.congr fun x' hx' => ?_
      have hx'1 : g x' ∈ (oneChart hc (g x)).source := hsrc hsec x' hx'
      change g x' = (oneChart hc (g x)).symm (localRepOne c f (c.φ x'))
      have : localRepOne c f (c.φ x') = oneChart hc (g x) (g x') := by
        change ((c (f (c.φ.symm (c.φ x')))).1,
          Function.invFun (c.F.toBase 1) (c (f (c.φ.symm (c.φ x')))).2) = c.liftOne (f x')
        rw [c.φ.symm_apply_apply hx']; rfl
      rw [this, (oneChart hc (g x)).symm_apply_apply hx'1]
    have hgc : Continuous g := continuous_iff_continuousAt.2 fun x => by
      obtain ⟨c, hc, hx, hcont⟩ := hlocal x
      exact hcont.continuousAt (c.φ.isOpen_source.mem_nhds hx)
    refine MPolyfold.IsScSmoothOn.of_exists_charts isOpen_univ hgc.continuousOn fun x _ => ?_
    obtain ⟨c, hc, hxc⟩ := B.atlas.cover (f x)
    have hx : x ∈ c.φ.source := by
      rw [c.source_eq, mem_preimage, hsec x] at hxc; exact hxc
    refine ⟨c.φ, oneChart hc (g x), c.φ.source, c.isChart, B.isChart_oneChart hc (g x),
      c.φ.isOpen_source, hx, fun z hz => ⟨mem_univ _, hz⟩, fun z hz => hsrc hsec z hz, ?_⟩
    rw [c.φ.image_source]
    exact (hloc c hc).2
  · rintro ⟨hsec, g, hgf, hg⟩
    refine ⟨hsec, fun c hc => ⟨fun x hx => ?_, ?_⟩⟩
    · have hfx : f x ∈ B.oneSet := by rw [← hgf]; exact B.oneVal_mem (g x)
      exact (B.mem_oneSet_iff hc (hsrc hsec x hx)).1 hfx
    · rcases c.φ.source.eq_empty_or_nonempty with hempty | ⟨x₀, hx₀⟩
      · have hO : c.φ.model.O = ∅ := by rw [← c.φ.image_source, hempty, image_empty]
        have hOe : IsScRetract c.φ.model.E c.φ.model.C ∅ := by
          obtain ⟨R, hR⟩ := c.φ.model.isScRetract
          exact ⟨R.restrict isOpen_empty, by rw [R.restrict_retract, inter_empty]⟩
        rw [hO]
        exact ((ScBanach.prodInlOp c.φ.model.E c.F.shift).isScSmoothRetractMap hOe
          (mapsTo_empty _ _)).congr fun z hz => absurd hz (Set.notMem_empty z)
      · have h1 := hg.smooth c.φ (oneChart hc (g x₀)) c.isChart (B.isChart_oneChart hc (g x₀))
          c.φ.source c.φ.isOpen_source (fun z hz => ⟨mem_univ _, hz⟩) fun z hz => by
            change B.oneVal (g z) ∈ c.toPartialEquiv.source
            rw [show B.oneVal (g z) = f z from congrFun hgf z]; exact hsrc hsec z hz
        rw [c.φ.image_source] at h1
        refine h1.congr fun z hz => ?_
        change c.liftOne (B.oneVal (g (c.φ.symm z))) = localRepOne c f z
        rw [show B.oneVal (g (c.φ.symm z)) = f (c.φ.symm z) from congrFun hgf _]
        rfl

/-! ### The double filtration `Y_{m,k}` is chart independent -/

omit [T2Space Y] [ParacompactSpace Y] in
lemma range_toBase_mono (E : ScBanach) {k m : ℕ} (hkm : k ≤ m) :
    range (E.toBase m) ⊆ range (E.toBase k) := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hkm
  rintro _ ⟨w, rfl⟩
  exact ⟨E.inclK k j w, E.toBase_inclK k j w⟩

/-- **After Definition 2.51**: the double filtration `Y_{m,k}` (`0 ≤ k ≤ m + 1`) is chart
independent: `y ∈ Y_{m,k}` as soon as `Φ(y) ∈ E_m ⊕ F_k` for *one* chart `Φ` of the atlas around
`y` ("the transition maps preserve the double filtrations": the base transition is sc-smooth, the
`[0]`-transition preserves `E_k ⊕ F_k`, and the `[1]`-transition preserves `E_m ⊕ F_{m+1}`). -/
theorem mem_doubleLevel_iff {c : StrongBundleChart PX P} (hc : c ∈ B.atlas.charts) {y : Y}
    (hy : y ∈ c.toPartialEquiv.source) {m k : ℕ} (hk : k ≤ m + 1) :
    y ∈ B.doubleLevel m k ↔
      (c y).1 ∈ range (c.φ.model.E.toBase m) ∧ (c y).2 ∈ range (c.F.toBase k) := by
  refine ⟨fun h => h c hc hy, fun ⟨h1, h2⟩ c' hc' hy' => ?_⟩
  have hcomp := B.atlas.compatible c hc c' hc'
  have hov : c y ∈ c.overlap c' := ⟨y, ⟨hy, hy'⟩, rfl⟩
  have htr : c.transition c' (c y) = c' y := c.transition_apply c' hy
  have hPy : P y ∈ c.φ.source := by rw [c.source_eq] at hy; exact hy
  have hPy' : P y ∈ c'.φ.source := by rw [c'.source_eq] at hy'; exact hy'
  refine ⟨?_, ?_⟩
  · -- the base component
    obtain ⟨w, hw⟩ := h1
    have hbase := (c.isChart.compatible c'.isChart (P := PX)).1
    have hwov : w ∈ c.φ.model.E.lvlSet (c.φ.overlap c'.φ) m := by
      rw [ScBanach.mem_lvlSet, hw, c.covers y hy]; exact ⟨P y, ⟨hPy, hPy'⟩, rfl⟩
    have := (hbase.isSc0 (c.φ.isScRetract_overlap c'.φ)).mem_range m w hwov
    rwa [hw, c.covers y hy, c.φ.transition_apply c'.φ hPy, ← c'.covers y hy'] at this
  · rcases Nat.lt_or_ge k (m + 1) with hkm | hkm
    · -- `k ≤ m`: the `[0]`-transition on level `k`
      have hkm' : k ≤ m := Nat.lt_succ_iff.1 hkm
      obtain ⟨w₁, hw₁⟩ := range_toBase_mono c.φ.model.E hkm' h1
      obtain ⟨w₂, hw₂⟩ := h2
      have hw : (c.φ.model.E.prod c.F).toBase k (w₁, w₂) = c y := by
        rw [ScBanach.prod_toBase]; exact Prod.ext hw₁ hw₂
      have hwov : ((w₁, w₂) : (c.φ.model.E.prod c.F) k) ∈
          (c.φ.model.E.prod c.F).lvlSet (c.overlap c') k := by
        rw [ScBanach.mem_lvlSet, hw]; exact hov
      obtain ⟨v, hv⟩ := (hcomp.1.isSc0 (c.isScRetract_overlap c' B.continuous)).mem_range k _ hwov
      rw [hw, htr, ScBanach.prod_toBase] at hv
      exact ⟨v.2, congrArg Prod.snd hv⟩
    · -- `k = m + 1`: the `[1]`-transition on level `m`
      have hk' : k = m + 1 := le_antisymm hk hkm
      subst hk'
      obtain ⟨w₁, hw₁⟩ := h1
      obtain ⟨w₂, hw₂⟩ := h2
      have h2' : (c y).2 ∈ range (c.F.toBase 1) :=
        range_toBase_mono c.F (Nat.le_add_left 1 m) ⟨w₂, hw₂⟩
      have hlift : c.liftOne y = (c.φ.model.E.prod c.F.shift).toBase m (w₁, w₂) := by
        rw [ScBanach.prod_toBase]
        refine Prod.ext hw₁.symm (c.F.toBase_injective 1 ?_)
        change c.F.toBase 1 (Function.invFun (c.F.toBase 1) (c y).2) =
          c.F.toBase 1 (c.F.shift.toBase m w₂)
        rw [Function.invFun_eq h2', ← hw₂]
        exact ScBanach.shiftScale_toBase c.F.toScScale m w₂
      have hliftov : c.liftOne y ∈ strongShiftOne (c.overlap c') := by
        change ((c.liftOne y).1, c.F.toBase 1 (c.liftOne y).2) ∈ c.overlap c'
        rw [c.toBase_liftOne h2']; exact hov
      have hwov : ((w₁, w₂) : (c.φ.model.E.prod c.F.shift) m) ∈
          (c.φ.model.E.prod c.F.shift).lvlSet (strongShiftOne (c.overlap c')) m := by
        rw [ScBanach.mem_lvlSet, ← hlift]; exact hliftov
      obtain ⟨v, hv⟩ := (hcomp.2.2.1.isSc0 (c.isScRetract_overlap_one c' B.continuous)).mem_range
        m _ hwov
      rw [← hlift] at hv
      have hsf : shiftFiber (c.transition c') (c.liftOne y) = c'.liftOne y := by
        unfold shiftFiber
        rw [c.toBase_liftOne h2', htr]; rfl
      rw [hsf, ScBanach.prod_toBase] at hv
      have h2'' : (c' y).2 ∈ range (c'.F.toBase 1) := by
        have := hcomp.2.2.2.2.1 (c y) hov h2'
        rwa [htr] at this
      refine ⟨v.2, ?_⟩
      rw [ScBanach.shiftScale_toBase c'.F.toScScale m v.2]
      change c'.F.toBase 1 (c'.F.shift.toBase m v.2) = (c' y).2
      rw [show c'.F.shift.toBase m v.2 = (c'.liftOne y).2 from congrArg Prod.snd hv]
      exact Function.invFun_eq h2''

end StrongBundle

end Polyfold
