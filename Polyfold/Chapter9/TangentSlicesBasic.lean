import Polyfold.Chapter9.Tangent

/-!
Hofer–Wysocki–Zehnder, *Polyfold and Fredholm Theory* (Springer 2021; 2017 arXiv 1707.08941),
Part II, Chapter 9, §9.2: the chart description of the tangent spaces `T_xMᵢ` used by
**Theorem 9.2.1** (p. 409; 2017: Theorem 9.1, p. 298) and the tangent slices of its proof,
**Proposition 9.2.8** (p. 413; 2017: Proposition 9.3) with **Lemmas 9.2.9–9.2.11** (pp. 414–417;
2017: Lemmas 9.6–9.8).  Numbers and pages are the 2021 text's.

# Tangent spaces in charts and tangent slices

## The text, paraphrased

(p. 409) `Gr(x)` is generated by the smooth finite-dimensional linear subspaces of `T_xX`; the
`T_xMᵢ` are such subspaces.  (Proof of Theorem 9.2.1, Proposition 9.2.8) At a bad point `x`
the indices with equal `T_xMᵢ = L` are split by sequences of good points; locally (`x = 0` in a
partial quadrant `C`), `int_L(L ∩ C) ≠ ∅` (Lemma 9.2.9), the `Mᵢ` with `T_0Mᵢ = L` are graphs
`a + Bᵢ(a)` over a cone around some `h₀ ∈ int_L(L ∩ C)` (Lemma 9.2.10), via the inversion of a
map `Φ` on the cone (Lemma 9.2.11).

## What is formalized

* **The chart description of `T_yA`** (Part I Remark 4.14 read in a chart): `chartTangent`
  (the second components of `Tφ(α)`, `α ∈ T_yA`), `chartTangent_eq` (it is the tangent space of
  the chart model of `A`), `exists_submodule_chartTangent` (a finite-dimensional linear
  subspace), `finrank_chartTangent` (of dimension `dim_y A`), `chartTangent_eq_iff`,
  `chartTangent_subset_iff`, `injOn_tangentChartMap_snd`; chart changes act linearly
  (`exists_clm_tangentChartMap_snd`, `chartTangent_chart_change`,
  `exists_linearEquiv_chartTangent`); the generators of `Gr(x)` met by `TΘ` are finite-dimensional
  linear subspaces in every chart (`LocalBranchingStructure.exists_submodule_of_mem_support`).
  Also `SubmanifoldData.tmap_tmap`, `tmap_mem_submanifoldTangent`, `tangentChartMap_tmap`,
  `submanifoldTangent_subset_of_subset`.
* **The graph representation** `IsGraphChartAt`, `HasGraphChartsAt`: the content of Lemmas
  9.2.9–9.2.11 in a chart, as a hypothesis (they rest on sc-calculus at level `0` that Part I
  does not formalize); it holds in `ℝᵐ` (`hasGraphChartsAt_rn`, `TangentSlicesRn.lean`).
* **Tangent slices from the graph representation** (`hasTangentSlicesAt_of_hasGraphChartsAt`):
  the hypothesis `HasTangentSlicesAt` of the fibre count in `Tangent.lean` holds wherever the
  graph representation does, with the slice `{y | Q(φy − φx) = t h₀, ‖φy − φx − t h₀‖ < ε t}`;
  helpers `eq_zero_of_proj_eq_zero`, `exists_mem_ball_forall_not_mem`.

## What the text leaves implicit, and the choices made

* Proposition 9.2.8 is used in the text only to count `∑ Θ(x_k^e)`; `Tangent.lean` does the
  count with one slice `F` per class (`HasTangentSlicesAt`), which needs only one good direction
  `h₀` (avoiding the finitely many other tangent spaces), not the sequences of Proposition 9.2.8.
  So Proposition 9.2.8 is formalized in this slice form, not as printed.
* The cone of Lemma 9.2.10 is replaced by rays `t h` (`IsGraphChartAt.graph`) and a uniform
  approximation of secants by `T_xA` (`IsGraphChartAt.approx`, from `C¹` of the retraction);
  the admissible directions `K` play the role of `C`.
-/

set_option maxSynthPendingDepth 3

open Set Filter Topology Module

noncomputable section

namespace Polyfold

universe u

namespace MPolyfold

variable {X : Type u} [TopologicalSpace X] [T2Space X] [ParacompactSpace X] {P : MPolyfold X}

namespace SubmanifoldData

variable {A : Set X} (d : P.SubmanifoldData A)

/-- `Ts ∘ Ts = Ts` on `TV` (the chain rule for `s ∘ s = s`). -/
theorem tmap_tmap {α : P.TangentSpace} (hα : α ∈ P.tangentPreimage d.V) :
    d.tmap (d.tmap α) = d.tmap α := by
  have hs := d.isScPlusRetractionOn.isScSmoothOn
  exact tangentMapOn_tangentMapOn_eq hs hs hs d.isOpen subset_rfl subset_rfl
    d.isScPlusRetractionOn.mapsTo (fun y hy => d.isScPlusRetractionOn.idem y hy) hα

/-- `Ts(α) ∈ T_{s(y)}A` for `α` over `y ∈ V`. -/
theorem tmap_mem_submanifoldTangent {α : P.TangentSpace} (hα : α ∈ P.tangentPreimage d.V) :
    d.tmap α ∈ P.submanifoldTangent A (d.s (P.levelVal 1 (P.tangentProj α))) :=
  ⟨d.levelVal_tangentProj_tmap hα, d, d.isScPlusRetractionOn.mapsTo hα, d.tmap_tmap hα⟩

variable {φ : MChart X} (hφ : P.IsChart φ)
include hφ

/-- `Tφ ∘ Ts = Tρ ∘ Tφ` over the open set `W` of the sub-M-polyfold chart, `ρ = φ ∘ s ∘ φ⁻¹`. -/
theorem tangentChartMap_tmap {α : P.TangentSpace}
    (hα : α ∈ P.tangentPreimage (d.toSubData.shrink φ)) :
    tangentChartMap hφ (d.tmap α) =
      retractTangentMap φ.model.E φ.model.C (φ '' d.toSubData.shrink φ) (φ ∘ d.s ∘ φ.symm)
        (tangentChartMap hφ α) := by
  have hs := d.isScPlusRetractionOn.isScSmoothOn
  have hW := d.toSubData.isOpen_shrink φ
  have hsub : d.toSubData.shrink φ ⊆ d.V := d.toSubData.shrink_subset_V φ
  have h1 : d.tmap α = tangentMapOn (hs.mono hW hsub) α :=
    (tangentMapOn_mono hs hW hsub hα).symm
  have hdom : TangentPre.fdomOn (d.toSubData.shrink φ) φ d.s φ = d.toSubData.shrink φ := by
    ext y
    constructor
    · rintro ⟨⟨h, -⟩, -⟩; exact h
    · intro h
      exact ⟨⟨h, d.toSubData.shrink_subset_source φ h⟩, (d.toSubData.mapsTo_shrink φ h).1.2⟩
  have h2 := tangentChartMap_tangentMapOn (hs.mono hW hsub) hφ hφ (α := α)
    (by rw [hdom]; exact hα)
  rw [h1, h2, hdom]

end SubmanifoldData

/-! ### The chart description of `T_yA` -/

variable (P) in
/-- **`T_yA` in the chart `φ`**: the second components `h` of the vectors `Tφ(α) = (φ(y), h)`,
`α ∈ T_yA`. -/
def chartTangent {φ : MChart X} (hφ : P.IsChart φ) (A : Set X) (y : X) : Set (φ.model.E 0) :=
  (fun α => (tangentChartMap hφ α).2) '' P.submanifoldTangent A y

variable {φ : MChart X} (hφ : P.IsChart φ)

/-- The chart map `α ↦ h` (`Tφ(α) = (φ(y), h)`) is injective on the fibre `T_yX`. -/
theorem injOn_tangentChartMap_snd {y : X} (hyφ : y ∈ φ.source) :
    InjOn (fun α => (tangentChartMap hφ α).2) {α | P.levelVal 1 (P.tangentProj α) = y} := by
  intro α hα β hβ h
  have hαφ : α ∈ tangentChartSet φ := by change _ ∈ φ.source; rw [hα]; exact hyφ
  have hβφ : β ∈ tangentChartSet φ := by change _ ∈ φ.source; rw [hβ]; exact hyφ
  refine tangentChartMap_injOn hφ hαφ hβφ (Prod.ext ?_ h)
  rw [tangentChartMap_fst hφ hαφ, tangentChartMap_fst hφ hβφ, show P.levelVal 1
    (P.tangentProj α) = y from hα, show P.levelVal 1 (P.tangentProj β) = y from hβ]

theorem submanifoldTangent_subset_fiber (A : Set X) (y : X) :
    P.submanifoldTangent A y ⊆ {α | P.levelVal 1 (P.tangentProj α) = y} := fun _ h => h.1

/-- **The chart description of `T_yA`** (Remark 4.14, `T_yA = Ts(y)(T_yX)`, read in a chart):
for data `(V, s)` of Definition 4.13 at `y ∈ A` and a chart `φ` at `y`, the chart image of
`T_yA` is the tangent space `T_z(φ(W ∩ A))` of the chart model of `A` (`z` the level-`1` point
over `φ(y)`). -/
theorem chartTangent_eq {A : Set X} (d : P.SubmanifoldData A) {y : X} (hyA : y ∈ A)
    (hyV : y ∈ d.V) (hyφ : y ∈ φ.source) :
    P.chartTangent hφ A y =
      tangentSpace φ.model.E φ.model.C (φ '' (d.toSubData.shrink φ ∩ A)) (levelLift φ 1 y) := by
  have hy1 : y ∈ P.levelSet 1 := d.mem_levelSet_one hyA hyV
  have hz : φ.model.E.toBase 1 (levelLift φ 1 y) = φ y := P.toBase_levelLift hφ hyφ hy1
  obtain ⟨-, h2, -, -⟩ := d.remark_4_14 hφ hyA hyV hyφ hz
  have hyW : y ∈ d.toSubData.shrink φ := d.toSubData.mem_shrink φ hyA hyV hyφ
  rw [← h2]
  ext h
  constructor
  · rintro ⟨α, hα, rfl⟩
    have hαy : P.levelVal 1 (P.tangentProj α) = y := hα.1
    have hfix : d.tmap α = α := ((mem_submanifoldTangent_iff d hyV).1 hα).2
    have hαW : α ∈ P.tangentPreimage (d.toSubData.shrink φ) :=
      mem_tangentPreimage.2 (hαy ▸ hyW)
    have hαφ : α ∈ tangentChartSet φ := d.toSubData.shrink_subset_source φ hαW
    have hfst : (tangentChartMap hφ α).1 = levelLift φ 1 y := by
      rw [tangentChartMap_fst hφ hαφ, hαy]
    have hpair : ((levelLift φ 1 y, (tangentChartMap hφ α).2) : φ.model.E.tangent 0) =
        tangentChartMap hφ α := Prod.ext hfst.symm rfl
    refine ⟨(tangentChartMap hφ α).2, ?_, ?_⟩
    · simp only [tangentSpace, mem_ofPred_eq]
      rw [hpair]
      exact tangentChartMap_mem hφ hαφ
    · have := d.tangentChartMap_tmap hφ hαW
      rw [hfix] at this
      dsimp only
      rw [hpair, ← this]
  · rintro ⟨h', hh', rfl⟩
    have hmem : ((levelLift φ 1 y, h') : φ.model.E.tangent 0) ∈
        retractTangent φ.model.E φ.model.C φ.model.O := hh'
    set β := TangentSpace.mk (TangentPre.ofVec hφ hmem) with hβdef
    have hβ : tangentChartMap hφ β = (levelLift φ 1 y, h') := tangentChartMap_mk_ofVec hφ hmem
    have hβy : P.levelVal 1 (P.tangentProj β) = y := by
      rw [hβdef, tangentProj_mk, TangentPre.ofVec_x]
      change φ.symm (φ.model.E.toBase 1 (levelLift φ 1 y)) = y
      rw [hz, φ.symm_apply_apply hyφ]
    have hβW : β ∈ P.tangentPreimage (d.toSubData.shrink φ) :=
      mem_tangentPreimage.2 (hβy ▸ hyW)
    have hβV : β ∈ P.tangentPreimage d.V := d.toSubData.shrink_subset_V φ hβW
    refine ⟨d.tmap β, ?_, ?_⟩
    · have := d.tmap_mem_submanifoldTangent hβV
      rwa [hβy, d.apply_eq_self ⟨hyA, hyV⟩] at this
    · dsimp only
      rw [d.tangentChartMap_tmap hφ hβW, hβ]

/-- The chart image of `T_yA` is a finite-dimensional linear subspace of `E₀` (Remark 4.14). -/
theorem exists_submodule_chartTangent {A : Set X} (hA : P.IsSmoothSubmanifold A) {y : X}
    (hyA : y ∈ A) (hyφ : y ∈ φ.source) :
    ∃ N : Submodule ℝ (φ.model.E 0), (N : Set (φ.model.E 0)) = P.chartTangent hφ A y ∧
      FiniteDimensional ℝ N := by
  set d := hA.data hyA
  have hyV := hA.mem_data_V hyA
  have hy1 : y ∈ P.levelSet 1 := d.mem_levelSet_one hyA hyV
  have hz : φ.model.E.toBase 1 (levelLift φ 1 y) = φ y := P.toBase_levelLift hφ hyφ hy1
  obtain ⟨-, -, -, N, hN, hfin⟩ := d.remark_4_14 hφ hyA hyV hyφ hz
  exact ⟨N, hN.trans (chartTangent_eq hφ d hyA hyV hyφ).symm, hfin⟩

/-- `T_yA = T_yA'` iff the chart images agree. -/
theorem chartTangent_eq_iff {A A' : Set X} {y : X} (hyφ : y ∈ φ.source) :
    P.chartTangent hφ A y = P.chartTangent hφ A' y ↔
      P.submanifoldTangent A y = P.submanifoldTangent A' y :=
  (injOn_tangentChartMap_snd hφ hyφ).image_eq_image_iff (submanifoldTangent_subset_fiber A y)
    (submanifoldTangent_subset_fiber A' y)

/-- `T_yA ⊆ T_yA'` iff the chart images are contained in each other. -/
theorem chartTangent_subset_iff {A A' : Set X} {y : X} (hyφ : y ∈ φ.source) :
    P.chartTangent hφ A y ⊆ P.chartTangent hφ A' y ↔
      P.submanifoldTangent A y ⊆ P.submanifoldTangent A' y :=
  (injOn_tangentChartMap_snd hφ hyφ).image_subset_image_iff (submanifoldTangent_subset_fiber A y)
    (submanifoldTangent_subset_fiber A' y)


/-- **The dimension of the chart image of `T_yA`** is the dimension of `A` at `y`
(Remark 9.1.1, `HasDimAt.finrank_eq`). -/
theorem finrank_chartTangent {A : Set X} {y : X} {n : ℕ} (h : P.HasDimAt A y n)
    (hA : P.IsSmoothSubmanifold A) (hyφ : y ∈ φ.source) {N : Submodule ℝ (φ.model.E 0)}
    (hN : (N : Set (φ.model.E 0)) = P.chartTangent hφ A y) : finrank ℝ N = n := by
  have hyA : y ∈ A := h.1
  set d := hA.data hyA
  have hyV := hA.mem_data_V hyA
  have hy1 : y ∈ P.levelSet 1 := d.mem_levelSet_one hyA hyV
  have hz : φ.model.E.toBase 1 (levelLift φ 1 y) = φ y := P.toBase_levelLift hφ hyφ hy1
  have h1 := h.finrank_eq d hφ hyV hyφ hz
  rw [← chartTangent_eq hφ d hyA hyV hyφ, ← hN, Submodule.span_eq] at h1
  exact h1

/-- `T_yA ⊆ T_yB` if `A ⊆ B` near `y` (`s_B ∘ s_A = s_A` near `y`, and the chain rule). -/
theorem submanifoldTangent_subset_of_subset {A B : Set X} (hB : P.IsSmoothSubmanifold B) {y : X}
    {V : Set X} (hV : IsOpen V) (hyV : y ∈ V) (hAB : A ∩ V ⊆ B) :
    P.submanifoldTangent A y ⊆ P.submanifoldTangent B y := by
  intro α hα
  have hyA : y ∈ A := mem_of_mem_submanifoldTangent hα
  obtain ⟨hαy, d, hyd, hfix⟩ := hα
  have hyB : y ∈ B := hAB ⟨hyA, hyV⟩
  set d' := hB.data hyB
  have hyd' : y ∈ d'.V := hB.mem_data_V hyB
  have hs := d.isScPlusRetractionOn.isScSmoothOn
  have hsy : d.s y = y := d.apply_eq_self ⟨hyA, hyd⟩
  set G := d.V ∩ d.s ⁻¹' (d'.V ∩ V)
  have hG : IsOpen G := hs.continuousOn.isOpen_inter_preimage d.isOpen (d'.isOpen.inter hV)
  have hαG : α ∈ P.tangentPreimage G := by
    change P.levelVal 1 (P.tangentProj α) ∈ G
    rw [hαy]
    exact ⟨hyd, by rw [mem_preimage, hsy]; exact ⟨hyd', hyV⟩⟩
  have heq : EqOn (d'.s ∘ d.s) d.s G := fun w hw => by
    have h1 : d.s w ∈ d.s '' d.V := ⟨w, hw.1, rfl⟩
    rw [d.image] at h1
    exact d'.apply_eq_self ⟨hAB ⟨h1.1, hw.2.2⟩, hw.2.1⟩
  have h := tangentMapOn_tangentMapOn_eq hs d'.isScPlusRetractionOn.isScSmoothOn hs hG
    inter_subset_left inter_subset_left (fun w hw => hw.2.1) heq hαG
  change tangentMapOn _ (d.tmap α) = d.tmap α at h
  rw [hfix] at h
  exact ⟨hαy, d', hyd', h⟩

/-- **Chart changes act on `T_yA` by linear maps**: for charts `φ`, `ψ` at a level-`1` point `y`
there is a continuous linear map `L = D(ψ ∘ φ⁻¹)(φ(y))` with `(Tψ α)₂ = L (Tφ α)₂` for every
`α ∈ T_yX` (formula (5) of Part I, `retractTangentMap_apply`). -/
theorem exists_clm_tangentChartMap_snd {ψ : MChart X} (hψ : P.IsChart ψ) {y : X}
    (hyφ : y ∈ φ.source) (hyψ : y ∈ ψ.source) :
    ∃ L : φ.model.E 0 →L[ℝ] ψ.model.E 0, ∀ α : P.TangentSpace,
      P.levelVal 1 (P.tangentProj α) = y →
        (tangentChartMap hψ α).2 = L (tangentChartMap hφ α).2 := by
  obtain ⟨R, hR⟩ := φ.isScRetract_overlap ψ
  have hf := (hφ.compatible hψ (P := P)).1
  refine ⟨scDeriv R.U (φ.transition ψ ∘ R) (levelLift φ 1 y), fun α hα => ?_⟩
  have hαφ : α ∈ tangentChartSet φ := by change _ ∈ φ.source; rw [hα]; exact hyφ
  have hmem := tangentChartMap_mem hφ hαφ
  have hfst : (tangentChartMap hφ α).1 = levelLift φ 1 y := by
    rw [tangentChartMap_fst hφ hαφ, hα]
  have hy1 : y ∈ P.levelSet 1 := hα ▸ (P.tangentProj α).2
  have hov : (tangentChartMap hφ α) ∈ retractTangent φ.model.E φ.model.C (φ.overlap ψ) := by
    have hsub : φ.source ∩ ψ.source ⊆ φ.source := inter_subset_left
    refine (TangentPre.mem_retractTangent_image_iff hsub (φ.isOpen_source.inter ψ.isOpen_source)
      ?_).2 hmem
    rw [hfst, P.toBase_levelLift hφ hyφ hy1]
    exact ⟨y, ⟨hyφ, hyψ⟩, rfl⟩
  have h1 := tangentChartMap_mk_ofVec_of_mem hφ hψ hmem hov
  rw [mk_ofVec_tangentChartMap hφ hαφ] at h1
  rw [h1, retractTangentMap_apply hf R hR hov, hfst]

/-- **Chart changes act on the chart images of `T_yA` by linear isomorphisms**: the chart image
in `ψ` is the image of the chart image in `φ` under the continuous linear map
`L = D(ψ ∘ φ⁻¹)(φ(y))`, which is injective on it. -/
theorem chartTangent_chart_change {ψ : MChart X} (hψ : P.IsChart ψ) (A : Set X) {y : X}
    (hyφ : y ∈ φ.source) (hyψ : y ∈ ψ.source) :
    ∃ L : φ.model.E 0 →L[ℝ] ψ.model.E 0,
      P.chartTangent hψ A y = L '' P.chartTangent hφ A y ∧ InjOn L (P.chartTangent hφ A y) := by
  obtain ⟨L, hL⟩ := exists_clm_tangentChartMap_snd hφ hψ hyφ hyψ
  refine ⟨L, ?_, ?_⟩
  · rw [chartTangent, chartTangent, image_image]
    exact image_congr fun α hα => hL α hα.1
  · rintro _ ⟨α, hα, rfl⟩ _ ⟨β, hβ, rfl⟩ h
    have h' : (tangentChartMap hψ α).2 = (tangentChartMap hψ β).2 := by
      rw [hL α hα.1, hL β hβ.1]; exact h
    rw [injOn_tangentChartMap_snd hψ hyψ (submanifoldTangent_subset_fiber A y hα)
      (submanifoldTangent_subset_fiber A y hβ) h']

/-- The chart change as a linear isomorphism of the finite-dimensional subspaces. -/
theorem exists_linearEquiv_chartTangent {ψ : MChart X} (hψ : P.IsChart ψ) (A : Set X) {y : X}
    (hyφ : y ∈ φ.source) (hyψ : y ∈ ψ.source) {N : Submodule ℝ (φ.model.E 0)}
    {N' : Submodule ℝ (ψ.model.E 0)} (hN : (N : Set (φ.model.E 0)) = P.chartTangent hφ A y)
    (hN' : (N' : Set (ψ.model.E 0)) = P.chartTangent hψ A y) :
    ∃ (L : φ.model.E 0 →L[ℝ] ψ.model.E 0) (e : N ≃ₗ[ℝ] N'), ∀ v : N, (e v : ψ.model.E 0) = L v := by
  obtain ⟨L, himg, hinj⟩ := chartTangent_chart_change hφ hψ A hyφ hyψ
  have hmaps : ∀ v ∈ N, (L : φ.model.E 0 →ₗ[ℝ] ψ.model.E 0) v ∈ N' := fun v hv => by
    rw [← SetLike.mem_coe, hN', himg]
    exact mem_image_of_mem L (by rw [← hN]; exact hv)
  let f : N →ₗ[ℝ] N' := (L : φ.model.E 0 →ₗ[ℝ] ψ.model.E 0).restrict hmaps
  have hbij : Function.Bijective f := by
    refine ⟨fun v w hvw => ?_, fun w => ?_⟩
    · have h1 : L v = L w := congrArg Subtype.val hvw
      have hv : (v : φ.model.E 0) ∈ P.chartTangent hφ A y := by rw [← hN]; exact v.2
      have hw : (w : φ.model.E 0) ∈ P.chartTangent hφ A y := by rw [← hN]; exact w.2
      exact Subtype.ext (hinj hv hw h1)
    · have hw : (w : ψ.model.E 0) ∈ L '' P.chartTangent hφ A y := by rw [← himg, ← hN']; exact w.2
      obtain ⟨v, hv, hvw⟩ := hw
      rw [← hN] at hv
      exact ⟨⟨v, hv⟩, Subtype.ext hvw⟩
  exact ⟨L, LinearEquiv.ofBijective f hbij, fun v => rfl⟩

end MPolyfold

namespace EpGroupoid

variable {Obj Mor : Type u} [TopologicalSpace Obj] [T2Space Obj] [ParacompactSpace Obj]
  [TopologicalSpace Mor] [T2Space Mor] [ParacompactSpace Mor] {X : EpGroupoid Obj Mor}

/-- **The generators of `TΘ(x)` are finite-dimensional linear subspaces in every chart** (2021
p. 409: `Gr(x)` is generated by the smooth finite-dimensional linear subspaces of `T_xX`): each
`L` in the support of `∑ σᵢ · T_xMᵢ` is a `T_xMᵢ`, whose chart image is a finite-dimensional
subspace, the chart map being injective on `L`. -/
theorem LocalBranchingStructure.exists_submodule_of_mem_support {Θ : Obj → ℚ} {x : Obj}
    (B : X.LocalBranchingStructure Θ x) {L : Set X.PObj.TangentSpace}
    (hL : L ∈ B.tangentSum.support) {φ : MChart Obj} (hφ : X.PObj.IsChart φ)
    (hxφ : x ∈ φ.source) :
    ∃ N : Submodule ℝ (φ.model.E 0), FiniteDimensional ℝ N ∧
      (N : Set (φ.model.E 0)) = (fun α => (MPolyfold.tangentChartMap hφ α).2) '' L ∧
      InjOn (fun α => (MPolyfold.tangentChartMap hφ α).2) L := by
  classical
  have : ∃ i, X.PObj.submanifoldTangent (B.M i) x = L := by
    by_contra h
    push Not at h
    exact (Finsupp.mem_support_iff.1 hL)
      (by rw [B.tangentSum_apply]; exact Finset.sum_eq_zero fun i _ => if_neg (h i))
  obtain ⟨i, rfl⟩ := this
  obtain ⟨N, hN, hfin⟩ :=
    MPolyfold.exists_submodule_chartTangent hφ (B.isSmoothSubmanifold i) (B.mem_M i) hxφ
  exact ⟨N, hfin, hN, (MPolyfold.injOn_tangentChartMap_snd hφ hxφ).mono
    (MPolyfold.submanifoldTangent_subset_fiber _ _)⟩

end EpGroupoid

/-! ### Two facts of linear algebra in a normed space -/

section LinearAlgebra

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- **Uniqueness of the graph point** (the injectivity in Lemma 9.2.11): for a continuous
projection `Q` onto `T`, a vector `w ∈ ker Q` with `‖w − v‖ ≤ ε ‖w‖` for some `v ∈ T` vanishes
once `ε ‖1 − Q‖ < 1` (`w = (1 − Q)(w − v)`). -/
theorem eq_zero_of_proj_eq_zero {Q : E →L[ℝ] E} {T : Set E} (hQid : ∀ v ∈ T, Q v = v)
    {w v : E} (hw : Q w = 0) (hv : v ∈ T) {ε : ℝ}
    (hε : ε * ‖ContinuousLinearMap.id ℝ E - Q‖ < 1) (hwv : ‖w - v‖ ≤ ε * ‖w‖) : w = 0 := by
  have h1 : (ContinuousLinearMap.id ℝ E - Q) (w - v) = w := by
    simp only [sub_apply, ContinuousLinearMap.id_apply, map_sub, hw,
      hQid v hv]
    abel
  have h2 : ‖w‖ ≤ ‖ContinuousLinearMap.id ℝ E - Q‖ * (ε * ‖w‖) := by
    calc ‖w‖ = ‖(ContinuousLinearMap.id ℝ E - Q) (w - v)‖ := by rw [h1]
      _ ≤ ‖ContinuousLinearMap.id ℝ E - Q‖ * ‖w - v‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ _ := mul_le_mul_of_nonneg_left hwv (norm_nonneg _)
  have h3 : ‖w‖ ≤ 0 := by nlinarith [norm_nonneg w, norm_nonneg (ContinuousLinearMap.id ℝ E - Q)]
  exact norm_le_zero_iff.1 h3

/-- **A vector of an open piece of a subspace outside finitely many closed subspaces not
containing it** (the choice of `h₀` in the proof of Proposition 9.2.8). -/
theorem exists_mem_ball_forall_not_mem {N : Submodule ℝ E} {ι : Type*} [Finite ι]
    (S : ι → Submodule ℝ E) (hS : ∀ i, IsClosed (S i : Set E)) (hNS : ∀ i, ¬ N ≤ S i)
    {h₁ : E} (hh₁ : h₁ ∈ N) {r : ℝ} (hr : 0 < r) :
    ∃ h₀ ∈ N, ‖h₀ - h₁‖ < r ∧ ∀ i, h₀ ∉ S i := by
  classical
  have key : ∀ s : Finset ι, ∃ h₀ ∈ N, ‖h₀ - h₁‖ < r ∧ ∀ i ∈ s, h₀ ∉ S i := by
    intro s
    induction s using Finset.induction_on with
    | empty => exact ⟨h₁, hh₁, by simpa using hr, fun i hi => absurd hi (Finset.notMem_empty i)⟩
    | insert j s hj ih =>
      obtain ⟨h, hhN, hhr, hhs⟩ := ih
      by_cases hhj : h ∈ S j
      · obtain ⟨w, hwN, hwS⟩ := SetLike.not_le_iff_exists.1 (hNS j)
        set G : Set E := {v | ‖v - h₁‖ < r} ∩ ⋂ i ∈ s, (S i : Set E)ᶜ
        have hG : IsOpen G := (isOpen_lt (continuous_id.sub continuous_const).norm
          continuous_const).inter (isOpen_biInter_finset fun i _ => (hS i).isOpen_compl)
        have hhG : h ∈ G := ⟨hhr, mem_iInter₂.2 fun i hi => hhs i hi⟩
        have hcont : Continuous fun τ : ℝ => h + τ • w := continuous_const.add
          (continuous_id.smul continuous_const)
        have hev0 : ∀ᶠ τ in 𝓝 (0 : ℝ), h + τ • w ∈ G := by
          have ht := hcont.tendsto 0
          simp only [zero_smul, add_zero] at ht
          exact ht (hG.mem_nhds hhG)
        have hev : ∀ᶠ τ in 𝓝[≠] (0 : ℝ), h + τ • w ∈ G := hev0.filter_mono nhdsWithin_le_nhds
        obtain ⟨τ, hτG, hτ0⟩ := (hev.and self_mem_nhdsWithin).exists
        refine ⟨h + τ • w, N.add_mem hhN (N.smul_mem τ hwN), hτG.1, fun i hi => ?_⟩
        rcases Finset.mem_insert.1 hi with rfl | hi
        · intro hmem
          have h1 : τ • w ∈ S i := by
            have := (S i).sub_mem hmem hhj
            rwa [add_sub_cancel_left] at this
          have h2 := (S i).smul_mem τ⁻¹ h1
          rw [smul_smul, inv_mul_cancel₀ (show τ ≠ 0 from hτ0), one_smul] at h2
          exact hwS h2
        · exact mem_iInter₂.1 hτG.2 i hi
      · exact ⟨h, hhN, hhr, fun i hi => by
          rcases Finset.mem_insert.1 hi with rfl | hi
          · exact hhj
          · exact hhs i hi⟩
  have := Fintype.ofFinite ι
  obtain ⟨h₀, hN, hr, hs⟩ := key Finset.univ
  exact ⟨h₀, hN, hr, fun i => hs i (Finset.mem_univ i)⟩

/-- `t ↦ t C` is eventually below any `D > 0` as `t → 0⁺`. -/
theorem eventually_mul_lt {C D : ℝ} (hD : 0 < D) : ∀ᶠ t in 𝓝[>] (0 : ℝ), t * C < D := by
  have h : Tendsto (fun t : ℝ => t * C) (𝓝 0) (𝓝 0) := by
    simpa using (tendsto_id (x := 𝓝 (0 : ℝ))).mul_const C
  exact (h.eventually (eventually_lt_nhds hD)).filter_mono nhdsWithin_le_nhds

end LinearAlgebra

namespace MPolyfold

variable {X : Type u} [TopologicalSpace X] [T2Space X] [ParacompactSpace X] {P : MPolyfold X}

/-! ### Lemmas 9.2.9–9.2.11 in a chart: the graph representation -/

variable (P) in
/-- **The graph representation of a submanifold over its tangent space in a chart** (the content
of 2021 Lemmas 9.2.9–9.2.11, pp. 414–417; 2017: Lemmas 9.6–9.8): for a chart `φ` at `x` and a
set `K` of admissible directions in the model space (in the text the partial quadrant `C`, with
`x = 0`), writing `T = T_xA` for the chart image of the tangent space (`chartTangent`),
* (Lemma 9.2.9) `int_T(T ∩ K) ≠ ∅`;
* (Lemma 9.2.10, `DB(0) = 0`) `A` is tangent to `T` at `x` in the strict sense: chords
  `φ(a) − φ(b)` of `A` near `x` are `ε`-close to `T` relative to their length;
* (Lemmas 9.2.10, 9.2.11, the inversion of `Φ(a) = a + PA(a)a`) for every continuous projection
  `Q` onto `T` and every admissible `h ∈ T`, the points `t h`, `t > 0` small, are hit by `Q`
  from points `φ(a)` of `A` with `‖φ(a) − φ(x) − t h‖ ≤ ε t`.
Satisfied in `ℝᵐ` by every submanifold (`isGraphChartAt_rn`). -/
structure IsGraphChartAt {φ : MChart X} (hφ : P.IsChart φ) (K : Set (φ.model.E 0)) (A : Set X)
    (x : X) : Prop where
  exists_ball : ∃ h₁ ∈ P.chartTangent hφ A x, ∃ r > 0,
    ∀ v ∈ P.chartTangent hφ A x, ‖v - h₁‖ < r → v ∈ K
  approx : ∀ ε > 0, ∃ δ > 0, ∀ a ∈ A ∩ φ.source, ∀ b ∈ A ∩ φ.source,
    ‖φ a - φ x‖ < δ → ‖φ b - φ x‖ < δ →
      ∃ v ∈ P.chartTangent hφ A x, ‖(φ a - φ b) - v‖ ≤ ε * ‖φ a - φ b‖
  graph : ∀ Q : φ.model.E 0 →L[ℝ] φ.model.E 0, (∀ v, Q v ∈ P.chartTangent hφ A x) →
    (∀ v ∈ P.chartTangent hφ A x, Q v = v) → ∀ h ∈ P.chartTangent hφ A x, h ∈ K →
      ∀ ε > 0, ∃ t₀ > 0, ∀ t, 0 < t → t < t₀ → ∃ a ∈ A ∩ φ.source,
        Q (φ a - φ x) = t • h ∧ ‖(φ a - φ x) - t • h‖ ≤ ε * t

variable (P) in
/-- **The graph representation at `x` in dimension `n`**: one chart `φ` at `x` and one set `K`
of admissible directions serve all `n`-dimensional submanifolds through `x`
(`IsGraphChartAt`). -/
def HasGraphChartsAt (x : X) (n : ℕ) : Prop :=
  ∃ (φ : MChart X) (hφ : P.IsChart φ), x ∈ φ.source ∧ ∃ K : Set (φ.model.E 0),
    ∀ A : Set X, P.IsSubmanifoldOfDim A n → x ∈ A → P.IsGraphChartAt hφ K A x

omit [T2Space X] [ParacompactSpace X] in
/-- A neighbourhood of `x` read in a chart. -/
theorem exists_pos_forall_mem_of_mem_nhds {φ : MChart X} {x : X} (hxφ : x ∈ φ.source)
    {W : Set X} (hW : W ∈ 𝓝 x) :
    ∃ ρ > 0, ∀ y ∈ φ.source, ‖φ y - φ x‖ < ρ → y ∈ W := by
  have hxO : φ x ∈ φ.model.O := φ.target_eq ▸ φ.toPartialEquiv.map_source hxφ
  have hc := φ.continuousOn_invFun (φ x) hxO
  have hW' : W ∈ 𝓝 (φ.toPartialEquiv.symm (φ x)) := by
    rw [φ.toPartialEquiv.left_inv hxφ]; exact hW
  obtain ⟨ρ, hρ, hball⟩ := Metric.mem_nhdsWithin_iff.1 (hc hW')
  refine ⟨ρ, hρ, fun y hy hyρ => ?_⟩
  have hyO : φ y ∈ φ.model.O := φ.target_eq ▸ φ.toPartialEquiv.map_source hy
  have := hball ⟨by rw [Metric.mem_ball, dist_eq_norm]; exact hyρ, hyO⟩
  rwa [mem_preimage, φ.toPartialEquiv.left_inv hy] at this

/-- **Tangent slices** (2021 Proposition 9.2.8, p. 413, in the slice form used by the fibre
count of `Tangent.lean`): under the graph representation (`HasGraphChartsAt`, Lemmas
9.2.9–9.2.11), `HasTangentSlicesAt` holds.  With `L = T_xA_{k₀}` in the
chart, a projection `Q` onto `L`, a vector `h₀ ∈ int_L(L ∩ K)` outside the finitely many
subspaces `T_xA_k ≠ L` (`exists_mem_ball_forall_not_mem`), and `t > 0` small, the slice is
`F = {y ∈ W | Q(φ(y) − φ(x)) = t h₀, ‖φ(y) − φ(x) − t h₀‖ < ε t}`: each `A_k` with
`T_xA_k = L` meets it (graph representation) exactly once (`eq_zero_of_proj_eq_zero`), and the
other `A_k` miss it (`h₀ ∉ T_xA_k`). -/
theorem hasTangentSlicesAt_of_hasGraphChartsAt {x : X} {n : ℕ} (hG : P.HasGraphChartsAt x n) :
    P.HasTangentSlicesAt x n := by
  classical
  intro κ _ A hA hx k₀ W hW hxW
  obtain ⟨φ, hφ, hxφ, K, hGA⟩ := hG
  have hg : ∀ k, P.IsGraphChartAt hφ K (A k) x := fun k => hGA _ (hA k) (hx k)
  choose N hN hfin using fun k => exists_submodule_chartTangent hφ (hA k).1 (hx k) hxφ
  have hrank : ∀ k, finrank ℝ (N k) = n := fun k =>
    finrank_chartTangent hφ ((hA k).2 x (hx k)) (hA k).1 hxφ (hN k)
  have hclass : ∀ k, P.submanifoldTangent (A k) x = P.submanifoldTangent (A k₀) x ↔
      N k = N k₀ := fun k => by
    rw [← chartTangent_eq_iff hφ hxφ, ← hN k, ← hN k₀, SetLike.coe_set_eq]
  have hnle : ∀ k, N k ≠ N k₀ → ¬ N k₀ ≤ N k := fun k hk hle => by
    have := hfin k
    exact hk (Submodule.eq_of_le_of_finrank_eq hle (by rw [hrank, hrank])).symm
  have hclosed : ∀ k, IsClosed (N k : Set (φ.model.E 0)) := fun k => by
    have := hfin k
    exact Submodule.closed_of_finiteDimensional _
  -- the vector `h₀`
  obtain ⟨h₁, hh₁, r, hr, hK⟩ := (hg k₀).exists_ball
  rw [← hN k₀] at hh₁
  obtain ⟨h₀, hh₀N, hh₀r, hh₀S⟩ := exists_mem_ball_forall_not_mem (N := N k₀)
    (ι := {k // N k ≠ N k₀}) (fun k => N k.1) (fun k => hclosed k.1) (fun k => hnle k.1 k.2)
    hh₁ hr
  have hh₀T : h₀ ∈ P.chartTangent hφ (A k₀) x := by rw [← hN k₀]; exact hh₀N
  have hh₀K : h₀ ∈ K := hK h₀ hh₀T hh₀r
  -- the projection `Q` onto `L`
  have := hfin k₀
  obtain ⟨Q', hQ'⟩ := Submodule.ClosedComplemented.of_finiteDimensional (N k₀)
  set Q : φ.model.E 0 →L[ℝ] φ.model.E 0 := (N k₀).subtypeL.comp Q' with hQdef
  have hT : ∀ k, N k = N k₀ → P.chartTangent hφ (A k) x = P.chartTangent hφ (A k₀) x :=
    fun k hk => by rw [← hN k, ← hN k₀, hk]
  have hQT : ∀ k, N k = N k₀ → ∀ v, Q v ∈ P.chartTangent hφ (A k) x := fun k hk v => by
    rw [← hN k, hk]; exact (Q' v).2
  have hQid : ∀ k, N k = N k₀ → ∀ v ∈ P.chartTangent hφ (A k) x, Q v = v := fun k hk v hv => by
    rw [← hN k, hk] at hv
    exact congrArg Subtype.val (hQ' ⟨v, hv⟩)
  set c := ‖ContinuousLinearMap.id ℝ (φ.model.E 0) - Q‖ with hcdef
  have hc : 0 ≤ c := norm_nonneg _
  -- the distances of `h₀` to the other tangent spaces
  have hrad : ∀ k, N k ≠ N k₀ → ∃ ρ > 0, ∀ v ∈ P.chartTangent hφ (A k) x, ρ ≤ ‖h₀ - v‖ :=
    fun k hk => by
      have hmem : h₀ ∈ (N k : Set (φ.model.E 0))ᶜ := hh₀S ⟨k, hk⟩
      obtain ⟨ρ, hρ, hball⟩ := Metric.isOpen_iff.1 (hclosed k).isOpen_compl h₀ hmem
      refine ⟨ρ, hρ, fun v hv => ?_⟩
      by_contra hlt
      push Not at hlt
      rw [← hN k] at hv
      exact hball (by rw [Metric.mem_ball, dist_eq_norm, norm_sub_rev]; exact hlt) hv
  choose! ρ hρ hρv using hrad
  -- the tube radius `ε`
  have hεev : ∀ᶠ ε in 𝓝[>] (0 : ℝ), ε ≤ 1 ∧ ∀ k, N k ≠ N k₀ → ε ≤ ρ k / 3 := by
    refine Filter.Eventually.and ?_ (Filter.eventually_all.2 fun k => ?_)
    · exact ((eventually_lt_nhds one_pos).mono fun _ h => h.le).filter_mono nhdsWithin_le_nhds
    · by_cases hk : N k ≠ N k₀
      · exact ((eventually_lt_nhds (by linarith [hρ k hk] : (0 : ℝ) < ρ k / 3)).mono
          fun _ h _ => h.le).filter_mono nhdsWithin_le_nhds
      · exact Filter.Eventually.of_forall fun _ h => (hk h).elim
  obtain ⟨ε, ⟨hε1, hερ⟩, hε0⟩ := (hεev.and self_mem_nhdsWithin).exists
  have hε0 : (0 : ℝ) < ε := hε0
  -- the constants of the approximation
  set η : ℝ := 1 / (2 * (c + 1)) with hηdef
  have hη : 0 < η := by positivity
  have hηc : η * c < 1 := by
    rw [hηdef, div_mul_eq_mul_div, one_mul, div_lt_one (by positivity)]
    linarith
  choose δ₁ hδ₁ happ₁ using fun k => (hg k).approx η hη
  have happ₂ : ∀ k, N k ≠ N k₀ → ∃ δ > 0, ∀ a ∈ A k ∩ φ.source, ∀ b ∈ A k ∩ φ.source,
      ‖φ a - φ x‖ < δ → ‖φ b - φ x‖ < δ → ∃ v ∈ P.chartTangent hφ (A k) x,
        ‖(φ a - φ b) - v‖ ≤ ρ k / (3 * (‖h₀‖ + 1)) * ‖φ a - φ b‖ := fun k hk =>
    (hg k).approx _ (by have := hρ k hk; positivity)
  choose! δ₂ hδ₂ happ₂ using happ₂
  have hgr : ∀ k, N k = N k₀ → ∃ t₀ > 0, ∀ t, 0 < t → t < t₀ → ∃ a ∈ A k ∩ φ.source,
      Q (φ a - φ x) = t • h₀ ∧ ‖(φ a - φ x) - t • h₀‖ ≤ ε / 2 * t := fun k hk =>
    (hg k).graph Q (hQT k hk) (hQid k hk) h₀ (by rw [hT k hk]; exact hh₀T) hh₀K (ε / 2)
      (by positivity)
  choose! t₀ ht₀ hgr using hgr
  obtain ⟨ρW, hρW, hW'⟩ := exists_pos_forall_mem_of_mem_nhds hxφ (hW.mem_nhds hxW)
  -- the parameter `t`
  have htev : ∀ᶠ t in 𝓝[>] (0 : ℝ), (∀ k, N k = N k₀ → t < t₀ k) ∧
      (∀ k, t * (‖h₀‖ + 1) < δ₁ k) ∧ (∀ k, N k ≠ N k₀ → t * (‖h₀‖ + 1) < δ₂ k) ∧
      t * (‖h₀‖ + 1) < ρW := by
    refine ((Filter.eventually_all.2 fun k => ?_).and ((Filter.eventually_all.2 fun k =>
      eventually_mul_lt (hδ₁ k)).and ((Filter.eventually_all.2 fun k => ?_).and
        (eventually_mul_lt hρW)))).mono fun t ht => ⟨ht.1, ht.2.1, ht.2.2.1, ht.2.2.2⟩
    · by_cases hk : N k = N k₀
      · exact ((eventually_lt_nhds (ht₀ k hk)).mono fun _ h _ => h).filter_mono
          nhdsWithin_le_nhds
      · exact Filter.Eventually.of_forall fun _ h => (hk h).elim
    · by_cases hk : N k ≠ N k₀
      · exact (eventually_mul_lt (hδ₂ k hk)).mono fun _ h _ => h
      · exact Filter.Eventually.of_forall fun _ h => (hk h).elim
  obtain ⟨t, ⟨ht₀', htδ₁, htδ₂, htW⟩, ht0⟩ := (htev.and self_mem_nhdsWithin).exists
  have ht0 : (0 : ℝ) < t := ht0
  -- the slice
  set F : Set X := {y | y ∈ W ∧ y ∈ φ.source ∧ Q (φ y - φ x) = t • h₀ ∧
    ‖(φ y - φ x) - t • h₀‖ < ε * t} with hFdef
  have hFnorm : ∀ y, ‖(φ y - φ x) - t • h₀‖ < ε * t → ‖φ y - φ x‖ < t * (‖h₀‖ + 1) := by
    intro y hy
    calc ‖φ y - φ x‖ = ‖((φ y - φ x) - t • h₀) + t • h₀‖ := by rw [sub_add_cancel]
      _ ≤ ‖(φ y - φ x) - t • h₀‖ + ‖t • h₀‖ := norm_add_le _ _
      _ < ε * t + t * ‖h₀‖ := by
          rw [norm_smul, Real.norm_of_nonneg ht0.le]; linarith
      _ ≤ t * (‖h₀‖ + 1) := by nlinarith
  refine ⟨F, fun y hy => hy.1, fun k => ⟨fun hk => ?_, fun hk => ?_⟩⟩
  · -- `T_xA_k = L`: exactly one point
    have hk' : N k = N k₀ := (hclass k).1 hk
    obtain ⟨a, haA, haQ, hanorm⟩ := hgr k hk' t ht0 (ht₀' k hk')
    have ha_lt : ‖(φ a - φ x) - t • h₀‖ < ε * t := by
      have : ε / 2 * t < ε * t := by nlinarith
      linarith
    have haF : a ∈ F := ⟨hW' a haA.2 ((hFnorm a ha_lt).trans htW), haA.2, haQ, ha_lt⟩
    refine ⟨a, ⟨haF, haA.1⟩, fun b hb => ?_⟩
    have hbF : b ∈ F := hb.1
    have hxA : x ∈ A k ∩ φ.source := ⟨hx k, hxφ⟩
    obtain ⟨v, hv, hvb⟩ := happ₁ k b ⟨hb.2, hbF.2.1⟩ a haA
      ((hFnorm b hbF.2.2.2).trans (htδ₁ k)) ((hFnorm a ha_lt).trans (htδ₁ k))
    have hQba : Q (φ b - φ a) = 0 := by
      have : φ b - φ a = (φ b - φ x) - (φ a - φ x) := by abel
      rw [this, map_sub, hbF.2.2.1, haQ, sub_self]
    have h0 := eq_zero_of_proj_eq_zero (hQid k hk') hQba hv hηc hvb
    exact φ.toPartialEquiv.injOn hbF.2.1 haA.2 (sub_eq_zero.1 h0)
  · -- `T_xA_k ≠ L`: no point
    have hk' : N k ≠ N k₀ := fun h => hk ((hclass k).2 h)
    refine eq_empty_of_forall_notMem fun a ha => ?_
    have haF : a ∈ F := ha.1
    have hnorm := hFnorm a haF.2.2.2
    have hxA : x ∈ A k ∩ φ.source := ⟨hx k, hxφ⟩
    obtain ⟨v, hv, hva⟩ := happ₂ k hk' a ⟨ha.2, haF.2.1⟩ x hxA (hnorm.trans (htδ₂ k hk'))
      (by rw [sub_self, norm_zero]; exact hδ₂ k hk')
    have hρk := hρ k hk'
    have h1 : ‖(φ a - φ x) - v‖ ≤ t * (ρ k / 3) := by
      calc ‖(φ a - φ x) - v‖ ≤ ρ k / (3 * (‖h₀‖ + 1)) * ‖φ a - φ x‖ := hva
        _ ≤ ρ k / (3 * (‖h₀‖ + 1)) * (t * (‖h₀‖ + 1)) :=
            mul_le_mul_of_nonneg_left hnorm.le (by positivity)
        _ = t * (ρ k / 3) := by field_simp
    have h2 : ‖t • h₀ - v‖ < t * (2 * ρ k / 3) := by
      calc ‖t • h₀ - v‖ = ‖((φ a - φ x) - v) - ((φ a - φ x) - t • h₀)‖ := by
            congr 1; abel
        _ ≤ ‖(φ a - φ x) - v‖ + ‖(φ a - φ x) - t • h₀‖ := norm_sub_le _ _
        _ < t * (ρ k / 3) + ε * t := by linarith [haF.2.2.2]
        _ ≤ t * (2 * ρ k / 3) := by nlinarith [hερ k hk']
    have hv' : t⁻¹ • v ∈ P.chartTangent hφ (A k) x := by
      rw [← hN k] at hv ⊢; exact (N k).smul_mem _ hv
    have h3 := hρv k hk' _ hv'
    have h4 : ‖h₀ - t⁻¹ • v‖ = t⁻¹ * ‖t • h₀ - v‖ := by
      have : h₀ - t⁻¹ • v = t⁻¹ • (t • h₀ - v) := by
        rw [smul_sub, smul_smul, inv_mul_cancel₀ ht0.ne', one_smul]
      rw [this, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 ht0.le)]
    rw [h4] at h3
    have h5 : t⁻¹ * ‖t • h₀ - v‖ < 2 * ρ k / 3 := by
      rw [inv_mul_lt_iff₀ ht0]; linarith
    linarith

end MPolyfold

end Polyfold
