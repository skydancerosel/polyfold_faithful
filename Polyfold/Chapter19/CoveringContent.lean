/-!
# The content of Theorems 19.7.29 and 19.8.6 (5) (HWZ 2021 §§19.7–19.8, pp. 929–939)

2021 Theorem 19.7.29 (p. 929) and Theorem 19.8.6 (5) (p. 938).  Numbers and pages are the 2021
text's.

## What is formalized

* **Theorem 19.7.29** (`CoveringBasicConstruction.theorem_19_7_29_content`), under
  `IsCompatible` (the reading of l. 44572, as for `theorem_19_7_29_hyp`): the topology on `|A|`
  generated by the collection of Definition 19.7.16 is metrizable, and `P` itself is a proper
  polyfold covering functor `(A, T_{|A|}) → (B, T_{|B|})` (Definition 17.8.13) whose polyfold
  structure of `B` is the one of `(F, 𝓕)` (Theorem 19.5.3 (2)).  The functor is
  `toProperPolyfoldCoveringFunctor`; `theorem_19_7_29_functor` records that its functor is `P`,
  its proper polyfold covering structure is `(F̂, M)` of Theorem 19.7.28 (3), its structure of `B`
  is the one of `(F, 𝓕)` and its M-polyfolds are the `M(Ψ̂, Ψ̂')` of Proposition 19.7.26.
  `hasClassUniformizers_of_toBasic`: class uniformizers for `F` and for `F̂` are the same
  condition.
* **Theorem 19.8.6 (5)** (`PullbackUniformizerConstruction.theorem_19_8_6_five_hyp`), for a
  transition construction of Definition 19.8.4 and under `IsCompatible`: the orbit spaces `|A|`,
  `|B|`, `|E_B|`, `|P*E_B|` with the topologies generated by the collections of Definition 19.7.16,
  Definition 19.2.1, Definition 19.6.7 (for the `Γ`) and `NatOpenPull` (the same collection for the
  `Γ̂ : τ*W → P*E_B`, as Definition 19.8.20) are metrizable.  For `|P*E_B|` this is Lemma 19.8.21
  for the bundle covering square of `(P, μ_B)` (`BundleCoveringSquare.ofPull`): every member of
  `F̃` gives a uniformizer for that square (`PullbackUniformizer.toSquare`), so `F̃` gives a
  square uniformizer construction `toSq` with `toSq.toPullback = F̃` (`toSq_toPullback`) whose
  collection of Definition 19.8.20 is `NatOpenPull` (`natOpenEA_toSq_iff`).
  `isOpen_natTopPull_iff`: the opens of the generated topology are exactly the members of
  `NatOpenPull`.
* Witnesses: `absBasic_theorem_19_7_29_content` and `absFt_theorem_19_8_6_five` (the
  absolute-value covering of `CoveringPolyfoldExamples`, `CoveringPullbackCoherence`, which is
  compatible and non-degenerate).

## Readings

* As in `CoveringPolyfold.lean`: `A` has no translation-groupoid uniformizers of its own, and its
  polyfold structure is read through Definition 17.8.13.  `IsCompatible` is a hypothesis
  (`definition_19_8_4_without_compatible`: it does not follow from Definitions 19.8.4, 19.8.5).
* "The orbit space of `P*E_B`" carries the topology generated by `NatOpenPull`.
-/

set_option maxSynthPendingDepth 3
set_option linter.unusedSectionVars false

open Set Function Topology TopologicalSpace

noncomputable section

namespace Polyfold

universe u

namespace GroupoidalCategory

/-! ### Theorem 19.7.29 -/

namespace CoveringBasicConstruction

variable {A B : GroupoidalCategory.{u}} {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr}
  (Bh : CoveringBasicConstruction P)

/-- Class uniformizers for the underlying `F` (Definition 19.7.11) give class uniformizers for
`F̂`; the converse is `HasClassUniformizers.toBasic`. -/
theorem hasClassUniformizers_of_toBasic (h : Bh.toBasic.U.HasClassUniformizers) :
    Bh.HasClassUniformizers := fun z => by
  obtain ⟨β, hβ, -, ⟨Ψh, hΨh, -⟩⟩ := h z
  exact ⟨β, hβ, Ψh, hΨh⟩

section Content

variable (hP : IsFiniteToOneCovering P) (hC : Bh.IsCompatible) (hU : Bh.HasClassUniformizers)
  (hm : @MetrizableSpace B.OrbitSpace (Bh.toBasic.natTop hU.toBasic))

/-- The topology generated by the collection of Definition 19.7.16 is `T_{|A|}`. -/
theorem generateFrom_natOpenA :
    generateFrom {W | Bh.NatOpenA W} = Bh.natTopA hP hC hU :=
  generateFrom_setOfPred_isOpen (Bh.natTopA hP hC hU)

/-- **2021 Theorem 19.7.29, p. 929, the proper polyfold covering functor**, under
`IsCompatible`: the functor of `toProperPolyfoldCoveringFunctor` is `P`, its proper polyfold
covering structure is `(F̂, M)` of Theorem 19.7.28 (3), its polyfold structure of `B` is the one
of `(F, 𝓕)` (Theorem 19.5.3 (2)), its M-polyfolds `M(Ψ̂, Ψ̂')` are those of Proposition 19.7.26,
and the GCT `A` carries the topology generated by the collection of Definition 19.7.16. -/
theorem theorem_19_7_29_functor :
    (Bh.toProperPolyfoldCoveringFunctor hP hC hU hm).P = P ∧
    (Bh.toProperPolyfoldCoveringFunctor hP hC hU hm).S =
      Bh.toProperPolyfoldCoveringStructure hP hC hU hm ∧
    (Bh.toProperPolyfoldCoveringFunctor hP hC hU hm).S.SB = Bh.toBasic.toPolyfoldConstruction hm ∧
    (∀ U U' : (Bh.toProperPolyfoldCoveringStructure hP hC hU hm).toC.Unif,
      (Bh.toProperPolyfoldCoveringFunctor hP hC hU hm).S.MH U U' =
        Bh.hatPolyfold hP (Bh.unifOf hP hC hU hm U) (Bh.unifOf hP hC hU hm U')) ∧
    (Bh.gctA hP hC hU hm).top = generateFrom {W | Bh.NatOpenA W} ∧
    Bh.gctB hU hm = Bh.toBasic.toGCTOfMetrizable hU.toBasic hm :=
  ⟨rfl, rfl, rfl, fun _ _ => rfl, (Bh.generateFrom_natOpenA hP hC hU).symm, rfl⟩

/-- **2021 Theorem 19.7.29, p. 929**, under `IsCompatible`: the topology on `|A|` generated by
the collection of Definition 19.7.16 is metrizable, and `P` itself is a proper polyfold covering
functor (Definition 17.8.13) from `A` with this topology to the GCT `(B, T_{|B|})`, whose
polyfold structure of `B` is the one of `(F, 𝓕)` (Theorem 19.5.3 (2)). -/
theorem theorem_19_7_29_content (hP : IsFiniteToOneCovering P) (hC : Bh.IsCompatible)
    (hU : Bh.HasClassUniformizers)
    (hm : @MetrizableSpace B.OrbitSpace (Bh.toBasic.natTop hU.toBasic)) :
    ∃ hA : @MetrizableSpace A.OrbitSpace (generateFrom {W | Bh.NatOpenA W}),
      ∃ Q : ProperPolyfoldCoveringFunctor (@GCT.mk A (generateFrom {W | Bh.NatOpenA W}) hA)
          (Bh.toBasic.toGCTOfMetrizable hU.toBasic hm),
        Q.P = P ∧ Q.S.SB = Bh.toBasic.toPolyfoldConstruction hm := by
  have key : ∀ (t : TopologicalSpace A.OrbitSpace) (ht : Bh.natTopA hP hC hU = t),
      ∃ hA : @MetrizableSpace A.OrbitSpace t,
        ∃ Q : ProperPolyfoldCoveringFunctor (@GCT.mk A t hA)
            (Bh.toBasic.toGCTOfMetrizable hU.toBasic hm),
          Q.P = P ∧ Q.S.SB = Bh.toBasic.toPolyfoldConstruction hm := by
    rintro t rfl
    exact ⟨(Bh.theorem_19_7_25_one_hyp hP hC hU hm).1,
      Bh.toProperPolyfoldCoveringFunctor hP hC hU hm, rfl, rfl⟩
  exact key _ (Bh.generateFrom_natOpenA hP hC hU).symm

end Content

end CoveringBasicConstruction

/-- **Theorem 19.7.29 for `absBasic`** (two sheets of `ℤ/2 ⋉ ℝ` over `ℤ/2 ⋉ ℝ`, compatible,
`absBasic_covering_polyfold_nondegenerate`). -/
theorem absBasic_theorem_19_7_29_content :
    ∃ hA : @MetrizableSpace _ (generateFrom {W | absBasic.NatOpenA W}),
      ∃ Q : ProperPolyfoldCoveringFunctor (@GCT.mk _ (generateFrom {W | absBasic.NatOpenA W}) hA)
          (absBasic.toBasic.toGCTOfMetrizable absBasic_hasClassUniformizers.toBasic
            absBasic_metrizableSpace),
        Q.P = absCovP ∧ Q.S.SB = absBasic.toBasic.toPolyfoldConstruction absBasic_metrizableSpace :=
  absBasic.theorem_19_7_29_content absCovP_isFiniteToOneCovering absBasic_isCompatible
    absBasic_hasClassUniformizers absBasic_metrizableSpace

/-! ### Theorem 19.8.6 (5) -/

namespace PullbackUniformizerConstruction

variable {A B : GroupoidalCategory.{u}} {P : GroupoidFunctor A.toGroupoidStr B.toGroupoidStr}
  {μ : B.BanFunctor} (Ft : PullbackUniformizerConstruction P μ)

/-- **The collection defining the natural topology of `|P*E_B|`** (Definition 19.8.20 for the
bundle covering square of `(P, μ_B)`): `U ⊂ |P*E_B|` belongs to it if for every `ẑ ∈ U` there
are an object `β` representing `|P|(|P_A|(ẑ))`, a member `(Ψ, Ψ̂, Γ) ∈ F̃(β)` with
`Γ̂ : τ*W → P*E_B` (19.55), a `ŵ ∈ τ*W` with `|Γ̂(ŵ)| = ẑ` and an open `V ∋ ŵ` with
`|Γ̂(V)| ⊂ U`. -/
def NatOpenPull (U : Set (μ.pull P).cat.OrbitSpace) : Prop :=
  ∀ z ∈ U, ∃ β : B.Obj, B.π β = P.orbitMap ((μ.pull P).orbitProj z) ∧ ∃ x ∈ Ft.F β,
    ∃ w : x.TauW, (μ.pull P).cat.π (x.gammaHat.obj w) = z ∧ ∃ V : Set x.TauW, IsOpen V ∧
      w ∈ V ∧ (fun q => (μ.pull P).cat.π (x.gammaHat.obj q)) '' V ⊆ U

/-- **`F̃` as a uniformizer construction for the bundle covering square of `(P, μ_B)`**
(Definition 19.8.13 for `BundleCoveringSquare.ofPull`): the uniformizers `toSquare` of the
members of `F̃`. -/
def toSq (hP : IsFiniteToOneCovering P) :
    SquareUniformizerConstruction (BundleCoveringSquare.ofPull P hP μ) :=
  ⟨fun β => (fun x : PullbackUniformizer P μ β => x.toSquare hP) '' Ft.F β⟩

theorem toSq_toPullback (hP : IsFiniteToOneCovering P) : (Ft.toSq hP).toPullback = Ft := by
  change (⟨fun β => (fun x : SquareUniformizer (BundleCoveringSquare.ofPull P hP μ) β =>
    x.toPullbackUniformizer) '' ((fun x : PullbackUniformizer P μ β => x.toSquare hP) '' Ft.F β)⟩ :
      PullbackUniformizerConstruction P μ) = Ft
  obtain ⟨F⟩ := Ft
  congr 1
  funext β
  ext x
  constructor
  · rintro ⟨_, ⟨y, hy, rfl⟩, rfl⟩
    exact hy
  · intro hx
    exact ⟨_, ⟨x, hx, rfl⟩, rfl⟩

/-- The collection of Definition 19.8.20 for `toSq` is `NatOpenPull`. -/
theorem natOpenEA_toSq_iff (hP : IsFiniteToOneCovering P) (U : Set (μ.pull P).cat.OrbitSpace) :
    (Ft.toSq hP).NatOpenEA U ↔ Ft.NatOpenPull U := by
  constructor
  · intro h z hz
    obtain ⟨β, hβ, _, ⟨x, hx, rfl⟩, w, hw, V, hV, hwV, hsub⟩ := h z hz
    exact ⟨β, hβ, x, hx, w, hw, V, hV, hwV, hsub⟩
  · intro h z hz
    obtain ⟨β, hβ, x, hx, w, hw, V, hV, hwV, hsub⟩ := h z hz
    exact ⟨β, hβ, x.toSquare hP, ⟨x, hx, rfl⟩, w, hw, V, hV, hwV, hsub⟩

section Five

variable [hPf : Fact (IsFiniteToOneCovering P)]

/-- Lemma 19.8.21 for `toSq`, read through any identification of `toSq.toPullback` with a
uniformizer construction carrying a transition construction of Definition 19.8.4. -/
theorem natTopPull_aux (G : PullbackUniformizerConstruction P μ)
    (hG : (Ft.toSq hPf.out).toPullback = G) (T : G.PullbackTransitionConstruction)
    (hC : T.toCoveringBasicConstruction.IsCompatible) :
    (∀ U, IsOpen[generateFrom {U | (Ft.toSq hPf.out).NatOpenEA U}] U ↔
      (Ft.toSq hPf.out).NatOpenEA U) ∧
    @MetrizableSpace _ (generateFrom {U | (Ft.toSq hPf.out).NatOpenEA U}) := by
  subst hG
  have ht : generateFrom {U | (Ft.toSq hPf.out).NatOpenEA U} =
      (Ft.toSq hPf.out).natTopEA T.𝓕 T.isCoherent hC T.hasClassUniformizers :=
    generateFrom_setOfPred_isOpen
      ((Ft.toSq hPf.out).natTopEA T.𝓕 T.isCoherent hC T.hasClassUniformizers)
  rw [ht]
  exact ⟨fun _ => Iff.rfl,
    (Ft.toSq hPf.out).metrizableSpace_natTopEA T.𝓕 T.isCoherent hC T.hasClassUniformizers
      T.metrizable⟩

theorem generateFrom_natOpenPull :
    generateFrom {U | Ft.NatOpenPull U} = generateFrom {U | (Ft.toSq hPf.out).NatOpenEA U} := by
  congr 1
  ext U
  exact (Ft.natOpenEA_toSq_iff hPf.out U).symm

/-- **The natural topology of `|P*E_B|` is the collection `NatOpenPull`** (Lemma 19.8.21 (1)
for the square of `(P, μ_B)`): for a transition construction of Definition 19.8.4, under
`IsCompatible`, the opens of the topology generated by `NatOpenPull` are exactly its members. -/
theorem isOpen_natTopPull_iff (T : Ft.PullbackTransitionConstruction)
    (hC : T.toCoveringBasicConstruction.IsCompatible) (U : Set (μ.pull P).cat.OrbitSpace) :
    IsOpen[generateFrom {U | Ft.NatOpenPull U}] U ↔ Ft.NatOpenPull U := by
  rw [Ft.generateFrom_natOpenPull, ← Ft.natOpenEA_toSq_iff hPf.out U]
  exact (Ft.natTopPull_aux Ft (Ft.toSq_toPullback hPf.out) T hC).1 U

/-- **`|P*E_B|` is metrizable** (Theorem 19.8.6 (5) for `|P*E_B|`; Lemma 19.8.21 for the square
of `(P, μ_B)`), for a transition construction of Definition 19.8.4, under `IsCompatible`. -/
theorem metrizableSpace_natTopPull (T : Ft.PullbackTransitionConstruction)
    (hC : T.toCoveringBasicConstruction.IsCompatible) :
    @MetrizableSpace _ (generateFrom {U | Ft.NatOpenPull U}) := by
  rw [Ft.generateFrom_natOpenPull]
  exact (Ft.natTopPull_aux Ft (Ft.toSq_toPullback hPf.out) T hC).2

/-- **2021 Theorem 19.8.6 (5), p. 938**, for a transition construction of Definition 19.8.4,
under `IsCompatible`: the orbit spaces of `A`, `B`, `E_B` and `P*E_B` are metrizable, with the
topologies generated by the collections of Definition 19.7.16, Definition 19.2.1 (`T_{|B|}`),
Definition 19.6.7 (for the strong bundle uniformizers `Γ`) and `NatOpenPull`. -/
theorem theorem_19_8_6_five_hyp (T : Ft.PullbackTransitionConstruction)
    (hC : T.toCoveringBasicConstruction.IsCompatible) :
    @MetrizableSpace A.OrbitSpace
        (generateFrom {W | T.toCoveringBasicConstruction.NatOpenA W}) ∧
      (∀ hB : T.toCoveringBasicConstruction.toBasic.U.HasClassUniformizers,
        @MetrizableSpace B.OrbitSpace (T.toCoveringBasicConstruction.toBasic.natTop hB)) ∧
      @MetrizableSpace μ.cat.OrbitSpace (generateFrom {U | Ft.NatOpenEB U}) ∧
      @MetrizableSpace (μ.pull P).cat.OrbitSpace (generateFrom {U | Ft.NatOpenPull U}) := by
  refine ⟨?_, fun _ => T.metrizable, ?_, Ft.metrizableSpace_natTopPull T hC⟩
  · rw [T.toCoveringBasicConstruction.generateFrom_natOpenA hPf.out hC T.hasClassUniformizers]
    exact (T.toCoveringBasicConstruction.theorem_19_7_25_one_hyp hPf.out hC
      T.hasClassUniformizers T.metrizable).1
  · have ht : generateFrom {U | Ft.NatOpenEB U} =
        Ft.natTopEB T.𝓕 T.isCoherent T.hasClassUniformizers :=
      generateFrom_setOfPred_isOpen (Ft.natTopEB T.𝓕 T.isCoherent T.hasClassUniformizers)
    rw [ht]
    exact Ft.metrizableSpace_natTopEB T.𝓕 T.isCoherent T.hasClassUniformizers T.metrizable

end Five

end PullbackUniformizerConstruction

/-- **Theorem 19.8.6 (5) for `absFt`** (the absolute-value covering with a Banach fibre, coherent
and compatible). -/
theorem absFt_theorem_19_8_6_five :
    @MetrizableSpace _ (generateFrom {W | absFtTransition.toCoveringBasicConstruction.NatOpenA W}) ∧
      (∀ hB : absFtTransition.toCoveringBasicConstruction.toBasic.U.HasClassUniformizers,
        @MetrizableSpace _ (absFtTransition.toCoveringBasicConstruction.toBasic.natTop hB)) ∧
      @MetrizableSpace _ (generateFrom {U | absFt.NatOpenEB U}) ∧
      @MetrizableSpace _ (generateFrom {U | absFt.NatOpenPull U}) :=
  absFt.theorem_19_8_6_five_hyp absFtTransition absFt_isCompatible

end GroupoidalCategory

end Polyfold

